DATA_FOLDER_PATH=data
WIKI_FOLDER_PATH=data
DB_PATH="data/database.sqlite"
DISCORD_USERNAME=
# Minimum milliseconds between wiki API requests (default: 1000)
WIKI_REQUEST_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# GAME selects the pipeline. Defaults to osrs.
# ---------------------------------------------------------------------------
GAME=osrs

# ---------------------------------------------------------------------------
# SKIP_REDIRECT_REFRESH — when "true", both dev services skip the alias/
# redirect sweep (~30 min for OSRS, ~30–45 min for RS3). Aliases change
# rarely so the daily cron sets this; the weekly run leaves it unset.
# Leave unset (or "false") for normal / weekly runs.
# ---------------------------------------------------------------------------
# SKIP_REDIRECT_REFRESH=false

# ---------------------------------------------------------------------------
# MIN_REFRESH_HOURS — minimum gap between wiki dumps. When the previous dump
# started within this window, the dev service skips the dump phase entirely
# and only re-extracts from whatever is already in the DB. Useful when the
# same container is restarted frequently (e.g. dev iteration) or to make
# ad-hoc cron reruns cheap. 0 (default) always dumps.
#
# The "last dump" timestamp lives in the `kv` table:
#   key = 'last_wiki_dump_at', value = ISO timestamp.
# To force a re-dump before the window elapses, clear that row:
#   DELETE FROM kv WHERE key = 'last_wiki_dump_at';
# ---------------------------------------------------------------------------
# MIN_REFRESH_HOURS=0

# ---------------------------------------------------------------------------
# Remote DB (Turso / hosted libSQL). When LIBSQL_URL is set, the local
# DB_PATH is ignored. Used by the GitHub Actions cron so state persists
# between runs. For local development, leave these unset and use DB_PATH.
# ---------------------------------------------------------------------------
# LIBSQL_URL=libsql://osrs-wiki-<your-handle>.turso.io
# LIBSQL_AUTH_TOKEN=
# LIBSQL_URL_RS3=libsql://rs3-wiki-<your-handle>.turso.io
# LIBSQL_AUTH_TOKEN_RS3=

# ---------------------------------------------------------------------------
# RS3 pipeline. Only required when GAME=rs3. Defaults shown.
# Two SQLite files are used so OSRS and RS3 never collide on disk.
# ---------------------------------------------------------------------------
# DATA_FOLDER_PATH_RS3=data/rs3
# WIKI_FOLDER_PATH_RS3=wiki-data-rs3
# DB_PATH_RS3="data/database-rs3.sqlite"

