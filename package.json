{
  "name": "wiki-scraper",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "db:push": "drizzle-kit push",
    "db:push:output": "drizzle-kit push --config=drizzle-output.config.ts",
    "build:db": "tsx scripts/build-database.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "oxlint --fix src test scripts",
    "lint:check": "oxlint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "form-data": "^4.0.4",
    "graceful-fs": "^4.2.11",
    "infobox-parser": "^3.6.4",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "wtf_wikipedia": "^10.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/graceful-fs": "^4.1.5",
    "@types/infobox-parser": "^3.3.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.0",
    "tsconfig-paths": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "@strongtz/win32-arm64-msvc": "https://registry.npmjs.org/@strongtz/win32-arm64-msvc/-/win32-arm64-msvc-0.4.7.tgz"
  }
