    { 1, 'table-bg-blue' },
    { 1/25, 'table-bg-green' },
    { 1/99.99, 'table-bg-yellow' },
    { 1/999.99, 'table-bg-orange' },
    { 1/9999999, 'table-bg-red' }
}

function get_rarity_class(val)
    for i,v in ipairs(rarities_class) do
        curr = v
        if val >= v[1] then
            break
        end
    end
    return curr[2]
end

function makeTable()
	local header1 = mw.html.create('tr')
		:tag('th')
			:wikitext('Item')
			:attr('colspan', 2):attr('rowspan', 2)
		:done()
		:tag('th')
			:wikitext('Quantity')
			:attr('rowspan', 2)
		:done()
		:tag('th')
			:wikitext('Rarity')
			:attr('rowspan', 2)
		:done()
				:tag('th')
			:wikitext('Price')
			:attr('rowspan', 2)
		:done()
		:tag('th')
			:wikitext('Expected')
			:attr('colspan', 2)
		:done()

	local header2 = mw.html.create('tr')
		:tag('th')
			:wikitext('Quantity')
		:done()
		:tag('th')
			:wikitext('Value')
		:done()

	return mw.html.create('table')
		:addClass('wikitable sortable align-center-1 align-left-2 align-center-3 align-center-4 align-center-6')
		:css('text-align','right')
		:node(header1)
		:node(header2)
end

function makeTableBottom(inTable, sum)
	inTable:tag('tr')
		:addClass('sortbottom')
		:tag('th')
			:attr('colspan', 6)
			:css('text-align','right')
			:wikitext('Total:')
		:done()
		:tag('td')
			:css('text-align','right')
			:wikitext(coins(string.format('%d', sum * kill_count)))
		:done()
end

function makeEvLine(points, sum)
	kill_word = "a kill"
	if kill_count > 1 then
		kill_word = commas(kill_count) .. ' kills'
	end

	return "The total expected value of " .. kill_word .. " with '''"
	.. string.format('%d%%', 100 * points) .. "''' contribution is "
	.. coins(sum * kill_count) .. " coins."
end

function makeLine(name, avgQty, chance, price)
	local expectedCount = chance * avgQty * kill_count
	local rarityClass = get_rarity_class(chance)

	return mw.html.create('tr')
		:tag('td')
			:wikitext('[[File:' .. name .. '.png|link=' .. name .. ']]')
		:done()
		:tag('td')
			:wikitext('[[' .. name .. ']]')
		:done()
		:tag('td')
			:wikitext(avgQty)
		:done()
		:tag('td')
			:addClass(rarityClass)
			:wikitext("1/" .. string.format('%.4g', 1.0/chance))
			:attr('data-sort-value', chance)
		:done()
		:tag('td')
			:wikitext(commas(string.format('%d', price * avgQty)))
		:done()
		:tag('td')
			:wikitext(string.format('%.4f', expectedCount))
		:done()
		:tag('td')
			:wikitext(commas(string.format('%d', price * expectedCount)))
		:done()
end

function p._main(damage)
	points = math.floor(100 * damage / 2500) / 100

	if points < 0.15 then
		local junkTable = makeTable()

		local junk_expectation = 0
		for i, v in ipairs(junk_drops) do
			name, qty, rate, val = unpack(v)

			junkTable:node(makeLine(name, qty, rate, val))

			effective_val = qty * rate * val
			junk_expectation = junk_expectation + effective_val
		end

		makeTableBottom(junkTable, junk_expectation)
		evLine = makeEvLine(points, junk_expectation)
		return evLine .. '\n\n===Junk===\n' .. tostring(junkTable)
	end

	local uniquesTable = makeTable()
	local uniques_expectation = 0
	local running_probability = 1.0
	local total_rate = 0  -- this should add up to exactly 1 by the end

	-- yami
	name, qty, rate, val = unpack(yami_drop)
	uniquesTable:node(makeLine(name, qty, rate, val))

	-- rares
	sum_rate = 0
	for i, v in ipairs(rare_drops) do
		name, qty, rate, val = unpack(v)
		sum_rate = sum_rate + rate
		
		effective_rate = rate * running_probability * points
		uniquesTable:node(makeLine(name, qty, effective_rate, val))

		effective_val = qty * effective_rate * val
		uniques_expectation = uniques_expectation + effective_val
		
		total_rate = total_rate + effective_rate
	end
	running_probability = running_probability * (1 - sum_rate * points)

	-- dossier
	name, qty, rate, val = unpack(dossier_drop)

	effective_rate = rate * running_probability * points -- scales w/ points
	uniquesTable:node(makeLine(name, qty, effective_rate, val))

	effective_val = qty * effective_rate * val
	uniques_expectation = uniques_expectation + effective_val

	running_probability = running_probability * (1 - rate * points)
	total_rate = total_rate + effective_rate

	-- forgotten lockbox
	name, qty, rate, val = unpack(lockbox_drop)
	
	effective_rate = rate * running_probability -- doesn't scale w/ points
	uniquesTable:node(makeLine(name, qty, effective_rate, val))

	effective_val = qty * effective_rate * val
	uniques_expectation = uniques_expectation + effective_val

	running_probability = running_probability * (1 - rate)
	total_rate = total_rate + effective_rate

	-- Oathplate shards
	name, qty, rate, val = unpack(oshards_drop)

	effective_rate = rate * running_probability -- doesn't scale w/ points
	effective_qty = math.max(math.floor(qty * points + 0.5), 1) -- scales w/ points
	uniquesTable:node(makeLine(name, effective_qty, effective_rate, val))

	effective_val = effective_qty * effective_rate * val
	uniques_expectation = uniques_expectation + effective_val

	running_probability = running_probability * (1 - rate)
	total_rate = total_rate + effective_rate

	--
	makeTableBottom(uniquesTable, uniques_expectation)

	local mainTable = makeTable()
	local main_expectation = 0

	-- supply qtys don't scale w/ contribution
	-- assume potions are decanted
	for i, v in ipairs(supply_drops) do
		name, qty, rate, val = unpack(v)

		effective_rate = rate * running_probability
		mainTable:node(makeLine(name, qty, effective_rate, val))

		effective_val = qty * effective_rate * val
		main_expectation = main_expectation + effective_val
	end
	total_rate = total_rate + 15/78 * running_probability

	-- main qtys do scale w/ contribution
	for i, v in ipairs(main_drops) do
		name, qty, rate, val = unpack(v)

		effective_rate = rate * running_probability
		effective_qty = math.max(math.floor(qty * points + 0.5), 1)
		mainTable:node(makeLine(name, effective_qty, effective_rate, val))
		
		effective_val = effective_qty * effective_rate * val
		main_expectation = main_expectation + effective_val
		
		total_rate = total_rate + effective_rate
	end

	mw.log("This number should be very close to 1 -> " .. total_rate)
	
	-- elite clue tertiary
	name, qty, rate, val = unpack(clue_drop)
	mainTable:node(makeLine(name, qty, rate, val))

	makeTableBottom(mainTable, main_expectation)
	evLine = makeEvLine(points, uniques_expectation + main_expectation)
	return evLine .. '\n\n===Uniques===\n' .. tostring(uniquesTable) .. '\n\n===Main drops===\n' .. tostring(mainTable)
end

return p