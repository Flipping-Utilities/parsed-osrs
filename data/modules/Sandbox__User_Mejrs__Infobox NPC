	if ret:paramDefined('aka') then
		ret:addRow{
			{ tag = 'th', content = 'Also called', colspan = '7' },
			{ tag = 'argd', content = 'aka', colspan = '13' }
		}
	end

	if ret:paramDefined('level') then
		ret:addRow{
			{ tag = 'th', content = '[[Combat level]]', colspan = '7' },
			{ tag = 'argd', content = 'level', colspan = '13' }
		}
	end

	ret:addRow{
		{ tag = 'th', content = '[[Members]]', colspan = '7' },
		{ tag = 'argd', content = 'members', colspan = '13' }
	}

	:addRow{
		{ tag = 'th', content = '[[Races|Race]]', colspan = '7' },
		{ tag = 'argd', content = 'race', colspan = '13' }
	}

	:addRow{
		{ tag = 'th', content = '[[Quest]] NPC', colspan = '7' },
		{ tag = 'argd', content = 'quest', colspan = '13' }
	}

	:addRow{
		{ tag = 'th', content = '[[Locations|Location]]', colspan = '7' },
		{ tag = 'argd', content = 'location', colspan = '13' }
	}

	if ret:paramDefined('shop') then
		ret:addRow{
			{ tag = 'th', content = '[[Shop|Sells items]]', colspan = '7' },
			{ tag = 'argd', content = 'shop', colspan = '13' }
		}
	end
	
	ret:addRow{
		{ tag = 'th', content = '[[Gender]]', colspan = '7' },
		{ tag = 'argd', content = 'gender', colspan = '13' }
	}

	if ret:paramDefined('features') then
		ret:addRow{
			{ tag = 'th', content = 'Features', colspan = '7' },
			{tag = 'argd', content = 'features', colspan = '13' }
		}
	end

	ret:addRow{
		{ tag = 'th', content = 'Examine', colspan = '7' },
		{ tag = 'argd', content = 'examine', colspan = '13' }
	}

	if ret:paramDefined('twisteddisp', 'all') then
		ret:addRow{
			{ tag = 'th', content = '[[Twisted League]]', colspan = '7' },
			{ tag = 'argd', content = 'twisteddisp', colspan = '13' }
		}
