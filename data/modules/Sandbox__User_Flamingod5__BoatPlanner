-- ========================================
-- Utilities
-- ========================================
-- Get part by type and index
function BoatBuilder.getCorePart(boatType, partType, index)
    local parts = BoatBuilder.coreParts[boatType]
    if not parts then return nil end
    return parts[partType] and parts[partType][index]
end

-- Get facilities by slot rules
function BoatBuilder.getFacilities(boatType, slotIndex)
    local slots = BoatBuilder.facilitySlots[boatType]
    if not slots then return {} end
    return slots[slotIndex]
end

