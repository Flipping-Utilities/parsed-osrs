	--placeholder values for threetick--
function calcAttemptsPerHour(miningSpeed)
	if(miningSpeed == 2) then
		local attemptsPerHour = 2000
		return attemptsPerHour
	else
		local attemptsPerHour = math.floor(3600 / ((miningSpeed * 0.6)+1.2))
		return attemptsPerHour
	end
end

	--needs real math, not exactly sure how this would be done. dropping more rocks should lead to larger values for fullinvtime, 
	--since you stay at rock longer. should account for time spent mining all types of rock still, though maybe that is accounted for in fillTen?
	--since the chaneTenKilo essentially acts as if that is all that is recieved from the rock, while every other outcome is not filling the inventory
function timeTillInvFull(attemptsPerHour, miningEnhancers, dropOne, dropTwo, dropFive, chanceTenKilo, chanceFiveKilo, chanceTwoKilo, chanceOneKilo, invSpace)
	local fullInvTime = 0
	local totalTenKilo = calcTenKilo(attemptsPerHour, chanceTenKilo, miningEnhancers)
	local totalFiveKilo = calcFiveKilo(attemptsPerHour, chanceFiveKilo, miningEnhancers)
	local totalTwoKilo = calcTwoKilo(attemptsPerHour, chanceTwoKilo, miningEnhancers)
	local totalOneKilo = calcOneKilo(attemptsPerHour, chanceOneKilo, miningEnhancers)
	local fillTen = chanceTenKilo * (1 + miningEnhancers)
	local fillFive = chanceFiveKilo * (1 + miningEnhancers)
	local fillTwo = chanceTwoKilo * (1 + miningEnhancers)
	local fillOne = chanceOneKilo * (1 + miningEnhancers)
	local avgTenKilo = invSpace / (1 + fillTen)
	local avgFiveKilo = invSpace / (1 + fillFive)
	local avgTwoKilo = invSpace / (1 + fillTwo)
	local avgOneKilo = invSpace / (1 + fillOne)
	if(dropOne) and (dropTwo) and (dropFive)  then
			fullInvTime = (avgTenKilo) / attemptsPerHour
		elseif(dropOne) and (dropTwo) then
			fullInvTime = (avgTenKilo + avgFiveKilo) / attemptsPerHour
		elseif(dropOne) and (dropFive) then
			fullInvTime = (avgTenKilo + avgTwoKilo) / attemptsPerHour
		elseif(dropFive) and (dropTwo) then
			fullInvTime = (avgTenKilo + avgOneKilo) / attemptsPerHour
		elseif(dropOne) then
			fullInvTime = (avgTenKilo + avgFiveKilo + avgTwoKilo) / attemptsPerHour
		elseif(dropTwo) then
			fullInvTime = (avgTenKilo + avgFiveKilo + avgOneKilo) / attemptsPerHour
		elseif(dropFive) then
			fullInvTime = (avgTenKilo + avgTwoKilo + avgOneKilo) / attemptsPerHour
		else
			fullInvTime = (avgTenKilo + avgFiveKilo + avgTwoKilo + avgOneKilo) / attemptsPerHour
	end
	return fullInvTime
end

function calcTenKilo(attemptsPerHour, chanceTenKilo, miningEnhancers)
	local totalTenKilo = math.floor((attemptsPerHour) * (chanceTenKilo * (1 + miningEnhancers)))
	return totalTenKilo
end
function calcFiveKilo(attemptsPerHour, chanceFiveKilo, miningEnhancers)
	local totalFiveKilo = math.floor((attemptsPerHour) * (chanceFiveKilo * (1 + miningEnhancers)))
	return totalFiveKilo
end
function calcTwoKilo(attemptsPerHour, chanceTwoKilo, miningEnhancers)
	local totalTwoKilo = math.floor((attemptsPerHour) * (chanceTwoKilo * (1 + miningEnhancers)))
	return totalTwoKilo
end
function calcOneKilo(attemptsPerHour, chanceOneKilo, miningEnhancers)
	local totalOneKilo = math.floor((attemptsPerHour) * (chanceOneKilo * (1 + miningEnhancers)))
	return totalOneKilo
end
	
function chanceToMine(miningLevel, low, high, offset)
	local value = math.floor((low*(99-miningLevel)/98 + high*(miningLevel-1)/98 + 0.5) + 1)
	return math.min(math.max(value / 256, 0), 1) * (1-offset)
end

