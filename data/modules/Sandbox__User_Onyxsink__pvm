function p.supplies()
	local data = pvmdata['supplies']
	local section = mw.html.create('div')
	section:tag('h3'):addClass('mw-header')
		:tag('span'):addClass('mw-headline')
			:wikitext("Supplies")
		:done()
	:done()
	local suppliestable = mw.html.create('table'):addClass('wikitable')
	:tag('tr')
		:tag('th'):attr('colspan', 2)
			:wikitext('Supplies table')
		:done()
	:done()
	for i=1,#data do
		local header = data['headers'][i]
		local costheader = data['costheaders'][i]
		local styledata = data[i]
		suppliestable:tag('tr')
			:tag('th')
				:wikitext(upperfirst(header))
			:done()
			:tag('th')
				:wikitext(upperfirst(costheader))
			:done()
		:done()
		for j=1,#styledata do
			local name = upperfirst(styledata[j]['item'])
			local price = styledata[j]['cost']
			suppliestable:tag('tr')
				:tag('td')
					:wikitext(string.format("[[File:%s.png|30x30px|link=%s]] [[%s]]", name, name, name))
				:done()
				:tag('td')
					:wikitext(displayvalue(price))
				:done()
			:done()
		end
	end
	suppliestable:done()
	section:node(suppliestable)
	
	return section
end

return p
