local style = { "melee", "ranged", "magic", "all" }

function upperfirst(text)
	if type(text) ~= 'string' then return text end
	return text:sub(1, 1):upper()..text:sub(2)
end

function displayvalue(item)
	if not item then
		return 'N/A'
	end

	item = tostring(item)
	local amount = gep(item)
	return coins(amount)
end

