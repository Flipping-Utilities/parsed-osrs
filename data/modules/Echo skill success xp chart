function interp(low, high, level)
	local value = math.floor(low*(99-level)/98 + high*(level-1)/98 + 0.5) + 1
	return math.min(math.max(value / 256, 0), 1)	
end

function cascadeInterp(bounds, level, index)
	local rate = 1.0
	for i, v in ipairs(bounds) do
		local low = (level >= v.req) and v.altlow or v.low
		local high = (level >= v.req) and v.althigh or v.high
		if i == index then
			rate = rate * interp(low, high, level)
			return rate
		end
		if level >= v.req then
			rate = rate * (1 - interp(low, high, level))
		end
	end
end

function echoInterp(bounds, level, index)
    if level < bounds[index].req then
        return 0
    end
    local standard = cascadeInterp(bounds, level, index)
    local echoBounds = {unpack(bounds)}
    table.insert(echoBounds, {
        label = "echo",
        low = 127,
        high = 127,
        altreq = math.huge,
        req = 1
    })
    local echo = cascadeInterp(echoBounds, level, #echoBounds)
    local count = 0
    for _, bound in ipairs(bounds) do
        if level >= bound.req then    
            count = count + 1
        end
    end
    count = math.max(count, 1)
    return standard + (echo / count)
end

local function calcXpPerHour(rate, xp, ticks)
    return rate * xp * (6000 / ticks)
end

function p._calculateDataSets(args)
    local skillData = data[args.skill]
    local resource = args.FishingResource or args.WoodcuttingResource or args.MiningResource
    local categoryData = skillData[resource]

    local dataSets = {}
    local inputs = categoryData.entries

    for i, input in ipairs(inputs) do
        local data = {}

        table.insert(dataSets, {
            data = data,
            label = input.name,
            borderDash = {5, 5},
            borderCapStyle = 'round',
            pointRadius = 0,
            baseColor = input.color,
            pointStyleImg = input.name .. ".png"
        })
        data = {}
        for x = input.req, args.highLevel do
            local y
            if echo then
                local rate = echoInterp(inputs, x, i)
                y = round(calcXpPerHour(rate, input.xp, input.ticks),1)
            end
            table.insert(data, {x=x, y=y, label= tostring(input.name) .. ": Level: " .. tostring(x) .. ", XP/h: " .. tostring(addcommas(y))})
        end
        table.insert(dataSets, {
            data = data,
            label = input.name .. "  ",
            borderDash = {},
            borderCapStyle = 'round',
            baseColor = input.color,
            pointRadius = 0,
            pointStyleImg = input.name .. ".png"
        })
        table.insert(dataSets, {})
    end
    
    if #inputs > 1 then
	    local totalXP = {}
	    for i = 2, #dataSets, 3 do
	        for _, point in ipairs(dataSets[i].data) do
	            totalXP[point.x] = (totalXP[point.x] or 0) + (point.y or 0)
	        end
	    end
	
	    local minReq = math.huge
	    for _, input in ipairs(inputs) do
	        minReq = math.min(minReq, input.req)
	    end
	
	    local fullDataSet = {}
	    for x = minReq, args.highLevel do
	        table.insert(fullDataSet, {x=x, y=totalXP[x] or 0, label= "Total XP: Level: " .. tostring(x) .. ", XP/h: " .. tostring(addcommas(totalXP[x])) })
	    end
	
	    table.insert(dataSets, {
	        data = {},
	        label = "Total",
	        borderDash = {5, 5},
	        borderCapStyle = 'round',
	        pointRadius = 0,
	        baseColor = "#e6d47e",
	        pointStyleImg = "XP drops icon.png"
	    })
	    table.insert(dataSets, {
	        data = fullDataSet,
	        label = "Total",
	        borderDash = {},
	        borderCapStyle = 'round',
	        pointRadius = 0,
	        baseColor = "#e6d47e"
	    })
	    table.insert(dataSets, {})
    end

    return dataSets
end

function p._main(args)
	local resource = args.FishingResource or args.WoodcuttingResource or args.MiningResource
    local plot = chart.newChart{ type = 'scatter' }
        :setTitle("50% second chance success roll (" .. data[args.skill][resource].label .. ")")
        :setDimensions('540px', '400px', '540px', '400px', true)
        :setXLabel('Level')
        :setYLabel('XP per hour')
        :setXLimits(nil, nil, 1)
		:setTooltipFormat("custom")
        :setDatasetsPerGroup(3)

    local dataSets = p._calculateDataSets(args)
    for i, dataSet in ipairs(dataSets) do
        plot:newDataSet(dataSet)
    end

    return plot
end

function p.main(frame)
    local args = frame.args
    args.skill = args.skill or "Fishing"
    args.resource = args.resource or "Barbarian"
    echo = true
    args.highLevel = args.highLevel or 99
    args.lowLevel = args.lowLevel or 1
    
    return p._main(args)
end

return p