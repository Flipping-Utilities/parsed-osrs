function p.prob_at_least_unique_pieces_graph()
    local plot = chart.newChart{ type = 'scatter', options = {colorPallet = myPallet2} }
    plot:setDimensions( '80vw', '40vh', 300, 300, true )
    plot:setTitle( 'Probability of receiving at least n unique pieces' )
