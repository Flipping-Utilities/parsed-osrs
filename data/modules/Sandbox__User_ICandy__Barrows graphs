local function prob_specific_set(n)
	return (162441001787/164313201888)^n
		- 4 * (2129506597/2147884992)^n
		- 4 * (2441/2448)^n
		+ 6 * (951701/957168)^n
		+ 1
end

local function prob_every_unique_piece(n)
	return prob_exact_unique_pieces[25](n)
end

