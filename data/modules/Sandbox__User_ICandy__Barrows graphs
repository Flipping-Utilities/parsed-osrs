    plot:setXAxisType( 'logarithmic' )
    plot:setYLabel( 'Probability' )
    plot:setXLabel( 'Chests' )
	plot:setYFormat( 'percent' )
	plot:setYLimits(0, 1, 0.1)
    for i = 2, 25 do
		local set = plot:newDataSet()
		data = {}
		for j = 1, #Xval do
			if not (i > 1 and prob_at_least_unique_pieces(i - 1, Xval[j]) < 0.001)
			and not (i < #Xval and prob_at_least_unique_pieces(i + 1, Xval[j]) > 0.999)
			then
				table.insert(data, {x=Xval[j], y=prob_at_least_unique_pieces(i, Xval[j])})
			end
		end
		set.data = data
		if i == 2 then
			set.label = '1 piece'
		elseif i == 3 then
			set.label = '2 pieces'
		else
			set.label = i - 1
		end
		set.fill = '+1'
    end
    return plot:finish()
end

