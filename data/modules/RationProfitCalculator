local p = {}

local exchange = require('Module:Exchange')

-- Fetch the price of an item using exchange._price
local function fetch_price(item)
    return exchange._price(item) or 0
end

local function getMultiplier(food_level,food_name)
	-- Determine cooking level multiplier
    local multiplier = 1
	if food_name == "Cooked chicken" or food_name == "Cooked meat" then
		multiplier = 2
    elseif food_level >= 30 and food_level <= 69 then
        multiplier = 2
    elseif food_level >= 70 then
        multiplier = 3
    end
	return multiplier
end

-- Calculate the profit for a specific food and leaf combination
local function calculate_profit(food, food_level, food_name, leaf, leaf_multiplier)
    local food_price = fetch_price(food)
    local leaf_price = fetch_price(leaf)
    local ration_price = fetch_price("Forester's ration")

	local profitMultiplier = getMultiplier(food_level,food_name)

    -- Calculate total rations and value
    local total_rations = profitMultiplier * leaf_multiplier
    local total_value = total_rations * ration_price
    
    -- Calculate leaf costs along with the meat/fish cost in total
    local total_cost = food_price + leaf_price
    local profit = total_value - total_cost
    
    return profit
    
end

