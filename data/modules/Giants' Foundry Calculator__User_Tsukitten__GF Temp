-- GE item name prefix per metal tier
local metalPrefix = {
    ['Bronze']     = 'Bronze',
    ['Iron']       = 'Iron',
    ['Steel']      = 'Steel',
    ['Mithril']    = 'Mithril',
    ['Adamantite'] = 'Adamant',
    ['Runite']     = 'Rune',
}

-- Query Cargo storeline table for the cheapest vendor source for a given metal tier.
-- Returns { price, item, shop, rawPrice, bars } or nil if no vendor source exists.
function p.cheapestVendor(metal)
    local prefix = metalPrefix[metal]
    if not prefix then return nil end

    local itemNames = {}
    for itemType, _ in pairs(gfCompatible) do
        table.insert(itemNames, prefix .. ' ' .. itemType)
    end

    local best = nil
    local allRows = {}
    local bestPerItem = {}  -- track cheapest shop per item name
    local highestStock = {}

    for _, itemName in ipairs(itemNames) do
        local ok, rows = pcall(function()
            return bucket("storeline")
                .select("sold_item", "sold_by", "store_sell_price", "store_stock", "store_delta")
                .where("sold_item", "=", itemName)
                .run()
        end)

        if ok and rows then
            for _, row in ipairs(rows) do
                local shopPrice = tonumber(row['store_sell_price'])
                local stock = tonumber(row['store_stock']) or 0
                if shopPrice and shopPrice > 0 and stock > 0 then
                    for itemType, barsWorth in pairs(gfCompatible) do
                        if itemName == prefix .. ' ' .. itemType then
                            local pricePerBar = shopPrice / barsWorth
                            local entry = {
                                price    = pricePerBar,
                                item     = itemName,
                                shop     = row['sold_by'],
                                rawPrice = shopPrice,
                                bars     = barsWorth,
                                stock    = stock,
                                delta    = tonumber(row['store_delta']) or 10,
                            }
                            -- Track cheapest price per item
                            if not bestPerItem[itemName] or pricePerBar < bestPerItem[itemName].price then
                                bestPerItem[itemName] = entry
                            end
                            -- Track highest stock per item
                            if not highestStock[itemName] or entry.stock > highestStock[itemName].stock then
                                highestStock[itemName] = entry
                            end
                            break
                        end
                    end
                end
            end
        end
    end

    -- Flatten into allRows, adding cheapest and highest stock rows per item
	for itemName, cheapEntry in pairs(bestPerItem) do
	    table.insert(allRows, { entry = cheapEntry, label = 'cheapest' })
	    local stockEntry = highestStock[itemName]
	    if stockEntry and stockEntry.shop ~= cheapEntry.shop then
	        table.insert(allRows, { entry = stockEntry, label = 'most stock' })
	    end
	    if best == nil or cheapEntry.price < best.price then
	        best = cheapEntry
	    end
end

    if not best then return nil end
    return { best = best, all = allRows }
end


function p.lazyplink(str)
    return '[[File:' .. str .. '.png|link=' .. str .. ']] [[' .. str .. ']]'
end

function p.strtobool(str)
    local result = false
    if str == 'true' then result = true end
    return result
end

function p.experience(quality)
    local result = (math.floor(quality*quality/73)+math.floor(1.5*quality)+1)*30
    return result
end

function p.metalScore(tier1, tier2, amount1, amount2)
    local value1
    local value2
    if tier2 == tier1 or tier2 == 0 then
        value1 = 10*tier1
        value2 = 0
    else
        value1 = 10*tier1*amount1/28
        value2 = 10*tier2*amount2/28
    end
    local result = math.floor((math.floor(10*value1)+math.floor(10*value2)+math.floor(value1*value2))/10)
    return result
end

