-- Spears cost bar + logs to smith but count as 2 bars in GF
local gfCompatible = {
    ['platebody']  = 4,
    ['warhammer']  = 2,
    ['battleaxe']  = 2,
    ['chainbody']  = 2,
    ['kiteshield'] = 2,
    ['2h sword']   = 2,
