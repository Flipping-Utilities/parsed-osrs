local function fmtPercentIncrease(ratio)
  if not ratio or ratio == "" or ratio == '{{NA}}' then return "{{NA}}" end
  -- convert ratio like 1.45 to percent increase "45.0%"
  return string.format("%.0f%%", (ratio - 1) * 100)
end

function p.main(frame)
  local args = frame:getParent().args or {}
  return p._main(args)
end

function p._main(args)
  local header = args.headerString or ""
  local actionName = args.actionName or ""
  local selectedTable
  if args.headerString == "Fruit tree seeds" then
  	selectedTable = fruitTrees
  elseif args.headerString == "Ashes" then
  	selectedTable = ashes
  elseif args.headerString == 'Uncut gems' then
  	selectedTable = uncutGems
  elseif args.headerString == "Hides" then
  	selectedTable = hides
  elseif args.headerString == "Logs" then
  	selectedTable = logs
  elseif args.headerString == "Raw fish" then
  	selectedTable = rawFish
  elseif args.headerString == "Tree seeds" then
  	selectedTable = trees
  end
  
  local out = buildTable(header, actionName, selectedTable)
  -- Return as nowiki so the wikitext is shown verbatim with real newlines
  return mw.text.nowiki(out)
end

function buildTable(headerString, actionName, tableVals)
  local lines = {}

  -- Section header and a blank line before the table (keep a blank line
  -- between heading and table so wikitext is valid)
  table.insert(lines, "===" .. headerString .. "===")

  -- Table start and header row (single newlines between table tokens)
  table.insert(lines, '{| class="wikitable"')
  table.insert(lines, '! ')
  table.insert(lines, '! Resource')
  table.insert(lines, '! XP when ' .. actionName)
  table.insert(lines, '! % increase')
  table.insert(lines, '! % increase from base')

  local firstTierXp = tableVals[1] and tableVals[1].xp
  local prevXp

  for i, current in ipairs(tableVals) do
    local ratioPrev = nil
    local ratioBase = nil

    if prevXp then
      ratioPrev = prevXp == 0 and '{{NA}}' or current.xp / prevXp
    end
    if firstTierXp then
      ratioBase = firstTierXp == 0 and '{{NA}}' or current.xp / firstTierXp
    end

    table.insert(lines, "|-")
    table.insert(lines, "| {{plinkt|" .. current.name .. "}}")
    table.insert(lines, "| " .. tostring(current.xp))
    table.insert(lines, "| " .. (ratioPrev and fmtPercentIncrease(ratioPrev) or "{{NA}}"))
    table.insert(lines, "| " .. (ratioBase and fmtPercentIncrease(ratioBase) or "{{NA}}"))

    prevXp = current.xp
  end

  table.insert(lines, "|}")

  -- join with single newline characters (LF)
  return table.concat(lines, "{n}")
end

return p