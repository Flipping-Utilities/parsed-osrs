	purpleWeights[k] = v
end

local weightSum150to300 = 0
for _, v in ipairs(PURPLES) do
	weightSum150to300 = weightSum150to300 + v.weight
end

for i = 150, 300, 5 do
	for _, v in ipairs(purpleWeights) do
		table.insert(v.weights, v.weight / weightSum150to300)
	end
end

-- for raid levels 300 to 500 weights of lb and fang scales resulting in realtive weightings to scale for all uniques
-- weighstum of non lb/fang uniques
local partialWeightSum = 100

for i = 305, 350, 5 do
	local WeightFang = 70
	local WeightLb = 70 
	for _, v in ipairs(purpleWeights) do
		if v.item == "Osmumten's fang" then
			WeightFang = WeightFang - math.floor((i - 300) * 0.2)
		elseif v.item == "Lightbearer" then
	    	WeightLb = WeightLb - math.floor((i - 300) * 0.2)
		end
	end
	local scaledWeightSum = partialWeightSum + WeightFang + WeightLb
	for _, v in ipairs(purpleWeights) do
		if v.item == "Osmumten's fang" then
			table.insert(v.weights, WeightFang / scaledWeightSum)
		elseif v.item == "Lightbearer" then
	    	table.insert(v.weights, WeightLb / scaledWeightSum)
		else
			table.insert(v.weights, v.weight / scaledWeightSum)
		end
	end
end

