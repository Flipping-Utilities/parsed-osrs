function loadData(slotName, attackSpeed, members, options)
	local mapping = {
        astab = "stab_attack_bonus",
    	aslash = "slash_attack_bonus",
    	acrush = "crush_attack_bonus",
    	amagic = "magic_attack_bonus",
    	arange = "range_attack_bonus",
    	dstab = "stab_defence_bonus",
    	dslash = "slash_defence_bonus",
    	dcrush = "crush_defence_bonus",
    	dmagic = "magic_defence_bonus",
    	drange = "range_defence_bonus",
    	str = "strength_bonus",
    	mdmg = "magic_damage_bonus",
    	rstr = "ranged_strength_bonus",
    	prayer = "prayer_bonus",
    	weight = "infobox_item.weight",
    	image = "infobox_item.image",
    	members = "infobox_item.is_members_only",
    	name = "page_name_sub",
    	variantof = "page_name",
    	speed = "weapon_attack_speed",
    	defver = "infobox_item.default_version"
    }
		local exclusionListCategories = {
		{ options.beta,				'Beta items' },
		{ options.beta,				'Sailing alpha content' },
		{ options.beta,				'Sailing beta content' },
		{ options.cache,			'Pages using information from game APIs or cache' },
		{ options.bounty,			'Bounty Hunter' },
		{ options.discontinued,		'Discontinued content' },
		{ options.dmm,				'Deadman seasonal items' },
		{ options.event,				'Deadman: Armageddon' },
		{ options.event,				'Deadman: Annihilation' },
		{ options.event,				'Twisted League' },
		{ options.event,				'Trailblazer League' },
		{ options.event,				'Shattered Relics League' },
		{ options.event,				'Trailblazer Reloaded League' },
		{ options.event,				'Raging Echoes League' },
		{ options.event,				'Demonic Pacts League' },
		{ options.event,				'Grid Master' },
		{ options.event,				'Event rewards' },
		{ options.emir,				'Emir\'s Arena' },
		{ options.failedPoll,		'Pages containing information from failed polls' },
		{ options.gauntlet,			'The Gauntlet' },
		{ options.lms,				'Last Man Standing in-game items' },
		{ options.nz,				'Nightmare Zone' },
		{ options.castleWars,				'Castle Wars' },
		{ options.herald,				'Heraldic POH items' },
		{ nil,				'Port tasks' },
		}    
local reverse_mapping = {}
    
    local selects = {}
    for k, v in pairs(mapping) do
    	table.insert(selects, v)
    	reverse_mapping[v] = k
    end

    local b = bucket("infobox_bonuses")
    	.select(unpack(selects))
    	.join("infobox_item", "infobox_item.page_name_sub", "infobox_bonuses.page_name_sub")
    	.where("equipment_slot", slotName)
		.limit(2000)
	--	.orderBy("infobox_bonuses.page_name_sub", "ASC")
	for _, excl in ipairs(exclusionListCategories) do
		if(not excl[1]) then
			b.where(bucket.Not("Category:" .. excl[2]))
		end			
	end
   if not options.allVariants then
    b.where(bucket.Or({"infobox_item.default_version", true}, {"infobox_item.version_anchor", 'Trimmed'}, {"infobox_item.version_anchor", 'Inert'} )) 
   	end
	if options.members == 'members' then
		b.where("infobox_item.is_members_only", true)
	elseif options.members == 'f2p' then
		b.where("infobox_item.is_members_only", false)
		else
		end
		



	local t1 = os.clock()
	local data = b.run()
	local t2 = os.clock()
	assert(data ~= nil and #data > 0, 'Bucket query failed')

	local ret_data = {}
	for _, item in ipairs(data) do 
    	local ret_result = {}
    	for k, v in pairs(item) do
	    	ret_result[reverse_mapping[k]] = v
    	end
    	if ret_result.image and #ret_result.image > 0 then
    		ret_result.image = ret_result.image[1]
    	else
    		ret_result.image = 'File:' .. ret_result.name .. '.png'
    	end
    	table.insert(ret_data, ret_result)
	end

	mw.log(string.format('Bucket: entries %d, time elapsed: %.3f ms.', #data, (t2 - t1) * 1000))

	return ret_data
end

-- JSON data dump entry-point
function p.dumpData(frame)
	local args = frame:getParent().args
	return p._dumpData(args)
end

function p._dumpData(args)
	local slot = args.slot
	assert(contains(slotOptions, slot), 'Invalid slot specified')

	local data = loadData(slot, true)

	-- Tests indicate that JSON pretty-printing increases the size by a factor of 1.78.
	-- Removing indenting results in an increase in size by a factor of 1.15.
	-- The latter is a very reasonable trade-off to make the files more wiki-friendly.
	local prefix = string.format('-- Data for item slot \'%s\' @ %s.\n-- Generated by Module:Slottable, function dumpData()\nreturn mw.text.jsonDecode([=[\n', slot, os.date('%F %T', os.time()))
	local rawjson = mw.text.jsonEncode(data, mw.text.JSON_PRETTY)
	local jsondata, subst = rawjson:gsub('\n%s+', '\n')
	local postfix = '\n]=])\n'

	mw.log(string.format('Dumping JSON data for item slot \'%s\'. Raw size: %d bytes, formatted size: %d bytes (factor: %.2f).', slot, rawjson:len(), jsondata:len(), jsondata:len() / rawjson:len()))

	return prefix .. jsondata .. postfix
end


-- Turtle data dump entry-point
function p.dumpDataTTL(frame)
	local args = frame:getParent().args
	return p._dumpDataTTL(args)
end

function p._dumpDataTTL(args)
	local slot = args.slot
	assert(contains(slotOptions, slot), 'Invalid slot specified')

	local data = loadData(slot, true)

    local slot_
    if(slot == "2h") then
    	slot_ = "zweihander"
    else
    	slot_ = slot
    end

	local prefix = string.format('# Data for item slot \'%s\' @ %s.\n# Generated by Module:Slottable, function dumpDataTTL()\n\n', slot, os.date('%F %T', os.time()))
	prefix = prefix .. "@prefix " .. slot_ .. ": <http://oldschool.runescape.wiki/rdf/" .. slot_ .. "/> .\n"
	prefix = prefix .. "@prefix prop: <http://oldschool.runescape.wiki/rdf/prop/> .\n\n"

	local ttlData = ""
	for _, i in ipairs(data) do
		ttlData = ttlData .. slot_ .. ":" .. _ .. " " .. "prop:slot \"" .. slot_ .. "\"; "
		local outl = {}
		for k, v in pairs(i) do
			if((k == "image") or (k == "name") or (k == "variantof")) then
				table.insert(outl, "prop:" .. k .. " \"" .. tostring(v) .. "\"")
			else
				table.insert(outl, "prop:" .. k .. " " .. tostring(v))
			end
		end
		ttlData = ttlData .. table.concat(outl, "; ") .. " .\n"
	end

	local postfix = '\n\n'
	mw.log(string.format('Dumping Turtle data for item slot \'%s\'. Size: %d bytes.', slot, ttlData:len()))

	return prefix .. ttlData .. postfix
end

function p._main(args)
	local slot = string.lower(paramTest.default_to(args.slot, ''))
	local members = string.lower(paramTest.default_to(args.members, 'all'))

	assert(contains(slotOptions, slot), 'Invalid slot specified')
	assert(contains(memberOptions, members), 'Invalid members status specified')

	local beta = yesNo(paramTest.default_to(args.beta, false), false)
	local bounty = yesNo(paramTest.default_to(args.bounty, false), false)
	local discontinued = yesNo(paramTest.default_to(args.discontinued, false), false)
	local dmm = yesNo(paramTest.default_to(args.dmm, false), false)
	local emir = yesNo(paramTest.default_to(args.emir, false), false)
	local event = yesNo(paramTest.default_to(args.event, false), false)	
	local failedPoll = yesNo(paramTest.default_to(args.failedpoll, false), false)
	local gauntlet = yesNo(paramTest.default_to(args.gauntlet, false), false)
	local lms = yesNo(paramTest.default_to(args.lms, false), false)
	local quest = yesNo(paramTest.default_to(args.quest, true), true)
	local nz = yesNo(paramTest.default_to(args.nz, false), false)
	local allVariants = yesNo(paramTest.default_to(args.allVariants, false), false)
	local cache = yesNo(paramTest.default_to(args.cache, false), false) 
	local castleWars = yesNo(paramTest.default_to(args.castleWars, false), false)
	local exclude = paramTest.default_to(args.exclude, "")
	
	-- UIM specific tables, that only display items that can be:
	--  purchased, stored in the POH, or stored in STASH untsi
	local uim = yesNo(paramTest.default_to(args.uim, false), false)

	local attackSpeed = false
	if((slot == '2h') or (slot == 'weapon')) then
		attackSpeed = true
	end

	local data = loadData(slot, attackSpeed, members, {members = members, uim = uim, beta = beta, bounty = bounty, discontinued = discontinued, dmm = dmm, emir = emir, event = event, failedPoll = failedPoll, gauntlet = gauntlet, lms = lms, quest = quest, nz = nz, cache = cache, exclude = exclud})
	data = filterData(data, slot, {uim = uim, allVariants = allVariants})

	
	local ret = createHeader(slot, attackSpeed, uim)
	for _, item in ipairs(data) do
		ret:node(buildRow(item, attackSpeed, uim))
	end

	return ret
end

function p.main(frame)
	local args = frame:getParent().args
	return p._main(args)
end

