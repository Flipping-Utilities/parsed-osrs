function p.main(frame)
	local args = frame:getParent().args
	
	-- Determine whether the "current" value is Level or XP. This needs to be two different input arguments due to the way the calc-core High Score lookup functions.
	if args.currentToggle == 'Level' then
		current = tonumber(args.lvlInput)
	else
		current = tonumber(args.XPInput)
	end
	
	-- Compute current/goal levels and experience as well as the experience remaining between the difference
	local bulkLevelInformation = helpers.calculateCurrentGoalInformation(current, args.currentToggle, args.goal, args.goalToggle)
	
	-- Pull out the relevant data from the sub module and call the function with the passed in skill method
	local methods = mw.loadData('Module:Skill calc/' .. args.skill)
	-- Pull and sort the data
	-- Calculators may or may not have a stepLimit param; only do additional filtering if it's used
	local data
	if args.stepLimit ~= nil then 
		local filteredData = helpers.filterData(methods, args.method, args.dataCriteria, bulkLevelInformation.currentLevel)
		data = {}
		for _, v in ipairs(filteredData) do
			if tostring(args.stepLimit):lower() == 'show all' or v.steps == tonumber(args.stepLimit) then
				table.insert(data, v)
			end
		end
	else
		data = helpers.filterData(methods, args.method, args.dataCriteria, bulkLevelInformation.currentLevel)
	end
	
	local setValue = 0
	-- Check if the skill the calculator is using is eligible for the experience set bonus
	if helpers.checkForBoostingSetSkill(args.skill) then
		local pieces = {
			{ args.head, 0.004 },
			{ args.body, 0.008 },
			{ args.legs, 0.006 },
			{ args.boots, 0.002 }
		}
		local zealotRobes = {
			{ args.head, 0.0125 },
			{ args.body, 0.0125 },
			{ args.legs, 0.0125 },
			{ args.boots, 0.0125 }
		}
		local sailingKeg = {
			{ args.horizonsLure, 0.025},
		}
		local piecesToSend = args.skill == 'Prayer' and zealotRobes or (args.skill == 'Sailing' and sailingKeg) or pieces
		local newSetValue = helpers.determineSetValue(piecesToSend, args.skill)
		setValue = newSetValue
	end
	
	-- Build a message for the user to show the difference between current and goal experience
	local message = helpers.createMessage(args.skill, bulkLevelInformation)

	local options = {
		skill = args.skill,
		experienceRemaining = bulkLevelInformation.experienceRemaining,
		currentLevel = bulkLevelInformation.currentLevel,
		setValue = setValue,
		secateurs = args.secateurs,
		farmingCape = args.farmingCape,
		diary = args.diary,
		attas = args.attas,
		compost = args.compost,
		unnotingService = args.unnotingService,
		bonus = args.bonus,
		dataCriteria = args.dataCriteria,
		fellingAxe = args.fellingAxe,
		leagueMultiplier = args.leagueMultiplier or 1,
		amulet = args.amulet,
		amuletUse = args.amuletUse,
		head = args.head,
		decant = args.decant,
		herbServices = args.herbServices,
		runeSaving = args.runeSaving,
		alch = args.highAlch or 'false',
		horizonsLure = args.horizonsLure,
		perHour = tonumber(args.perHour or 0),
		OpportunityCost = tonumber(args.OpportunityCost),
	}
	
	-- Create the headers and alignments
	local ret = createHeaders(args.skill, frame)
	
	-- make a mutable copy of the data
	data = deep_clone(data)
	
	-- pre-process herblore to add dynamic entries to the table
	if options['skill'] == 'Herblore' then
		preprocess_herblore(data, options, frame)
	end
	
	-- Loop through the data and make each table row of data (including calculations)
	for _, v in ipairs(data) do
		if ({ Woodcutting = true, Mining = true })[args.skill] then
			ret:node(make_row_no_materials(v, options))
		elseif ({ Agility = true, Thieving = true, Sailing = true })[args.skill] then
			ret:node(make_row_barebones(v, options))
		elseif ({ Firemaking = true, Prayer = true })[args.skill] then
			ret:node(make_row_no_profit(v, options, args.skill, frame))
		else
			ret:node(make_row_full(v, options, frame))
		end
	end
	
	-- Return the table and message to the user
	return tostring(message) .. tostring(ret) .. frame:preprocess('<references />')
end

function spreadMaterials(materials, actionsNeeded, reducedActionsNeeded, frame)
	local materialsFormatted = ''
	if materials == nil then
		return '-'
	end
	
	for _, v in ipairs(materials) do
		local actionsReduced = (reducedActionsNeeded and tonumber(reducedActionsNeeded) or v.onlyone and 1 or tonumber(actionsNeeded))
		--quantity is actionsNeeded for farming, not actionsReduced.  test change for herbs
		local quantity = (v.quantity or 1) * (v.onlyone and 1 or tonumber(actionsNeeded))
		if actionsReduced > 1 then
			-- When showing materials needed for a goal, round up. When showing a single action only, show fracional values rounded to 2 digits
			quantity = math.ceil(quantity)
		else
			quantity = math.ceil(1000*quantity - 0.5)/1000 -- ceil(x - 0.5) = round(x)
		end
		materialsFormatted = materialsFormatted .. string.format('%s × [[File:%s.png|link=%s]] [[%s|%s]]', commas(quantity), v.name, v.name, v.name, v.title or v.name)
		if gePrices[v.name] and v.name:match('%([1-3]%)$') and gePrices[v.name:gsub('%([1-3]%)$', '(4)')] then
			materialsFormatted = materialsFormatted .. frame:preprocess('<ref name="partialPotion">Price is calculated based on the 4-dose variant</ref>')
		end
		materialsFormatted = materialsFormatted .. '<br>'
	end
		
	return string.len(materialsFormatted) > 1 and materialsFormatted or '-'
end

function getInputCost(materials, actionsNeeded, reducedActionsNeeded)
	local totalCost = 0
	
	-- guard case for when there are no materials
	if materials == nil then
		return totalCost
	end
	
	for _, v in ipairs(materials) do
		local actionsReduced = (reducedActionsNeeded and tonumber(reducedActionsNeeded) or v.onlyone and 1 or tonumber(actionsNeeded))
		-- adjust quantity based on number of actions needed
		local quantity = (v.quantity and v.quantity or 1)
		if v.cost then
			totalCost = totalCost + (v.cost * (quantity * (v.onlyone and 1 or tonumber(actionsNeeded))))
		elseif gePrices[v.name] ~= nil then
			local price = gePrices[v.name]
			-- if an input item is an item ending in (1), (2), or (3), use an appropriate fraction of the (4) variant's price instead to get more accurate prices
			-- (this should ideally only match potions)
			if v.name:match('%([1-3]%)$') and gePrices[v.name:gsub('%([1-3]%)$', '(4)')] then
				price = gePrices[v.name:gsub('%([1-3]%)$', '(4)')] / 4 * tonumber(v.name:match('%(([1-3])%)$'))
			end
			totalCost = totalCost + (price * quantity * (v.onlyone and 1 or tonumber(actionsNeeded)))
		end
	end
	
	return math.ceil(totalCost)
end

function getOutputPrice(name, outputItem, outputQuantity, actionsNeeded, reducedActionsNeeded, alch)
	local itemToLookUp = outputItem and outputItem or name
	
	if alch == 'true' then
		-- Get high alch value from bucket
		local alchData = bucket("infobox_item")
			.select("high_alchemy_value")
			.where("page_name", itemToLookUp)
			.limit(1)
			.run()
		
		if alchData ~= nil and #alchData > 0 and alchData[1].high_alchemy_value ~= nil then
			return (alchData[1].high_alchemy_value - gePrices['Nature rune']) * outputQuantity * tonumber(actionsNeeded)
		else
			return 0
		end
	elseif gePrices[itemToLookUp] ~= nil then
		-- Scale quantity based off actions needed for farming.
		return math.ceil(0.98 * gePrices[itemToLookUp]) * outputQuantity * tonumber(actionsNeeded)
	else
		return 0
	end
end

