	ref = ref .. (a.notes or '')
	
	if onmain() and not (hc(a.author) and hc(a.url) and hc(a.title) and hc(a.blogdate)) then --validation, required params are author, url, title and blogdate (mainonly)
		c = '[[Category:Incomplete references]]'
	end
	return ref, c
end


