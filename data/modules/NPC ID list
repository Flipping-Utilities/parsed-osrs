local IDListUtils = require('Module:IDListUtils')

local p = {}

function p.render()
	local bucketName = 'npc_id'
	local results = IDListUtils.fetchResults(bucketName)

	local output = {
		'Total number of NPCs in this table: ' .. #results .. '.',
		'{| class="sortable wikitable"',
		'!Item',
		'![[Bucket:' .. bucketName .. '|NPC IDs]]'
	}
	
	table.sort(results, 
		function(a,b)
			return a.page_name_sub < b.page_name_sub
		end
	)

	for _, result in ipairs(results) do
		local ids = IDListUtils.linkIds('npc', result.id)

		table.insert(output, '|-')
		table.insert(output, '|[[' .. result.page_name_sub..']]')
		table.insert(output, '|' .. ids)
	end

	table.insert(output, '|}')

	return table.concat(output, '\n')
end

return p