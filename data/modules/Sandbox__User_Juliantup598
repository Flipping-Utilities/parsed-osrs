function p.main(frame)
	args = frame.args
	return p._main(args)
end

function p._main(args)
	required_mats = calc_mat_requirements(args)
	return create_table(required_mats)
end

function create_table(materials)
	local t = mw.html.create('table')
	t:addClass('wikitable sortable')
	:tag('tr')
	:tag('th')  :wikitext('Item')       :attr('colspan', 2) :done()
	:tag('th')  :wikitext('Quantity')                       :done()
	:done()
	for mat, quantity in pairs(materials) do
		t:tag('tr')
	    :tag('td')	:wikitext("[[File:" .. mat_data[mat].img .. ".png|25px]]") :done()
	    :tag('td')	:wikitext("[[" .. mat_data[mat].page .. "|" .. mat_data[mat].name .. "]]") :done()
	    :tag('td')	:wikitext(quantity) :done()
	    :done()
	end
	return t
end

function calc_mat_requirements(args)
	current_mats = {}
	
	if args.weapons
	then 
		current_mats = add_mats(current_mats, get_item_cost('weapon', 'staff', args.staffTier))
		current_mats = add_mats(current_mats, get_item_cost('weapon', 'bow', args.bowTier))
		current_mats = add_mats(current_mats, get_item_cost('weapon', 'halberd', args.halberdTier))
	end
	
	if args.armour
	then 
		current_mats = add_mats(current_mats, get_item_cost('armour', 'helm', args.helmTier))
		current_mats = add_mats(current_mats, get_item_cost('armour', 'legs', args.bodyTier))
		current_mats = add_mats(current_mats, get_item_cost('armour', 'body', args.legsTier))
	end
	
	if args.food
	then 
		current_mats = add_mats(current_mats, get_consumable_cost('egniol', args.egniolQuantity))
		current_mats = add_mats(current_mats, get_consumable_cost('fish', args.paddlefishQuantity))
		current_mats = add_mats(current_mats, get_consumable_cost('corrupted_fish', args.corrPadQuantity))
	end
	
	if args.other
	then 
		current_mats = add_mats(current_mats, get_consumable_cost('teleport_crystal', args.teleCrystal))
		current_mats = add_mats(current_mats, get_consumable_cost('escape_crystal', 1))
	end
	
	return current_mats
end

function get_item_cost(item_type, item, tier)
	return mats[item_type][tier][item]
end

function get_consumable_cost(item, quantity)
	food_mats = {}
	for i, mat_quantity in ipairs(mats.item) do
      food_mats[i] = mat_quantity * quantity
    end
	return food_mats
end

function add_mats(current_mats, new_tier_mats)
	for k,v in pairs(new_tier_mats) do
		if current_mats[k] ~= nil then
			current_mats[k] = current_mats[k] + new_tier_mats[k]
		else
			current_mats[k] = new_tier_mats[k]
		end
	end
	return current_mats
end

