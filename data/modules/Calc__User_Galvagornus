local p = {}

function expr(x)
	x = tostring(x)
	local expr_good, expr_val = pcall(mw.ext.ParserFunctions.expr, x)
	if expr_good then
		return tonumber(expr_val)
	end
	return nil
end

-- from WP
function choose(n,k)
	if k < 0 or k > n then
		return 0
	end
	if k == 0 or k == n then
		return 1
	end
	k = math.min(k, n-k) -- symmetry
	c = 1
	for i=0,k-1 do
		c = c * (n-i) / (k - i)
	end
	return c
end

