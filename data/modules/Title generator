function p._main(args)
	local ret
	local whichname = args.name
	math.randomseed( os.time() + math.floor(os.clock() * 1000000000) )

	if whichname == 'Boat name' then
		ret = (boat.desc[math.random(1, #boat.desc)] .. ' ' .. boat.noun[math.random(1, #boat.noun)])
	elseif whichname == 'Fremennik name' then
		ret = (frem.prefix[math.random(1, #frem.prefix)] .. '' .. frem.suffix[math.random(1, #frem.suffix)])
	elseif whichname == 'Vampyric name' then
		ret = (vyre.first[math.random(1, #vyre.first)] .. ' ' .. vyre.last[math.random(1, #vyre.last)])
	end
	return mw.text.trim(ret)
end

function p.main(frame)
	local args = frame.args
	return p._main(args)
end

return p