function Debug.makeFrame(t)
    local frame = getCurrentFrame():newChild(t)
    
    frame.getParent = function() return frame end
    mw.getCurrentFrame = function() return frame end
    
    if t.title then
    	local titleObj = newTitleObj(t.title)
    	mw.title.getCurrentTitle = function() return titleObj end
    end
    
    return frame
end

