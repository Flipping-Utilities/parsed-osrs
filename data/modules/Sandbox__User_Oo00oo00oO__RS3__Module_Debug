function Debug.trackTableAccess(t, name)
    name = name or ""
    local proxy = {} -- proxy table for 't'
    -- create metatable for the proxy
    local mt = {
        __index = function(_, k)
            if type(k) == "number" then
                print("*access to: " .. name .. "[" .. k .. "]")
            else
                print("*access to: " .. name .. "['" .. k .. "']")
            end
            return t[k] -- access the original table
        end,
        __newindex = function(_, k, v)
            if type(k) == "number" then
                print("*update of: " .. name .. "[" .. k .. "] = " .. tostring(v))
            else
                print("*update of: " .. name .. "['" .. k .. "'] = " .. tostring(v))
            end
            t[k] = v -- update original table
        end,
        __pairs = function()
            return function(_, k) -- iteration function
                local nextkey, nextvalue = next(t, k)
                if type(nextkey) == "number" then
                    print("*traversing element: " .. name .. "[" .. nextkey .. "]")
                elseif nextkey ~= nil then -- avoid last value
                    print("*traversing element: " .. name .. "['" .. nextkey .. "']")
                end
                return nextkey, nextvalue
            end
        end,
        __ipairs = function()
            return function(_, k) -- iteration function
                k = k + 1
                if t[k] ~= nil then
                    print("*traversing element: " .. name .. "[" .. k .. "]")
                else
                    return nil, nil
                end
                return k, t[k]
            end, nil, 0
        end,
        __call = function()
            -- __len and table.setn() don't exist in Scribunto so we have to use a workaround to proxy table length
            -- To get the length now use t() instead of #t
            return #t
        end
    }
    setmetatable(proxy, mt)

    return proxy
end

