-- [[ HELPER FUNCTIONS ]] --

local function formatValue(value, price_is_na)
    if price_is_na then return "N/A"
    elseif value > 0 and value < 1 then return string.format("%.2f", value)
    else return coins(value) end
end

local function getItemPrice(name)
    if name == "Mokhaiotl cloth" then
        return (gePrice("Confliction gauntlets") or 0) - (gePrice("Tormented bracelet") or 0)
    elseif name == "Dom" or name == "Spirit seed" or name == "Sun-kissed bones" or name == "Tooth half of key (moon key)" or name == "Clue scroll (elite)" then
        return 0
    end
    return gePrice(name) or 0
end

local function getUniquesPerLevel(level, excludePet)
    local prob = 0
    for item, rates in pairs(unique_rates) do
        if not (excludePet and item == "Dom") then
            if rates[level] then prob = prob + (1 / rates[level]) end
        end
    end
    return prob
end

-- [[ TABLE FORMATTING ]] --

local function format_results_tables(results)
    local output = "===Unique loot===\n"
    local unique_loot_table = mw.html.create("table"):addClass("wikitable align-center-1")
    local unique_loot_table_data = {}
    table.insert(unique_loot_table_data, {{tag = "th", text = "Item", attr = {colspan = 2}}, {tag = "th", text = "Expected Quantity"}, {tag = "th", text = "Expected Value"}})
    
    local total_unique_value, total_unique_qty = 0, 0
    local unique_items_order = {"Mokhaiotl cloth", "Eye of ayak (uncharged)", "Avernic treads", "Dom"}
    
    for _, item_name in ipairs(unique_items_order) do
        local expected_qty = results.uniques[item_name] or 0
        local item_price = getItemPrice(item_name)
        local item_value = expected_qty * item_price
        if item_name ~= "Dom" then total_unique_qty = total_unique_qty + expected_qty end
        total_unique_value = total_unique_value + item_value
        table.insert(unique_loot_table_data, {
            {text = string.format("[[File:%s.png|25x25px|link=%s]]", item_name, item_name)},
            {text = string.format("[[%s]]", item_name)},
            {text = string.format("%.4f", expected_qty)},
            {text = formatValue(item_value, item_price == 0)}
        })
    end
    table.insert(unique_loot_table_data, {
        {attr = {colspan = 2}, text = "Total (excluding Dom)", tag = "th"},
        {text = string.format("%.4f", total_unique_qty), tag = "th"},
        {text = formatValue(total_unique_value, false), tag = "th"}
    })
    tables._table(unique_loot_table, unique_loot_table_data)
    output = output .. tostring(unique_loot_table)

    output = output .. "\n===Common loot===\n"
    local common_loot_table = mw.html.create("table"):addClass("wikitable align-center-1")
    local common_loot_table_data = {}
    table.insert(common_loot_table_data, {{tag="th", text="Item", attr={colspan=2}}, {tag="th", text="Expected Quantity"}, {tag="th", text="Expected Value"}})
    
    local total_common_value = 0
    local all_common_items = {}
    for name, qty in pairs(results.regular_loot) do all_common_items[name] = qty end
    all_common_items["Demon tear (guaranteed)"] = results.guaranteed_tears
    all_common_items["Clue scroll (elite)"] = results.clue_scrolls
    
    local sorted_names = {}
    for name in pairs(all_common_items) do table.insert(sorted_names, name) end
    table.sort(sorted_names)

    for _, name in ipairs(sorted_names) do
        local qty = all_common_items[name]
        local price = (name == "Demon tear (guaranteed)") and getItemPrice("Demon tear") or getItemPrice(name)
        local val = qty * price
        total_common_value = total_common_value + val
        table.insert(common_loot_table_data, {
            {text = string.format("[[File:%s.png|25x25px]]", name:gsub(" %(guaranteed%)", ""))},
            {text = name}, {text = string.format("%.2f", qty)}, {text = formatValue(val, price == 0)}
        })
    end
    table.insert(common_loot_table_data, {{attr={colspan=3}, text="Total Common Value", tag="th"}, {text=formatValue(total_common_value, false), tag="th"}})
    tables._table(common_loot_table, common_loot_table_data)
    output = output .. tostring(common_loot_table)
    
    return output
end

local function format_milestone_tables(current_uniques, excludePet)
    local target = math.ceil(current_uniques)
    if math.abs(target - current_uniques) < 0.000001 then target = target + 1 end
    local remaining = target - current_uniques

    local output = "\n=== Progression to Next Unique (" .. target .. ") ===\n"
    if excludePet then output = output .. "''Calculation excludes the Dom pet.''<br/>" end

    -- Using String-based table construction to avoid mw.html method errors
    local html = {'<table class="wikitable">'}
    table.insert(html, '<tr><th>Stopping Point</th><th>Uniques / Session</th><th>Sessions Needed</th></tr>')

    for stop_lvl = 7, 9 do
        local ups = 0
        for i = 1, stop_lvl do ups = ups + getUniquesPerLevel(i, excludePet) end
        
        local label = (stop_lvl == 9) and "Level 9+" or "Level " .. stop_lvl
        local sessions = (ups > 0) and math.ceil(remaining / ups) or "N/A"
        local ups_formatted = string.format("%.5f", ups)
        
        table.insert(html, string.format('<tr><td>%s</td><td>%s</td><td>%s</td></tr>', label, ups_formatted, tostring(sessions)))
    end

    table.insert(html, '</table>')
    return output .. table.concat(html)
end

-- [[ MAIN FUNCTION ]] --

function p.main(frame)
    local args = frame.args
    local excludePet = (args.exclude_pet == "yes")
    local completions = {}
    local has_completions = false

    for i = 1, 8 do
        local num = tonumber(args['completions_' .. i])
        if num and num > 0 then completions[i] = num; has_completions = true end
    end
    local plus_comps = tonumber(args['completions_8+'])
    if plus_comps and plus_comps > 0 then completions[9] = plus_comps; has_completions = true end

    if not has_completions then return "Please enter at least one completion count." end

    local results = { regular_loot = {}, uniques = {}, guaranteed_tears = 0, clue_scrolls = 0 }

    for lvl, num_completed in pairs(completions) do
        local mult = loot_multipliers[lvl] or 0
        for _, item in ipairs(regular_loot_base) do
            local avg_base = (item.quantity[1] + item.quantity[2]) / 2
            if item.name == "Shark lure" then
                local f, l = (item.quantity[1] % 2 == 0 and item.quantity[1] or item.quantity[1]+1), (item.quantity[2] % 2 == 0 and item.quantity[2] or item.quantity[2]-1)
                avg_base = (f + l) / 2
            end
            local adjusted_qty = math.floor(avg_base * (1 + mult))
            results.regular_loot[item.name] = (results.regular_loot[item.name] or 0) + (adjusted_qty * item.rarity * num_completed)
        end

        local tear_map = {[3]=50, [4]=60, [5]=70, [6]=80, [7]=90, [8]=100, [9]=100}
        results.guaranteed_tears = results.guaranteed_tears + ((tear_map[lvl] or 0) * num_completed)

        for item, rates in pairs(unique_rates) do
            if rates[lvl] then
                results.uniques[item] = (results.uniques[item] or 0) + (num_completed / rates[lvl])
            end
        end

        results.clue_scrolls = results.clue_scrolls + (num_completed * (clue_rates[lvl] or 0))
    end

    local current_sum = 0
    for item, qty in pairs(results.uniques) do
        if not (excludePet and item == "Dom") then current_sum = current_sum + qty end
    end

    return format_results_tables(results) .. format_milestone_tables(current_sum, excludePet)
end

return p