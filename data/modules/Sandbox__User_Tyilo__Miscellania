			:tag('b')
				:wikitext(best[2])
			:done()
			:wikitext(' and 5 workers on ')
			:tag('b')
				:wikitext(second_best[2])
			:done()
			:wikitext(': ' .. frame:expandTemplate{title='Coins', args={expected_profit}})
	
	local t = div:tag('table')
	
	t
		:addClass('wikitable sortable')
			:tag('tr')
				:tag('th')
					:wikitext('Method')
				:done()
				:tag('th')
					:wikitext('Income (10 workers)')
				:done()
				:tag('th')
					:wikitext('Profit (10 workers)')
				:done()
				:tag('th')
					:wikitext('Notes')
	
	for _, method in ipairs(p.get_bests()) do
		local extra_class = ''
		if method[2] == best[2] then
			extra_class = 'table-bg-green'
		elseif method[2] == second_best[2] then
			extra_class = 'table-bg-yellow'
		end
		
		local profit = method[1] - 50000
		
		t
			:tag('tr')
				:addClass(extra_class)
				:tag('td')
					:wikitext(method[2])
				:done()
				:tag('td')
					:wikitext(frame:expandTemplate{title='Coins', args={method[1]}})
				:done()
				:tag('td')
					:wikitext(frame:expandTemplate{title='Coins', args={profit}})
				:done()
				:tag('td')
					:wikitext(type_notes[method[2]] or '')
	end
	
	return tostring(div)
end

