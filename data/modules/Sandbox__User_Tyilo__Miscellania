function get_quantity(inverse_cost)
	local magic_constant = 1143 -- Somehow related to 262,143 ???
	
	return inverse_cost * magic_constant * max_workers / 2048
end

function p.get_income(type)
	local items = types[type]
	
	local value = 0
	for item, inv_quantity in pairs(items) do
		value = value + p._get_value(item) * get_quantity(inv_quantity)
	end
	
	return value
end

function lex_cmp(a, b)
	i = 0
	while true do
		i = i + 1
		
		if a[i] == nil and b[i] == nil then
			return false -- a == b	
		end
		if a[i] == nil then
			return true -- a shorter than b
		end
		if b[i] == nil then
			return false -- b shorter than a
		end
		
		if a[i] < b[i] then
			return true
		end
		if a[i] > b[i] then
			return false
		end
	end
end

function rev_cmp(f)
	return function(a, b)
		return not f(a, b)
	end
end

function p.get_bests()
	local t = {}
	
	for type, _ in pairs(types) do
		table.insert(t, {p.get_income(type), type})
	end
	
	table.sort(t, rev_cmp(lex_cmp))
	
	return t
end

function p.get_two_bests()
	bests = p.get_bests()
	
	for i, method in ipairs(bests) do
		if i == 1 then
			best = method
		else
			best_type = best[2]:match("%w+")
			this_type = method[2]:match("%w+")
			
			if this_type ~= best_type then
				second_best = method
				break
			end
		end
	end
	
	return best, second_best
end

function p.main(frame)
	local best, second_best = p.get_two_bests()
	
	local div = mw.html.create('div')
	
	local expected_profit = best[1] + second_best[1] / 2 - 75000
	
	div
		:tag('p')
