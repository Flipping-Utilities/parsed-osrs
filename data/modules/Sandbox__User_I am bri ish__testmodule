local p = {}

function p.render(frame)
    local expr = frame.args[1] or ""
    local function toHTML(s)
        local result = s
        local handled = false
        local rootHandled, rootResult = p.handleSquareRoots(result)
        if rootHandled then
            result = rootResult
            handled = true
        end

        if not handled then
            local fractionHandled, fractionResult = p.handleFractions(result)
            if fractionHandled then
                result = fractionResult
                handled = true
            end
        end

        if not handled then
            result = string.gsub(result, "([xyzXYZ])", "''%1''")
        end
        
        return result
    end

    local output = toHTML(expr)
    return '<span style="font-size:120%;white-space:nowrap;">' .. output .. '</span>'
end

function p.handleSquareRoots(s)
    local start, finish, content = string.find(s, "sqrt%((.-)%)")
    if start then

        local processedContent = p.render({ args = { content } })
        
        local rootHTML = '<span style="text-decoration:overline;display:inline-block;padding:0 2px;">' .. processedContent .. '</span>'
        
        local finalResult = s:sub(1, start-1) .. '√' .. rootHTML .. s:sub(finish+1)
        return true, finalResult
    end
    return false, s
end

function p.handleFractions(s)
    local function findTopLevelSlash(expr)
        local depth = 0
        for i = 1, #expr do
            local c = expr:sub(i, i)
            if c == "(" then
                depth = depth + 1
            elseif c == ")" then
                depth = depth - 1
            elseif c == "/" and depth == 0 then
                return i
            end
        end
        return nil
    end

    local slash_pos = findTopLevelSlash(s)
    if slash_pos then
        local num = s:sub(1, slash_pos - 1)
        local den = s:sub(slash_pos + 1)
        
        local processedNum = p.render({ args = { num } })
        local processedDen = p.render({ args = { den } })

        local fractionHTML = '<sup>' .. processedNum .. '</sup>&frasl;<sub>' .. processedDen .. '</sub>'
        return true, fractionHTML
    end

    return false, s
end

return p