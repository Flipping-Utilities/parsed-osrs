function p.main(frame)
	local args = frame:getParent().args

	return _main(args)
end

function ucfirst(s)
    return s:sub(1, 1):upper() .. s:sub(2)
end

function _main(args)
	local level = tonumber(args.level)
	local xp = tonumber(args.xp)
	local noticeBoard = args.noticeBoard
	local cargoLocation = args.cargoLocation
	local destination = args.destination
	local item = args.item
	local qty = args.qty
	local taskId = args.taskId
	local transcript = args.transcript
	local bucketArg = args.bucket

	local cargoLocationNoThe, _ = string.gsub(cargoLocation, '^The ', '')
	local destinationNoThe, _ = string.gsub(destination, '^The ', '')
	local itemShortName = ucfirst(string.gsub(item, '^Crate of ', ''))

	local transcriptLink
	if transcript ~= nil then
		transcriptLink = string.format('Transcript:%s', transcript)
	end

	if bucketArg == nil or bucketArg == '' then
		bucket('couriertaskline').put({
			["level"] = level,
			["xp"] = xp,
			["notice_board"] = noticeBoard,
			["cargo_location"] = cargoLocation,
			["destination"] = destination,
			["item"] = item,
			["qty"] = qty,
			["task_id"] = taskId,
			["transcript"] = transcriptLink
		})
	end

	local xpCommas
	if xp ~= nil then
		xpCommas = lang:formatNum(xp)
	else
		xpCommas = 'Unknown'
	end

	local mapArgs = {
		['type'] = 'maplink',
		['mtype'] = 'pin',
		['group'] = taskId,
		['text'] = 'Map'
	}
	mapArgs[1] = string.format('icon:greenPin,x:%d,y:%d,title:Notice board', p.noticeBoardLocations[noticeBoard][1], p.noticeBoardLocations[noticeBoard][2])
	mapArgs[2] = string.format('icon:yellowPin,x:%d,y:%d,title:Withdraw cargo', p.ledgerTableLocations[cargoLocation][1], p.ledgerTableLocations[cargoLocation][2])
	mapArgs[3] = string.format('icon:redPin,x:%d,y:%d,title:Deposit cargo', p.ledgerTableLocations[destination][1], p.ledgerTableLocations[destination][2])

	local row = mw.html.create('tr')
		:tag('td'):wikitext(level):done()
		:tag('td'):wikitext(xpCommas):done()
		:tag('td'):wikitext(string.format('[[%s]]', noticeBoard)):done()
		:tag('td'):wikitext(string.format('[[%s]]', cargoLocation)):done()
		:tag('td'):wikitext(string.format('[[%s]]', destination)):done()
		:tag('td'):addClass('plinkt-image inventory-image'):wikitext(string.format('[[File:%s (%s).png|link=%s#%s]]', item, destination, item, destination)):done()
		:tag('td'):addClass('plinkt-link'):wikitext(string.format('[[%s#%s|%s]]', item, destination, itemShortName)):done()
		:tag('td'):wikitext(qty):done()
		:tag('td'):wikitext(buildMap(mapArgs)):done()

	return tostring(row)
end

return p