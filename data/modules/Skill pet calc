function p.main(frame)
	local args = frame:getParent().args
	local level = args.level
	local pet = args.pet
	local actionsPerHour = args.actionsPerHour or 1
	local petData = pets[pet]
	local maxExp = args.maxExp
	if maxExp == "Yes" then
		maxExp = 15
	else
		maxExp = 1
	end

	local ret = mw.html.create('table'):addClass('wikitable sortable autosort=2,a sticky-header align-center-2 align-center-3 align-center-4 ')
	ret:tag('tr')
		:tag('th'):wikitext('Method')
		:tag('th'):wikitext('Level')
		:tag('th'):wikitext('Chance per action')
		:tag('th'):wikitext('Chance per hour<br />with APH')
	
	local sortedMethods = {}
	for method, data in pairs(petData) do
		table.insert(sortedMethods, {method = method, data = data})
	end
	
	table.sort(sortedMethods, function(a, b)
		return tonumber(a.data.level) < tonumber(b.data.level)
	end)
	
	for _, entry in ipairs(sortedMethods) do
		ret:node(make_row(entry.data, entry.method, level, actionsPerHour, entry.data.link, maxExp))
	end
	
	return tostring(ret)
end

function make_row(data, method, level, actionsPerHour, link, maxExp)
	local doNotCalculate = ({ Minnow = true, ['Fishing Trawler'] = true })[method]
	local chancePerAction = doNotCalculate and data.base or tonumber(data.base) - (tonumber(level) * 25)
	chancePerAction = helpers.jagexFloor((chancePerAction / maxExp), 2)
	local chancePerHour = helpers.jagexFloor(1/(1-math.pow(1-1/chancePerAction, actionsPerHour)), 2)

	return mw.html.create('tr')
		:tag('td'):wikitext('[[' .. link .. '|' .. method .. ']]'):done()
		:tag('td'):wikitext(data.level):done()
		:tag('td'):attr('data-sort-value', 1/chancePerAction):wikitext('1/' .. commas(chancePerAction)):done()
		:tag('td'):attr('data-sort-value', 1/chancePerHour):wikitext('1/' .. commas(chancePerHour)):done()
end

return p