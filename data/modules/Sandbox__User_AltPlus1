function p.main(frame)
	local args = frame.args
	return p.calc(args.chance, args.kills, args.dropped)
end

function p.calc(chanceTxt, kc, obtained)
	local chance = expr(chanceTxt)
	if not chance then
		return 'Looks like there was an error with your input chance, try typing it in again'
	else
		if chance > 1 then
			chance = 1 / chance
			chanceTxt = string.format("1/%s", chanceTxt)
		elseif chance <= 0 then
			return "You put your chance at 0 or negative, how you gonna get that drop?"
		end
	end
	
	kc = tonumber(kc)
	if not kc or kc == 0 then
		return "You ain't killed anything you crazy fool"
	end
	obtained = tonumber(obtained) or 0
	
	if kc < obtained then
		return 'More items dropped than things killed? how?'
	end
	
	if choose(kc, obtained) == 1/0 then -- Check if we can handle these values
		return "Sorry, your killcount and obtained number combination is too large for this calculator. Try reducing your numbers."
	end
	
	local luck = 0.0
	for i = 0, obtained do
		luck = luck + choose(kc, i) * math.pow(chance, i) * math.pow(1 - chance, kc - i)
	end
	
	local chanceMoreThanObtained = 1.0 - luck
	
	local luckObtainedOrMore = 0.0
	for i = obtained, kc do
		luckObtainedOrMore = luckObtainedOrMore + choose(kc, i) * math.pow(chance, i) * math.pow(1 - chance, kc - i)
	end

	local luckLessThanObtained = 0.0
	for i = 0, obtained - 1 do
		luckLessThanObtained = luckLessThanObtained + choose(kc, i) * math.pow(chance, i) * math.pow(1 - chance, kc - i)
	end

	local flavour = flavourText(chanceMoreThanObtained * 100, obtained)
	
	return string.format("You killed %s monsters for an item with a %s (%.6f%%) drop chance. You had a:\n* %.8f%% chance of getting %s drops or fewer\n* %.8f%% chance of getting less than %s drops\n* %.8f%% chance of getting more than %s drops\n* %.8f%% chance of getting %s drops or more.\n%s",
		kc, chanceTxt, 100 * chance, 100 * luck, obtained, 100 * luckLessThanObtained, obtained, 100 * chanceMoreThanObtained, obtained, 100 * luckObtainedOrMore, obtained, flavour)
end

return p