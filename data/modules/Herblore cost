			:wikitext(secondaryText, refs[secondaryRef])
		:done()
		:tag('td')
			:wikitext(coins(secondaryCost))
		:done()
		:tag('td')
			:wikitext(XP)
		:done()
		:tag('td')
			:wikitext(coins(profit))
		:done()
		:tag('td')
			:wikitext(coins(profit/XP))
		:done()
	:done()
end

return p
