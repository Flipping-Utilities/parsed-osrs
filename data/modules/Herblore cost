function makeTableRow(Table, refs, base, secondary, potion, Level, XP, usingGoggles, necklace, baseType, vialType)
	vialType = vialType or 'vial of water'
	local potionRef
	local baseRef
	local secondaryRef
	
	if baseType ~= 'unfinished' then
		if base == 'guam' or base == 'irit' then
			base = base .. ' leaf'
		end
		if base == 'ranarr' then
			base = base .. ' weed'
		end
		if baseType == 'grimy' then
			XP = XP + herbCleanXp[base]
			base = 'grimy ' .. base
		end
		if vialType ~= 'vial of water' then
			baseRef = vialType
		end
	else
		if vialType == 'coconut milk' then
			-- Potions with coconut milk base are untradeable in (unf) form so do not render them
			return
		end
		if vialType == 'vial of blood' then
			base = base .. ' blood'
		end
		base = base .. ' potion (unf)'
	end
	
	local costBase = gePrice(base)
	local costSecondary = gePrice(secondary)
	local costPotion = gePrice(potion .. '(4)', .75, false, 4, 0)
	if potion == 'Weapon poison' then
		costPotion = gePrice(potion)
	end
	
	local profit = costPotion - costBase - costSecondary
	
	if usingGoggles then
		profit = profit + (costSecondary / 9)	
	end
	
	if potion ~= 'Weapon posion' then
		if necklace == 'amulet of chemistry' then
			profit = profit + (costPotion / 3 * 0.05) - (gePrice('amulet of chemistry') / 5 * 0.05)
		end
		
		if necklace == 'alchemist\'s amulet' then
			profit = profit + (costPotion / 3 * 0.15) - (gePrice('amulet of chemistry') / 10 * 0.15)
		end
		
		if baseType ~= 'unfinished' then
			profit = profit - gePrice(vialType)
		end
	end
	
	writeRow(Table, refs, Level, 
		string.format('[[File:%s.png|%s]]', potion, potion), string.format('[[%s]]', potion:gsub("^%l", string.upper)), costPotion,
		string.format('[[File:%s.png|%s]]', base, base), string.format('[[%s]]', base:gsub("^%l", string.upper)), costBase,
		string.format('[[File:%s.png|%s]]', secondary, secondary), string.format('[[%s]]', secondary:gsub("^%l", string.upper)), costSecondary,
		XP, profit,
		potionRef, baseRef, secondaryRef)
end

function makeTableRowCompound(Table, refs, base, secondary, potion, Level, XP, usingGoggles, compoundDoses, secondaryQuantity)
	secondaryQuantity = secondaryQuantity or 1
	local potionRef
	local baseRef
	local secondaryRef
	local costBase = gePrice(base .. '(4)')
	local costSecondary = gePrice(secondary) * secondaryQuantity
	local costPotion = gePrice(potion .. '(4)', 1, false, 4, 0)
	
	if secondary == 'crushed superior dragon bones' then
		costSecondary = gePrice('superior dragon bones') + 50
		secondaryRef = 'superior dragon bones'
	end
	
	if secondaryQuantity > 1 then
		costBase = costBase / 4 * compoundDoses
		secondaryQuantity = secondaryQuantity / 4 * compoundDoses
		costSecondary = gePrice(secondary) * secondaryQuantity
		costPotion = costPotion / 4 * compoundDoses
		XP = XP / 4 * compoundDoses
		XP = math.floor(XP * 100 + 0.5) / 100
	end
	local profit = costPotion - costBase - costSecondary
	
	if usingGoggles then
		profit = profit + (costSecondary  / 9)
	end
	
	if compoundDoses < 4 then
		if necklace == 'amulet of chemistry' then
			profit = profit + (costPotion / compoundDoses * 0.05) - (gePrice('amulet of chemistry') / 5 * 0.05)
		end
		
		if necklace == 'alchemist\'s amulet' then
			profit = profit + (costPotion / compoundDoses * 0.15) - (gePrice('amulet of chemistry') / 10 * 0.15)
		end
	end
	
	local secondaryLabel = string.format('[[%s]]', secondary:gsub("^%l", string.upper))
	if secondaryQuantity > 1 then
		secondaryLabel = secondaryLabel .. string.format('(x%d)', secondaryQuantity)
	end
	
	writeRow(Table, refs, Level,
		string.format('[[File:%s.png|%s]]', potion, potion), string.format('[[%s]]', potion:gsub("^%l", string.upper)), costPotion,
		string.format('[[File:%s.png|%s]]', base, base), string.format('[[%s]]', base:gsub("^%l", string.upper)), costBase,
		string.format('[[File:%s.png|%s]]', secondary, secondary), secondaryLabel, costSecondary,
		XP, profit,
		potionRef, baseRef, secondaryRef)
end



function makeTableRowSuperCombat(Table, refs, usingGoggles)
	local costBase = gePrice('Super attack(4)') + gePrice('Super defence(4)') + gePrice('Super strength(4)')
	local costSecondary = gePrice('torstol')
	local costPotion = gePrice('Super combat potion(4)')
	local profit = costPotion - costBase - costSecondary
	
	if usingGoggles then
		profit = profit + (costSecondary  / 9)
	end
	
	writeRow(Table, refs, 90, 
		'[[File:Super combat potion.png|Super combat potion]]', '[[Super combat potion]]', costPotion,
		'[[File:super attack.png|super attack]]</br>[[File:super strength.png|super strength]]</br>[[File:super defence.png|super defence]]</br>', '[[Super strength]]</br>[[Super defence]]</br>[[Super attack]]', costBase,
		'[[File:torstol.png|torstol]]', '[[Torstol]]', costSecondary,
		150, profit)
end

