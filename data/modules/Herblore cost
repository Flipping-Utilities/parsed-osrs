function writeRow(Table, refs, level, potionIcon, potionText, potionCost, baseIcon, baseText, baseCost, secondaryIcon, secondaryText, secondaryCost, XP, profit, potionRef, baseRef, secondaryRef)
	Table:tag('tr')
		:tag('td')
			:wikitext(level)
		:done()
		:tag('td')
			:wikitext(potionIcon)
		:done()
		:tag('td')
			:wikitext(potionText, refs[potionRef])
		:done()
		:tag('td')
			:wikitext(coins(potionCost))
		:done()
		:tag('td')
			:wikitext(baseIcon)
		:done()
		:tag('td')
			:wikitext(baseText, refs[baseRef])
		:done()
		:tag('td')
			:wikitext(coins(baseCost))
		:done()
		:tag('td')
			:wikitext(secondaryIcon)
		:done()
