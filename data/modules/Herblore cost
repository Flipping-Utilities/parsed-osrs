function p.main(frame)
	local args = frame.args;
	mw.logObject(args)
	local usingGoggles = yesNo(args['usingGoggles'])
	local compoundDoses = tonumber(args['compoundDoses'])
	local necklace = args['necklace']
	local baseType = args['baseType']
	necklace = string.lower(necklace)
	baseType = string.lower(baseType)
	
	local refs = {}
	refs['profit'] = frame:extensionTag('ref', 'Profit assumes potions are bought and sold as 4 doses where applicable..', { name = 'profit'})
	refs['superior dragon bones'] = frame:extensionTag('ref', 'The price used is the one of [[superior dragon bones]] with the 50gp fee to have [[wesley]] crush them as crushed prices are highly inaccurate.', { name = 'superior dragon bones'})
	if baseType == 'grimy' then
		refs['vial of blood'] = frame:extensionTag('ref', 'This potion uses [[vial of blood]] instead of [[vial of water]] as a base.', { name = 'vial of blood'})
		refs['coconut milk'] = frame:extensionTag('ref', 'This potion uses [[coconut milk]] instead of [[vial of water]] as a base.', { name = 'coconut milk'})
	end
	if baseType == 'clean' then
		refs['vial of blood'] = frame:extensionTag('ref', 'This potion uses [[vial of blood]] instead of [[vial of water]] as a base.', { name = 'vial of blood'})
		refs['coconut milk'] = frame:extensionTag('ref', 'This potion uses [[coconut milk]] instead of [[vial of water]] as a base.', { name = 'coconut milk'})
	end
	
	local ret = makeTable( usingGoggles, necklace, baseType, compoundDoses, refs)
	
	return ret
end

