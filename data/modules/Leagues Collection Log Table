local function getData(category)
	local data = {}
	
	for idx, item in ipairs(itemData) do
		for _, tab in ipairs(item['tabs']) do
			if string.lower(tab) == string.lower(category) or string.lower(category) == 'all' then 
				table.insert(data, item)
				break
			end
		end
	end
	return data
end

local function getOverrides(itemId)
	-- Have a big map of overrides
	return overrides[itemId]
end

local function RegionLookup(data)
	local lookup = {}
	
	for _, item in ipairs(data) do
		local id = item.id
		local q = bucket('infobox_item')
			.select('league_region')
			.where('item_id', id)
			.run()
		
		for _, row in ipairs(q) do
			if row['league_region'] ~= nil and row['league_region'] ~= '' then
				lookup[item.id] = {
					raw = string.lower(row['league_region']),
					formatted = tb(row['league_region'])
				}
				break
			end
		end
	end
	
	return lookup
end

local function leagueRegionCell(itemId, lookup)
	local override = getOverrides(tonumber(itemId))
	if override ~= nil and override.league_region ~= nil then
		return { text = tb(override.league_region) }
	end

	local entry = lookup[tonumber(itemId)]
	if entry ~= nil and entry.formatted ~= nil and entry.formatted ~= "N/A" then
		return { text = entry.formatted }
	else
		return { text = "N/A", class = "table-na nohighlight" }
	end
end

local function makeTable(data, columns, regions)
	local clogTable = mw.html.create('table'):addClass('wikitable lighttable sortable qc-active collection-log tbrl-tasks autosort=3,a'):cssText('max-width: 800px')
	
	local columnValues = {}
	for _, v in ipairs(columns) do
		table.insert(columnValues, headers[v])
	end
	tables._row(clogTable:tag('tr'), columnValues, true)

	for _, v in ipairs(data) do
		local isClueJunk = false
		local tabs = {}
		for _, tab in ipairs(v.tabs) do
			local tabText = tabOverrides[tab] or string.format("[[%s]]", tab)
			table.insert(tabs, tabText)
			for _, clueTabName in ipairs(clueTabs) do
				if clueTabName == tab then
					isClueJunk = true
				end
			end
		end
		
		local override = getOverrides(v.id)
		local name = v.name
		if override ~= nil and override.name ~= nil then
			name = override.name
		end
		
		local text = string.format("[[%s]]", name)
		if override ~= nil and override.text ~= nil then
			text = override.text
		end

		local entry = regions[v.id]

		local regionRaw = (override ~= nil and override.league_region ~= nil)
			and string.lower(override.league_region)
			or (entry and entry.raw or '')
		
		local rowData = {
			item = string.format("[[File:%s.png]] %s", name, text),
			collection = table.concat(tabs, ', '),
			league_region = leagueRegionCell(v.id, regions)
		}

		local row = {}
		for _, column in ipairs(columns) do
			table.insert(row, rowData[column])
		end
		
		local htmlRow = clogTable:tag('tr')
			:attr('data-item-id', v.id)
			:attr('data-league-area-for-filtering', regionRaw)
		if isClueJunk then
			htmlRow:attr('data-item-clue-junk', 'true')
		end
		tables._row(htmlRow, row, false)
	end

	return clogTable
end

function p.list(frame)
	local args = frame:getParent().args
	return p._list(args['category'])
end

function p._list(category)
	local columns = {"item", "collection", "league_region"}
	local data = getData(category)
	local regions = RegionLookup(data)
	local rettbl = tostring(makeTable(data, columns, regions))
	return rettbl
end

return p