	local bounty = yesNo(paramTest.default_to(args.bounty, false), false) -- Bounty Hunter items
	local discontinued = yesNo(paramTest.default_to(args.discontinued, false), false) -- discontinued items
	local dmm = yesNo(paramTest.default_to(args.dmm, false), false) -- DeadMan Mode items
	local emir = yesNo(paramTest.default_to(args.emir, false), false) -- Emir's Arena items
	local failedPoll = yesNo(paramTest.default_to(args.failedpoll, false), false) -- items that failed polls
	local gauntlet = yesNo(paramTest.default_to(args.gauntlet, false), false) -- Gauntlet items
	local lms = yesNo(paramTest.default_to(args.lms, false), false) -- Last Man Standing items
	local quest = yesNo(paramTest.default_to(args.quest, true), true) -- quest items
	local future = yesNo(paramTest.default_to(args.future, false), false) -- future/unreleased items
	local allVariants = yesNo(paramTest.default_to(args.allVariants, true), true) -- equivalent variants of each item
	local uim = yesNo(paramTest.default_to(args.uim, false), false) -- UIM special items: shop buyable, STASH or POH storeable
	
	-- default to show only the very top 1 BIS item
	local topN = paramTest.default_to(args.topN, 1)
	-- if multiple items are tied, up to how many should be displayed?
	local maxN = args.maxN
	-- maximum overall number of rows to return
	local maxRows = paramTest.default_to(args.maxRows, 1)
	
	local bucket1 = "infobox_bonuses"
	local bucket2 = "infobox_item"
	local itemQuery = bucket("infobox_bonuses")
		.select("page_name", "page_name_sub", "equipment_slot", stat)
		.where("equipment_slot", slot)
		.orderBy(stat, "DESC")
		.join("infobox_item", "infobox_item.page_name_sub", "infobox_bonuses.page_name_sub")
	
	if members == "members" then
		itemQuery.where("infobox_item.is_members_only", "Yes")
	elseif members == "f2p" then
		itemQuery.where("infobox_item.is_members_only", "No")
	end
	
	if tradeable == "tradeable_only" then
		itemQuery.where("infobox_item.tradeable", "Yes")
	end
	
	if not quest then
		itemQuery.where("infobox_item.quest", "No")
	end
	
	local itemData = itemQuery.run()
	assert(data ~= nil and #data > 0, 'Bucket query failed')
	
	topNData = itemData.limit(topN)
	
	-- TODO: implement logic for including items with tied stats at the bottom of the list
	
	return itemData
end
	
