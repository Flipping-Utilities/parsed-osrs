local contains = require('Module:Array').contains

local slotOptions = {'head', 'cape', 'neck', 'ammo', 'weapon', 'shield', 'body', 'legs', 'hands', 'feet', 'ring', '2h'}
local statOptions = {'stab_attack_bonus', 'slash_attack_bonus', 'crush_attack_bonus', 'range_attack_bonus', 'magic_attack_bonus',
					'stab_defence_bonus', 'slash_defence_bonus', 'crush_defence_bonus', 'range_defence_bonus', 'magic_defence_bonus',
					'strength_bonus', 'ranged_strength_bonus', 'prayer_bonus', 'magic_damage_bonus'}
local memberOptions = {'all', 'f2p', 'members'}
local tradeableOptions = {'all', 'tradeable_only'}

function p.main(frame)
	local args = frame:getParent().args
	return p._main(args)
end

function p._main(args)
	local slot = string.lower(paramTest.default_to(args.slot, ''))
	assert(contains(slotOptions, slot), 'Invalid slot specified')
	local stat = string.lower(paramTest.default_to(args.stat, ''))
	assert(contains(statOptions, slot), 'Invalid stat specified')
	local members = string.lower(paramTest.default_to(args.members, 'all'))
	assert(contains(memberOptions, members), 'Invalid members status specified')
	local tradeable = string.lower(paramTest.default_to(args.tradeable, 'all'))
	assert(contains(tradeableOptions, tradeable), 'Invalid tradeability specified')
	
	-- if two items' stats are the same but one is tradeable, prefer that one
	local preferTradeable yesNo(paramTest.default_to(args.preferTradeable, false), false)
	
	-- might end up not implementing any of these for filtering
