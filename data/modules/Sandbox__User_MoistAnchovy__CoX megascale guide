function p._olm_max_hit (scale)
	local stats = p._get_monster_stats_scaled('olm_head', scale)
	local max_roll = math.floor((stats['magic_level'] + 14) / 10)
	local adjustment = math.min(6, math.floor(scale/8))
	return {
		normal = math.floor((100 + adjustment)*(max_roll/100)),
		crippled = math.floor((105 + adjustment)*(max_roll/100)),
		enraged = math.floor((108 + adjustment)*(max_roll/100)),
		head = math.floor((112 + adjustment)*(max_roll/100))
	}
end

