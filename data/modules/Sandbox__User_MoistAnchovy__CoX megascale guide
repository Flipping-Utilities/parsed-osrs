function p._fastest_possible_raid_pretty (scale, team_size)
	local time = math.floor(p._fastest_possible_raid(scale, team_size))
	local hours = math.floor(time / 3600)
	time = time - hours * 3600
	local minutes = math.floor(time / 60)
	time = time - minutes * 60
	local seconds = time

	local pretty_output = ""
	if hours > 0 then
		pretty_output = pretty_output .. hours .. "h"	
	end
	if minutes > 0 then
		pretty_output = pretty_output .. minutes .. "m"	
	end
	
	return pretty_output
end

function p._minimum_number_of_brews_for_olm (scale, team_size)
	-- Includes interphase time and ignores runners being hit
	local time_in_olm = p._fastest_possible_olm(scale, team_size)
	local attacks_taken = time_in_olm / (0.6 * 8)
	
	-- Making wild assumptions assuming
	-- 10% are replaced with prayer orbs and 10% are phase specific attacks
	local damage_per_auto = (1 - 0.2) * p._olm_average_damage_per_auto(scale)
	local damage_in_olm = attacks_taken * damage_per_auto
	
	local hp_per_xerics_aid = 19 * 4
	
	return math.ceil(damage_in_olm / hp_per_xerics_aid)
end

function p._brews_brought_into_olm (scale, team_size)
	return 3.75 * p._minimum_number_of_brews_for_olm(scale, team_size)
end

function p._dropoffs_suggested_for_olm (scale, team_size)
	local brews_needed = p._brews_brought_into_olm(scale, team_size)
	
	if team_size < 3 then
		brews_needed = brews_needed - team_size * 15 -- 15 per tank
	else
		brews_needed = brews_needed - ((team_size - 2) * 6 + 2 * 15) -- 6 per runner
	end

	return math.ceil(brews_needed / 20)
end

function p._get_prep_information (scale, team_size)
	local dropoffs = p._dropoffs_suggested_for_olm(scale, team_size)
	
	local restores_used = p._ceil_10(dropoffs * 8 + team_size * 4)
	local brews_used = p._ceil_10(p._brews_brought_into_olm(scale, team_size))
	local enhances_used = p._ceil_10(p._fastest_possible_olm(scale, team_size) * (team_size / (300 * 4)) + team_size)
	local overloads_used = p._ceil_10(p._potion_sip_cap(scale) / 4)
	
	local vials = p._ceil_100(restores_used + brews_used + enhances_used + 3 * overloads_used)
	
	local buchu = restores_used + brews_used + enhances_used
	local golpar = 3 * overloads_used
	local noxifer = overloads_used
	
	local juice = p._ceil_100(brews_used + overloads_used)
	local mushroom = p._ceil_100(restores_used + overloads_used)
	local cicely = p._ceil_100(enhances_used + overloads_used)
	
	return {
		restores = restores_used,
		brews = brews_used,
		enhances = enhances_used,
		overloads = overloads_used,
		
		vials = vials,
		buchu = buchu,
		golpar = golpar,
		noxifer = noxifer,
		
		juice = juice,
		mushroom = mushroom,
		cicely = cicely
	}
end

