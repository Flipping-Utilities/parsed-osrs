-- PecanBread11 did a lot of work and olm switching is basically this
-- Olm has an 80% chance to switch styles on Auto1, Auto2 and Special. NOT THE NULL
-- This means that Mage tank faces 1 switch between every auto (Auto1)
-- Melee tank faces 2 switches between every auto (Auto2 and Special)
-- When in 4:1 or 3:1 you face 3 switches between every auto
-- The multi-switching nature means it is closer to a 50/50 chance which auto
-- olm does which we can abuse because torva is very (ranged) tanky.
function p._olm_auto_expected_damage (max_hit, olm_chance_to_stay, range_hit_chance, mage_hit_chance)
	local on_prayer_max = math.floor(max_hit / 4) -- I'm not sure if this is the true max but I believe it
	local olm_chance_to_switch = 1 - olm_chance_to_stay

	function n (same_style_hit_chance, other_style_hit_chance)
		local expected_damage_if_no_prayer_switch = 0
			+ olm_chance_to_stay * same_style_hit_chance * (on_prayer_max / 2) -- Correct Guess
			+ olm_chance_to_switch * other_style_hit_chance * (max_hit / 2)
			
		local expected_damage_if_prayer_switch = 0
			+ olm_chance_to_stay * same_style_hit_chance * (max_hit / 2) -- Incorrect Guess
			+ olm_chance_to_switch * other_style_hit_chance * (on_prayer_max / 2)
			
		if expected_damage_if_no_prayer_switch < expected_damage_if_prayer_switch then
			return {true, expected_damage_if_no_prayer_switch}
		else
			return {false, expected_damage_if_prayer_switch}
		end
	end
	
	local last_auto_was_range = n(range_hit_chance, mage_hit_chance)
	local last_auto_was_mage = n(mage_hit_chance, range_hit_chance)

	return {
		expected_damage = (last_auto_was_range[2] + last_auto_was_mage[2]) / 2,
		should_swap_if_last_was_range = last_auto_was_range[1],
		should_swap_if_last_was_mage = last_auto_was_mage[1]
	}
end

function p._olm_attack_against_melee (max_hit, attack_roll)
	local olm_chance_to_stay = 0.8^2 + 0.2^2 -- (switch switch + stay stay)

	local equipment_defence_vs_range = 323
	local range_defence_roll = ((99+21)*(1.25)+8)*(equipment_defence_vs_range+64)
	local range_hit_chance = p._hit_chance(attack_roll, range_defence_roll)	

	local equipment_defence_vs_mage = 0
	local mage_defence_roll = ((99+21)*(1+0.25*0.3)+2)*(equipment_defence_vs_mage+64)
	local mage_hit_chance = p._hit_chance(attack_roll, mage_defence_roll)

	return p._olm_auto_expected_damage(max_hit, olm_chance_to_stay, range_hit_chance, mage_hit_chance)
end

function p._olm_attack_against_mage (max_hit, attack_roll)
	local olm_chance_to_stay = 0.8

	local equipment_defence_vs_range = 15
	local range_defence_roll = ((99+21)*(1.25)+8)*(equipment_defence_vs_range+64)
	local range_hit_chance = p._hit_chance(attack_roll, range_defence_roll)	

	local equipment_defence_vs_mage = 103
	local mage_defence_roll = ((99+21)*(1.25)+2)*(equipment_defence_vs_mage+64)
	local mage_hit_chance = p._hit_chance(attack_roll, mage_defence_roll)

	return p._olm_auto_expected_damage(max_hit, olm_chance_to_stay, range_hit_chance, mage_hit_chance)
end

function p._olm_average_damage_per_auto (scale)
	local max_hit = p._olm_max_hit(scale)['normal']
	local attack_roll = p._olm_accuracy_roll(scale)
	
	local melee_damage = p._olm_attack_against_melee(max_hit, attack_roll)['expected_damage']
	local mage_damage = p._olm_attack_against_mage(max_hit, attack_roll)['expected_damage']
	
	return (melee_damage + mage_damage) / 2
end

-- Points for damage dealt work non-trivially. You get full points per damage
-- dealt above 50% hp, and then it starts decreasing linearly towards 0.
-- Let the points available start out at PA=HP*5. For every hit, the amount of
-- points rewarded PR = IF DMG>0 THEN max(1, min(DMG*5, PA*DMG/(HP/2))} ELSE 0
-- After every hit, update PA=PA-PR. This comes out between 4.2 and 4.4 pts/dmg
-- PecanBread11
function p._points_from_dealing_damage (hp)
	return 4.15 * hp -- Other calculators use 4.15 as their static multiplier
end

