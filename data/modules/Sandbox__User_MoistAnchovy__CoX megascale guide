-- Ignores accuracy. Assumes that you are soulflame-horning everything (you should)
function p._number_of_effective_hammers (defence)
	local i = 0
	while defence * 0.3 >= avg_bgs_hit do
		defence = defence * (1-0.3)
		i = i + 1
	end
	return i
end

function p._guardian_specs_to_chicken_row (scale)
	local stats = p._get_monster_stats_scaled('guardian', scale)
	local hammer_hits = p._number_of_effective_hammers(stats['defence_level'])
	local bgs_hits = math.ceil( (stats['defence_level']*(1-0.3)^hammer_hits + stats['strength_level']) / avg_bgs_hit )
	
	return "| " .. scale .. " || " .. hammer_hits .. " || " .. bgs_hits
end

