function p._fastest_possible_olm_hand_phase (scale, team_size)
	local melee_dps = p._max_dps_vs_olm_melee()
	local mage_dps = p._max_dps_vs_olm_mage(scale, 50, true)
	local average_hand_dps = p._harmonic_mean(melee_dps, mage_dps)
	local team_hand_dps = team_size * average_hand_dps
	
	local hand_hp = p._get_monster_stats_scaled('olm_melee', scale)['hitpoints']
	local phase_time = (2 * hand_hp) / team_hand_dps
	
	return phase_time
end

function p._fastest_possible_olm (scale, team_size)
	local num_phases = p._number_of_olm_phases(scale)
	local phase_time = p._fastest_possible_olm_hand_phase(scale, team_size)
	local hand_time = num_phases * phase_time + (num_phases - 1) * 24 -- 24s interphase adjustment
	
	local head_hp = p._get_monster_stats_scaled('olm_head', scale)['hitpoints']
	local head_time = head_hp / (team_size * p._max_dps_vs_olm_head())
	
	return hand_time + head_time
end

function p._fastest_possible_guardians (scale, team_size)
	local hp = p._get_monster_stats_scaled('guardian', scale)['hitpoints']
	return (2 * hp) / (team_size * p._max_dps_vs_guardians())
end

function p._fastest_possible_mystics (scale, team_size)
	local hp = p._get_monster_stats_scaled('mystic', scale)['hitpoints']
	return (hp / (team_size * p._max_dps_with_chinchompas())) + 90 -- 90s is the fastest I've heard mystics setup
end

function p._fastest_possible_shamans (scale, team_size)
	local hp = p._get_monster_stats_scaled('shaman', scale)['hitpoints']	
	return (hp / (team_size * p._max_dps_with_chinchompas())) + 30 -- Shot in the dark at setup time
end

function p._fastest_possible_tightrope (scale, team_size)
	local hp = p._get_monster_stats_scaled('rope_ranger', scale)['hitpoints']	
	return (2 * hp) / (team_size * p._max_dps_with_chinchompas())
end

