function p._max_dps_vs_olm_mage (scale, eye_damage, accursed_sceptre)
	local stats = p._get_monster_stats_scaled('olm_mage', scale)
	stats['magic_defence_bonus'] = stats['magic_defence_bonus'] - eye_damage
	if accursed_sceptre then
		stats['magic_level'] = math.floor(0.85 * stats['magic_level'])
	end
	
	local defence_roll = (9 + stats['magic_level']) * (stats['magic_defence_bonus'] + 64)
	return p._simple_dps(5, 75, 94605, defence_roll)
end

