function p._floor_1k (n)
	return math.floor(n / 1000) * 1000	
end

function p._floor_100 (n) return math.floor(n / 100) * 100 end
function p._ceil_100 (n) return math.ceil(n / 100) * 100 end

function p._floor_10 (n) return math.floor(n / 10) * 10 end
function p._ceil_10 (n) return math.ceil(n / 10) * 10 end

-- There is some nuance not captured here but this works for megas.
-- Technically guardians are calculated with more HP than they should. Their HP
-- decreases as average party mining level decreases.
-- TODO olm may have special scaling. Notable for mage level of mage hand (should be lower)
function p._scale_stats (stats, scale)
	if stats['page_name'] == 'Great Olm' then
		local hp_scaling = (scale - 3*math.floor(scale/8) + 1) / 2
		stats['hitpoints'] = math.floor(stats['hitpoints'] * hp_scaling)
		if string.find(stats['page_name_sub'], 'claw') then
			stats['hitpoints'] = math.min(10200, stats['hitpoints'])	
		else -- must be head
			stats['hitpoints'] = math.min(13600, stats['hitpoints'])
		end
	else 
		local hp_scaling = 1 + math.floor(scale/2)
		stats['hitpoints'] = math.floor(stats['hitpoints'] * hp_scaling)
	end
	
	local offence_scaling = (7*math.floor(math.sqrt(scale-1)) + (scale-1) + 100)/100
	stats['attack_level'] = math.floor(stats['attack_level'] * offence_scaling)
	stats['strength_level'] = math.floor(stats['strength_level'] * offence_scaling)
	stats['ranged_level'] = math.floor(stats['ranged_level'] * offence_scaling)
	stats['magic_level'] = math.floor(stats['magic_level'] * offence_scaling)
	
	local defence_scaling = (math.floor(math.sqrt(scale-1)) + math.floor((scale-1)*7/10) + 100)/100
	stats['defence_level'] = math.floor(stats['defence_level'] * defence_scaling)
	
	return stats
end

function p._get_monster_stats_full (name, sub_name)
	return bucket('infobox_monster')
		.where({'page_name', name}, {'page_name_sub', sub_name})
		.select('page_name', 'page_name_sub')
		.select('hitpoints', 'attack_level', 'strength_level', 'ranged_level', 'magic_level', 'defence_level')
		.select('slash_defence_bonus', 'slash_defence_bonus', 'crush_defence_bonus')
		.select('light_range_defence_bonus', 'standard_range_defence_bonus', 'heavy_range_defence_bonus')
		.select('magic_defence_bonus')
		.select('magic_attack_bonus', 'range_attack_bonus')
		.run()
		[1]
end

function p._get_monster_stats (name)
	local full_name = {}
	if name == 'guardian' then
		full_name = {'Guardian (Chambers of Xeric)', 'Guardian (Chambers of Xeric)#Normal'}
	elseif name == 'mystic' then
		full_name = {'Skeletal Mystic', 'Skeletal Mystic#Normal'}
	elseif name == 'shaman' then
		full_name = {'Lizardman shaman (Chambers of Xeric)', 'Lizardman shaman (Chambers of Xeric)#Normal'}
	elseif name == 'olm_mage' then
		full_name = {'Great Olm', 'Great Olm#Right claw (Normal)'}
	elseif name == 'olm_melee' then
		full_name = {'Great Olm', 'Great Olm#Left claw (Normal)'}
	elseif name == 'olm_head' then
		full_name = {'Great Olm', 'Great Olm#Head (Normal)'}
	elseif name == 'rope_ranger' then
		full_name = {'Deathly ranger', 'Deathly ranger#Normal'}
	elseif name == 'rope_mager' then
		full_name = {'Deathly mage', 'Deathly mage#Normal'}
	elseif name == 'ice_demon' then
		full_name = {'Ice demon', 'Ice demon#Normal'}
	else
		error('Bad monster name')
	end
	return p._get_monster_stats_full(full_name[1], full_name[2])
end

function p._get_monster_stats_scaled (name, scale)
	return p._scale_stats(p._get_monster_stats(name), scale)
end

-- https://en.wikipedia.org/wiki/Harmonic_mean
function p._harmonic_mean (...)
	local count = 0
	local sum = 0
	for i, v in ipairs(arg) do
		count = i
		sum = sum + (1 / v)
	end
	return count / sum
end

function p._hit_chance (attack_roll, defence_roll)
	if attack_roll > defence_roll then
		return 1 - (defence_roll + 2) / (2 * (attack_roll + 1))	
	else
		return attack_roll / (2 * (defence_roll + 1))	
	end
end

-- I use this sheet for the DPS vs a variety of targets. This is my "max gear"
-- https://dps.osrs.wiki?id=ZoneRingDiplomacy

-- Max hit can be found from a variety of places.
-- https://oldschool.runescape.wiki/w/Maximum_magic_hit
-- https://oldschool.runescape.wiki/w/Maximum_melee_hit
-- https://oldschool.runescape.wiki/w/Maximum_ranged_hit
function p._simple_damage_per_attack (max_hit, attack_roll, defence_roll)
	return p._hit_chance(attack_roll, defence_roll) * ((max_hit / 2) + (1 / (max_hit + 1)))
end

function p._simple_dps (weapon_delay, max_hit, attack_roll, defence_roll)
	return (p._simple_damage_per_attack(max_hit, attack_roll, defence_roll) / (0.6 * weapon_delay))
end

