        :setDimensions( '10vw', '10vh', 300, 300, true )
        :setTitle( 'Custom color pallet' )
    plot.options.colorPallet = {
        chart.rgba.new( 0, 0, 0 ),
        chart.rgba.new( 126, 0, 0 ),
        chart.rgba.new( 0, 126, 0 ),
        chart.rgba.new( 0, 0, 126 ),
