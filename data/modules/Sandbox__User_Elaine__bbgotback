local function getTotalWeightAtLevel(level)
  local totalWeight = 0
  for _, potion in pairs(potions) do
    if potion.level <= level then
      totalWeight = totalWeight + potion.weight
    end
  end
  return totalWeight
end


function getAveragesAtLevel(level)
  local totalWeight = getTotalWeightAtLevel(level)
  local weightedXp = 0
  local weightedResin = {Aga = 0, Mox = 0, Lye = 0}
  local weightedPaste = {Aga = 0, Mox = 0, Lye = 0}
  
  for _, potion in pairs(potions) do
    if potion.level <= level then
      local weight = potion.weight
      
      weightedXp = weightedXp + (weight * potion.xp)
      weightedResin.Aga = weightedResin.Aga + (weight * potion.resin.Aga)
      weightedResin.Mox = weightedResin.Mox + (weight * potion.resin.Mox)
      weightedResin.Lye = weightedResin.Lye + (weight * potion.resin.Lye)
      weightedPaste.Aga = weightedPaste.Aga + (weight * potion.paste.Aga)
      weightedPaste.Mox = weightedPaste.Mox + (weight * potion.paste.Mox)
      weightedPaste.Lye = weightedPaste.Lye + (weight * potion.paste.Lye)
    end
  end
  
  return {
    xp = weightedXp / totalWeight,
    resin = {
      Aga = weightedResin.Aga / totalWeight,
      Mox = weightedResin.Mox / totalWeight,
      Lye = weightedResin.Lye / totalWeight
    },
    paste = {
      Aga = weightedPaste.Aga / totalWeight,
      Mox = weightedPaste.Mox / totalWeight,
      Lye = weightedPaste.Lye / totalWeight
    }
  }
end

local function nextPotionThresholdXP(currentXP)
  local currentLevel = levelatxp(currentXP)
  local potionLevels = {60, 63, 66, 69, 72, 75, 78, 81}
  
  for _, level in ipairs(potionLevels) do
    if level > currentLevel then
      return xpatlevel(level)
    end
  end
  
  return nil
end

local thresholdGoal = 0
local nextThreshold = nextPotionThresholdXP(currentXP)

if nextThreshold and xpGoal > nextThreshold then
    thresholdGoal = nextThreshold
else
    thresholdGoal = xpGoal
end

local actionsRequired = 0
if args.Goal_Select == 'Points' then
    local currentLevel = levelatxp(currentXP)
    local averages = getAveragesAtLevel(currentLevel)
    local agaActions = resinGoal.Aga / averages.resin.Aga or 0
    local moxActions = resinGoal.Mox / averages.resin.Mox or 0
    local lyeActions = resinGoal.Lye / averages.resin.Lye or 0
    actionsRequired = math.max(agaActions, moxActions, lyeActions)
else
    local xpNeeded = thresholdGoal - currentXP
    if xpNeeded > 0 then
        local currentLevel = levelatxp(currentXP)
        local averages = getAveragesAtLevel(currentLevel)
        actionsRequired = xpNeeded / averages.xp
    end
end

return p