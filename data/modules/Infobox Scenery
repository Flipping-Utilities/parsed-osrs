	end
	
	if ret:paramDefined('location', 'all') then
		ret:addRow{
			{ tag = 'th', content = '[[Locations|Location]]', colspan = '8' },
			{ tag = 'argd', content = 'location', colspan = '12' }
		}
	end
	
	if ret:paramDefined('leagueRegion', 'all') then
		ret:addRow{
