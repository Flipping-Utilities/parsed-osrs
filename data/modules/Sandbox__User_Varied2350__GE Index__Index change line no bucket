function parseArgs(args)
	local parsedArgs = {}
	local basePrices = {}
	local dateOrder = {}
	
	local lastData = {}
	for argIdx = 1, 50, 1 do
		local changeDate = args['date'..argIdx]
		local changeItemsStr = args['date'..argIdx..'items']
		
		if not changeDate then
			mw.log('No date for arg index ' .. argIdx)
			break
		end
		
		dateOrder[argIdx] = changeDate
		
		parsedArgs[changeDate] = {}
		
		
		local changeItems = {}
		local currPrices = {}
		changeItems['add'] = {}
		changeItems['rem'] = {}
		local tmpIdx = 1
		local tmpItem = ''
		local tmpPrice = 0
		local qty = 0
		local newQty = 0
		for str in string.gmatch(changeItemsStr, "([^,]+)") do
			if tmpIdx % 2 == 1 then
				tmpItem = str
			else
				local isRemove = string.find(tmpItem, "^-")
				local listStr = string.find(tmpItem, "^-") and "rem" or "add"
				tmpItem = string.gsub(tmpItem, "%-", "")
				tmpPrice = tonumber(str)
				if not basePrices[tmpItem] then
					basePrices[tmpItem] = tmpPrice
					qty = qty + 1
				end
				currPrices[tmpItem] = tmpPrice
				local basePrice = basePrices[tmpItem] or tmpPrice
				
				changeItems[listStr][tmpItem] = {['price'] = tmpPrice, ['baseprice'] = basePrice}
			end
			tmpIdx = tmpIdx + 1
		end
		parsedArgs[changeDate]['items'] = changeItems
		
		if argIdx == 1 then
			-- the first divisor is just the quantity
			parsedArgs[changeDate]['divisor'] = qty
		else
			local priorRatioSum = 0.0
			for k,v in pairs(lastData['items']['add']) do
				local basePrice = basePrices[k]
				local currPrice = currPrices[k]
				priorRatioSum = priorRatioSum + currPrice / basePrice
			end
			local removedRatioSum = 0.0
			for k,v in pairs(parsedArgs[changeDate]['items']['rem']) do
				removedRatioSum = removedRatioSum + currPrice[k] / basePrice[k]
			end
			
			local newDivisor = lastData['divisor'] * ((priorRatioSum - removedRatioSum + qty)/priorRatioSum)
			parsedArgs[changeDate]['divisor'] = roundToDecimal(newDivisor, 4)
		end
		
		lastData = parsedArgs[changeDate]
	end
	return dateOrder, parsedArgs
end

function roundToDecimal(num, decimalPlaces)
	local multiple = 10 ^ decimalPlaces
	return math.floor(num * multiple + 0.5) / multiple
end

