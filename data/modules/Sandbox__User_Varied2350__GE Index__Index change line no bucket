local p = {}

function p.main(frame)
	local args = frame:getParent().args
	return p._main(args)
end

function p._main(args)
	local dateOrder, parsedArgs = parseArgs(args)
	return render(args['render'], parsedArgs, dateOrder)
end

function render(renderType, data, dateOrder)
	if renderType == 'Table' then
		local rows = mw.html.create()
		for i,chgDate in ipairs(dateOrder) do
			local chgData = data[chgDate]
			local maxNum = math.max(count(chgData['items']['add']), count(chgData['items']['rem']))
			for itemIdx = 1, maxNum, 1 do
				local row = rows:tag('tr')
				if itemIdx == 1 then
					row:tag('td'):attr('rowspan', maxNum):wikitext(chgDate)
				end
				
				local k, v = getAtIndex(chgData['items']['add'], itemIdx)
				if count(chgData['items']['add']) >= itemIdx then
					row:tag('td'):wikitext(k)
				elseif count(chgData['items']['add']) == itemIdx - 1 then
					row:tag('td'):attr('rowspan', maxNum-itemIdx+1):wikitext('N/A')
				end
				row:tag('td'):wikitext(v['price'])
				if count(chgData['items']['rem']) >= itemIdx then
					row:tag('td'):attr('rowspan', maxNum-itemIdx):wikitext('N/A')
				elseif count(chgData['items']['rem']) == itemIdx - 1 then
					row:tag('td'):attr('rowspan', maxNum-itemIdx+1):wikitext('N/A')
				end
			end
		end
		return rows
	end
end

function count(dict)
	local count = 0
	for _ in pairs(dict) do count = count + 1 end
	return count
end

