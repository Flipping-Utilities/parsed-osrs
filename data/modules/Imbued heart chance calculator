local caTierArray = {
	['Hard-'] = 0,
	['Elite+'] = 1
}

function p.buildTable(chancesArray)
	local ret = mw.html.create('table')
	    :addClass('wikitable align-center-1')
	    :addClass('wikitable sortable')
	    :done()
		ret:tag('tr'):tag('th'):wikitext( 'Monster'):done()
			:tag('th'):wikitext('Rate of Imbued heart'):done()
	
	local total = 0
	for i, chance in ipairs(chancesArray) do
		local row = mw.html.create('tr')
		    :tag('th')
		    :wikitext(chance[1])
		    :done()
		    :tag('td')
		    :wikitext(string.format("%.2f", 100*chance[2] ) .. "%")
		    :done()
		total = total + chance[2]
		ret:node(row)
	end
	local total_row = mw.html.create('tr'):tag('th'):wikitext('Total'):done()
		:tag('td'):wikitext(string.format("%.2f", 100*total ) .. "%"):done()
	ret:node(total_row)
	
	return ret
end

function p.calcChance(chance, kills, caTier)
	local caModifier = 200
	if caTier == 0 then
		caModifier = 200
	elseif caTier == 1 then 
		caModifier = 150
	end
		
	local heartChancePerKill = 1/chance * 1/caModifier
	local ret = kills * heartChancePerKill
	return ret
end

function p._main(args)
	local bigTable = {}
	for i, superiorArray in ipairs(superiorRate) do
		local smallTable = {superiorArray.monster}
		table.insert(smallTable, p.calcChance(superiorArray.chance, args[superiorArray.variableName], caTierArray[args.caTier]))
		table.insert(bigTable, smallTable)
	end
	return p.buildTable(bigTable)
end

function p.main(frame)
	local args = frame:getParent().args
	return p._main(args)
end

return p