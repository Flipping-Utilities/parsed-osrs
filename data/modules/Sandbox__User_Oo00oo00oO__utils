		nil,
		"2244",
	}
	for i,v in pairs(expectedFalse) do
		local s,r = pcall(p.isfinite, v)
		assert(s==true and r==false, 'got ' .. tostring(r) .. ', expected false when testing value ' .. tostring(v) .. ' ar index #' .. tostring(i))
	end
	local expectedTrue = {
		0,
		1,
		2,
