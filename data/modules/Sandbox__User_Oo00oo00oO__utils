p.debug.LOG_LEVEL = {
	FATAL    = -math.huge,
	ERR      = 10,
	ERROR    = 10,
	WARN     = 20,
	WARNING  = 20,
	INFO     = 30,
	DEBUG    = 30,
	VERBOSE  = 50,
	TRACE    = 60,
	ALL      = math.huge,
	LOG      = math.huge,
}

--[[ CONFIG: currently holds default values ]]--
p.debug.config = {
	LOG = {
		-- LOGGING LEVEL --
		LEVEL = p.debug.getExecInfo().activePageIsRoot and p.debug.LOG_LEVEL.ALL or p.debug.LOG_LEVEL.ERROR, --[[ (number): print at or below this level, DEFAULTS to ALL if running inside script editor, otherwise it will default to ERROR ]]
		-- LOG MESSAGE WITH TIMESTAMP --
