function invocable.RuneRunProfit(frame)
	local rune = frame.args[1]
	local multiplier = frame.args[2]
	local level = 75
	local totalEssense = 27
	if (level < 25) then
		totalEssense = totalEssense + 0
	elseif (level < 50 ) then
		totalEssense = totalEssense + 8
	elseif (level < 75 ) then
		totalEssense = totalEssense + 16
	elseif (level < 85 ) then
		totalEssense = totalEssense + 27
	else
		totalEssense = totalEssense + 40
	end
	
	local valueOfCraftedRunes = GEPrice(rune, totalEssense * multiplier * 1.6)
	local valueOfPureEssenses = GEPrice("pure essence", totalEssense)
	local costOfGloryTeleport = (GEPrice("amulet of glory(4)") - GEPrice("amulet of glory")) * 1/4
	local costOfStaminaPotion = GEPrice("Stamina potion(3)") * 1/3 * 2/5
	
	return valueOfCraftedRunes - math.floor(valueOfPureEssenses - costOfGloryTeleport - costOfStaminaPotion)
end

return invocable