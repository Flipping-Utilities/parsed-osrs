local Exchange = require("Module:Exchange");

function GEPrice(item, amount)
   return Exchange._price(item, amount)
end

function ternary(cond ,T ,F)
    if cond then return T else return F end
end

function invocable.KingdomMostProfitable(frame)
	local bestOption = getKingdomBestOption()
	return bestOption.option1
end

function invocable.KingdomSecondMostProfitable(frame)
	local bestOption = getKingdomBestOption()
	return bestOption.option2
end

function invocable.KingdomProfit(frame)
	local bestOption = getKingdomBestOption()
	return math.floor(bestOption.profit)
end

function getKingdomBestOption()
	local options = getKingdomOptions()
	
	local bestOption = {}
	
	bestOption.profit = 0;
	
	for k1, v1 in pairs(options) do
		for k2, v2 in pairs(options) do
			if k1 ~= k2 and v1 + v2 * 0.5 > bestOption.profit then
				bestOption.profit = v1 + v2 * 0.5
				bestOption.option1 = k1
				bestOption.option2 = k2
			end
		end
	end
	
	return bestOption
end

