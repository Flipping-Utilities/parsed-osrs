local p = {}

local skillPic = require('Module:SCP')._main

function p.invoke_main(frame)
	return p.main(frame:getParent().args)
end

function p.main(args)
	local hunterLvl = tonumber(args.HunterLevel_Input)
	local master = args.master
	
	local unlocked_lists = {}
	if(args.leaguesRegions == 'true') then
		unlocked_lists = { Varlamore = true }
		for entry in string.gmatch(args.regionOptions, '([^,]+)') do
		    unlocked_lists[entry] = true
		end
	else
		unlocked_lists = "All"
	end

	local active_tasks = {}
	if(args.blockList == 'true') then
		active_tasks[args.gilman] = true
		active_tasks[args.cervus] = true
		active_tasks[args.ornus] = true
		active_tasks[args.aco] = true
		active_tasks[args.teco] = true
		active_tasks[args.wolf] = true
	end

	local matched_tasks = get_available_tasks(master, hunterLvl, unlocked_lists, active_tasks)
	
	local chance = (1 / #matched_tasks) --this is dirty but i'll add weighting later lol--
	
	local wikitable = mw.html.create('table'):addClass('wikitable sortable align-center-1 align-center-2 align-center-4'):done()
		wikitable:tag('tr'):tag('th'):wikitext(skillPic('Hunter') .. ' Level'):done()
			:tag('th'):attr('colspan', 2):wikitext('Creature'):done()
			:tag('th'):wikitext('Chance'):done()
			
	for _, task in pairs(matched_tasks) do
	wikitable:tag('tr'):done()
    	:tag('td'):wikitext(task.level):done()
    	:tag('td'):wikitext('[[File:' .. task.creature .. ' icon.png]]'):done()
    	:tag('td'):wikitext('[[' .. task.creature .. ']]'):done()
    	:tag('td'):wikitext(tonumber(string.format("%.2f", chance * 100)) .. '%'):done()
	end
	
	return wikitable
end

