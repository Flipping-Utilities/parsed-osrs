function get_available_tasks(active_master, player_level, unlocked_lists, active_tasks)
	local unlocked_creatures = {}
	if(unlocked_lists ~= "All") then
		for regionName, enabled in pairs(unlocked_lists) do
		    if (enabled) then
	    		for _, creature in pairs(lists[regionName]) do
		    		unlocked_creatures[creature] = true
		    	end
			end
		end
	end
	local good_tasks = {}
	for _, task in pairs(masters[active_master]) do
		if ((unlocked_lists == "All" or unlocked_creatures[task.creature]) and
			player_level >= task.level and not active_tasks[task.creature]) then
			table.insert(good_tasks, task)
		end
	end
	return good_tasks
end

