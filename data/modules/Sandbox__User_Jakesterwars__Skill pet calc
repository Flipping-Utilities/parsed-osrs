function p.main(frame)
	local args = frame:getParent().args
	local level = args.level
	local pet = args.pet
	local actionsPerHour = args.actionsPerHour or 1
	local petData = pets[pet]
	
	local ret = mw.html.create('table'):addClass('wikitable sortable sticky-header align-center-2 align-center-3')
	ret:tag('tr')
		:tag('th'):wikitext('Method')
		:tag('th'):wikitext('Chance per action')
		:tag('th'):wikitext('Chance per hour<br />with APH')
	
	for i, v in next, petData, nil do
		ret:node(make_row(v, i, level, actionsPerHour))
	end
	
	return tostring(ret)
end

function make_row(data, method, level, actionsPerHour)
	local doNotCalculate = ({ Minnow = true, ['Fishing Trawler'] = true })[method]
	local trawlerActionsCheck = method == 'Fishing Trawler' and tonumber(actionsPerHour) > 6 and 6 or actionsPerHour
	local chancePerAction = doNotCalculate and data or tonumber(data) - (tonumber(level) * 25)
	local chancePerHour = helpers.jagexFloor(chancePerAction / trawlerActionsCheck, 2)
	
	return mw.html.create('tr')
		:tag('td'):wikitext(method):done()
		:tag('td'):wikitext('1/' .. commas(chancePerAction)):done()
		:tag('td'):wikitext('1/' .. commas(chancePerHour)):done()
end

return p