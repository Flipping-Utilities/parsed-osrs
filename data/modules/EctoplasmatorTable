local p = {}

-- Formats a table header
function p.header(tbl)
    local tr = tbl:tag('tr')
        :tag('th'):attr('colspan', '2'):wikitext('Monster'):done()
        :tag('th'):wikitext('Members'):done()
        :tag('th'):wikitext('[[File:Attack style icon.png|link=|Combat level]] Lvl'):done()
        :tag('th'):wikitext('[[File:Hitpoints icon.png|link=|Hitpoints]] HP'):done()
        :tag('th'):wikitext('[[File:Prayer icon.png|link=|Prayer XP]] XP'):done()
end

-- Main entrypoint
function p.main(frame)
    local args = frame:getParent().args
    return p._main(args)
end

function p._main(args)
    -- Gather the data
    local data = bucket('infobox_monster')
		.select('name', 'image', 'is_members_only', 'combat_level', 'hitpoints')
		.where('attribute', 'spectral')
		.where(bucket.Not('Category:Discontinued content'))
		.where(bucket.Not('Category:Pages using information from game APIs or cache'))
		.orderBy('name', 'ASC')
		.run()

    -- Format the output page
    local div = mw.html.create('div')
    local tbl = div:tag('table'):addClass('wikitable sortable')
        :addClass('align-center-1 align-left-2 align-left-3 align-center-4 align-center-5 align-center-6')

    p.header(tbl)

    -- Render rows
    local function makeRow(entry)
        local name = mw.text.split(entry['name'], '#', true)
        if name[2] then
        	name[2] = name[2]:gsub('_', ' ')
        end
        local hp = entry['hitpoints']
        local prayer_xp = math.floor(hp * 0.2)
        local tr = mw.html.create('tr')
            :tag('td'):css('height', '64px'):wikitext(entry['image'][1] and string.format('[[%s|link=|64x64px|%s%s]]', entry['image'][1], name[1], (name[2] and ' - ' .. name[2]) or '') or '' ):done()
            :tag('td'):wikitext( string.format('[[%s|%s]]%s', entry['name'], name[1], name[2] and '<br/><i>' .. name[2] .. '</i>' or '') ):done()
            :tag('td'):wikitext(entry['is_members_only'] and '[[File:Member icon.png|center|link=Members|alt=Members]]' or '[[File:Free-to-play icon.png|center|link=Free-to-play|alt=Free-to-play]]'):done()
            :tag('td'):wikitext(entry['combat_level']):done()
            :tag('td'):wikitext(hp):done()
            :tag('td'):wikitext(prayer_xp):done()

        return tr
	end

	for e, entry in ipairs(data) do
		local ret = makeRow(entry)
		tbl:node(ret)
	end

    return div
end

return p