-- Helper function to format value based on its size
local function formatValue(value, price_is_na)
    if price_is_na then
        return "N/A"
    elseif value > 0 and value < 1 then
        return string.format("%.2f", value)
    else
        return coins(value)
    end
end

local function formatQuantity(q)
    if q >= 1 then
        return tostring(math.floor(q))
    elseif q > 0 and q < 1 then
        return string.format("%.2f", q)
    else
        return "0"
    end
end

