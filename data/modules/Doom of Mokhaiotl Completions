-- Helper function to fetch Grand Exchange price
local function getItemPrice(name)
    if name == "Mokhaiotl cloth" then
        local gauntlets_price = gePrice("Confliction gauntlets") or 0
        local bracelet_price = gePrice("Tormented bracelet") or 0
        return gauntlets_price - bracelet_price
    elseif name == "Dom" or name == "Spirit seed" or name == "Sun-kissed bones" or name == "Tooth half of key (moon key)" or name == "Clue scroll (elite)" then
        return 0
    end
    return gePrice(name) or 0
end

-- Formats the results into wiki tables
local function format_results_tables(results)
    local output = ""

    -- Unique Loot Table
    local unique_loot_table = mw.html.create("table"):addClass("wikitable align-center-1")
    local unique_loot_table_data = {}
    table.insert(unique_loot_table_data, {{tag = "th", text = "Item", attr = {colspan = 2}}, {tag = "th", text = "Expected Quantity"}, {tag = "th", text = "Expected Value"}})

    local total_unique_value = 0
    local total_unique_qty = 0
    local unique_items_order = {"Mokhaiotl cloth", "Eye of ayak (uncharged)", "Avernic treads", "Dom"}
    for _, item_name in ipairs(unique_items_order) do
        local expected_qty = results.uniques[item_name] or 0
        local item_price = getItemPrice(item_name)
        local item_value = expected_qty * item_price
        if item_name ~= "Dom" then
        	total_unique_qty = total_unique_qty + expected_qty
    	end
        total_unique_value = total_unique_value + item_value

        table.insert(
            unique_loot_table_data,
            {
                {text = string.format("[[File:%s.png|link=%s]]", item_name, item_name)},
                {text = string.format("[[%s]]", item_name)},
                {text = string.format("%.2f", expected_qty)},
                {text = formatValue(item_value, item_price == 0)}
            }
        )
    end
    table.insert(
        unique_loot_table_data,
        {   
        	{attr = {colspan = 2}, text = "Total (excluding Dom)", tag = "th"},
        	{text = string.format("%.2f", total_unique_qty), attr = {style = "text-align: left;"},tag = "th"},
        	{text = formatValue(total_unique_value, false),tag = "th"}
        }
    )
    tables._table(unique_loot_table, unique_loot_table_data)
    output = output .. "===Unique loot===\n" .. tostring(unique_loot_table)

    -- Common Loot Table
    local common_loot_table = mw.html.create("table"):addClass("wikitable align-center-1")
    local common_loot_table_data = {}
    table.insert(common_loot_table_data, {{tag = "th", text = "Item", attr = {colspan = 2}}, {tag = "th", text = "Expected Quantity"}, {tag = "th", text = "Expected Value"}})

    local total_common_value = 0
    -- Collect all common items including guaranteed tears and clue scrolls
    local all_common_items = {}
    for name, qty in pairs(results.regular_loot) do
        all_common_items[name] = qty
    end
    all_common_items["Demon tear (guaranteed)"] = results.guaranteed_tears
    all_common_items["Clue scroll (elite)"] = results.clue_scrolls

    -- Sort items for consistent display (optional, but good practice)
    local sorted_common_names = {}
    for name, _ in pairs(all_common_items) do
        table.insert(sorted_common_names, name)
    end
    table.sort(sorted_common_names)

    for _, name in ipairs(sorted_common_names) do
        local expected_qty = all_common_items[name] or 0
        local item_price = 0
        local link_target = name -- The name of the page to link to
        local display_name = name -- The name to display in the table
        local image_name = name -- The name of the image file

        if name == "Demon tear (guaranteed)" then
            item_price = getItemPrice("Demon tear")
            image_name = "Demon tear"
            link_target = "Demon tear"
            display_name = "Demon tear (guaranteed)"
        elseif name == "Clue scroll (elite)" then
            item_price = getItemPrice("Clue scroll (elite)")
        else
            item_price = getItemPrice(name)
        end
        
        local item_value = expected_qty * item_price
        total_common_value = total_common_value + item_value

        table.insert(
            common_loot_table_data,
            {
                {text = string.format("[[File:%s.png|link=%s]]", image_name, link_target)},
                {text = string.format("[[%s|%s]]", link_target, display_name)},
                {text = string.format("%.2f", expected_qty)},
                {text = formatValue(item_value, item_price == 0)}
            }
        )
    end

    table.insert(common_loot_table_data, {{attr = {colspan = 3}, text = "Total expected value", tag = "th"}, {text = formatValue(total_common_value, false), tag = "th"}})
    tables._table(common_loot_table, common_loot_table_data)
    output = output .. "\n===Common loot===\n" .. tostring(common_loot_table)

    return output
end


function p.main(frame)
    local args = frame.args
    local completions = {}
    local has_completions = false

    -- Parse completion inputs
    for i = 1, 8 do
        if args['completions_' .. i] then
            local num = tonumber(args['completions_' .. i])
            if num and num >= 0 then
                completions[i] = num
                if num > 0 then has_completions = true end
            end
        end
    end
    if args['completions_8+'] then
        local num = tonumber(args['completions_8+'])
        if num and num >= 0 then
            completions[9] = num -- Use 9 internally for 8+
            if num > 0 then has_completions = true end
        end
    end

    if not has_completions then
        return "Please enter at least one completion count to calculate expected loot."
    end

    local results = {
        regular_loot = {},
        uniques = {},
        guaranteed_tears = 0,
        clue_scrolls = 0
    }

    -- Calculate loot based on completions
    for level_num, num_completed in pairs(completions) do
        local effective_level = (level_num == 9) and 9 or level_num
        local loot_multiplier = loot_multipliers[effective_level] or 0

        -- Calculate regular loot
        for _, loot_item in ipairs(regular_loot_base) do
            local name = loot_item.name
            local base_min = loot_item.quantity[1]
            local base_max = loot_item.quantity[2]

            local avg_base_qty

            -- Account for Shark Lure always dropping in multiples of 2.
            -- This calculates the average of all possible even numbers in the range.
            if name == "Shark lure" then
                local first_even = (base_min % 2 == 0) and base_min or base_min + 1
                local last_even = (base_max % 2 == 0) and base_max or base_max - 1
                avg_base_qty = (first_even + last_even) / 2
            else
                -- Standard average calculation for all other items
                avg_base_qty = (base_min + base_max) / 2
            end

            -- Apply the multiplier and then round down, as per game mechanics
            local adjusted_avg_qty = math.floor(avg_base_qty * (1 + loot_multiplier))

            -- The expected quantity per run is this adjusted average multiplied by the rarity
            local expected_per_run = adjusted_avg_qty * loot_item.rarity

            results.regular_loot[name] = (results.regular_loot[name] or 0) + (expected_per_run * num_completed)
        end

        -- Calculate guaranteed Demon Tears
        if level_num == 3 then results.guaranteed_tears = results.guaranteed_tears + (50 * num_completed) end
        if level_num == 4 then results.guaranteed_tears = results.guaranteed_tears + (60 * num_completed) end
        if level_num == 5 then results.guaranteed_tears = results.guaranteed_tears + (70 * num_completed) end
        if level_num == 6 then results.guaranteed_tears = results.guaranteed_tears + (80 * num_completed) end
        if level_num == 7 then results.guaranteed_tears = results.guaranteed_tears + (90 * num_completed) end
        if level_num >= 8 then results.guaranteed_tears = results.guaranteed_tears + (100 * num_completed) end

        -- Corrected: Calculate unique drops
        for unique_name, unique_rates_for_item in pairs(unique_rates) do
            local rate_for_level = unique_rates_for_item[effective_level] or 0
            if rate_for_level > 0 then
                results.uniques[unique_name] = (results.uniques[unique_name] or 0) + (num_completed / rate_for_level)
            end
        end

        -- Corrected: Calculate Clue Scroll drops (multiplied by probability)
        local clue_rate_for_level = clue_rates[level_num] or 0
        if clue_rate_for_level > 0 then
            results.clue_scrolls = results.clue_scrolls + (num_completed * clue_rate_for_level)
        end
    end

    return format_results_tables(results)
end

return p