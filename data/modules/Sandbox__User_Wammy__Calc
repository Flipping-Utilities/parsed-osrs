local prayerModifier = {
	0,
	0.01,
	0.02,
	0.04,
}

function p.main(frame)
	-- Parse the args
	local args = frame.args
	
	local selectedWeapon = tostring(args.weapon)
	local selectedWeaponData = weaponsData[tostring(args.weapon)]
	local gearModifier = tonumber(args.gearModifier) / 100
	local specialModifier = tostring(args.specialModifier)
	local inTombsOfAmascut = yesno(args.inTombsOfAmascut)
	local inWilderness = yesno(args.inWilderness)
	local haveForinthrySurge = yesno(args.haveForinthrySurge)
	local wieldingElementalTome = yesno(args.wieldingElementalTome)
	
	local calculatedDamage = p.calc(selectedWeapon, selectedWeaponData, gearModifier, specialModifier, inTombsOfAmascut, inWilderness, haveForinthrySurge, wieldingElementalTome)
	
	return renderTable(calculatedDamage)
end

function p.calc(selectedWeapon, selectedWeaponData, gearModifier, specialModifier, inTombsOfAmascut, inWilderness, haveForinthrySurge, wieldingElementalTome)	
	if selectedWeapon == "Tumeken's shadow" then
		if inTombsOfAmascut then
			gearModifier = gearModifier * 4
		else
			gearModifier = gearModifier * 3
		end
		
		gearModifier = math.min(gearModifier, 1)
	end
	
	-- Primary Magic Damage (Visible bonuses, Salve, Avarice, Maledictus)
	local primaryDamageMultiplier = 1 + gearModifier
	if specialModifier == 'Salve amulet (i)' then
		primaryDamageMultiplier = primaryDamageMultiplier + .15
	end
	if specialModifier == 'Salve amulet (ei)' then
		primaryDamageMultiplier = primaryDamageMultiplier + .2
	end
	if specialModifier == 'Amulet of avarice' then
		primaryDamageMultiplier = primaryDamageMultiplier + .2
		
		if haveForinthrySurge then
			primaryDamageMultiplier = primaryDamageMultiplier + .15
		end
	end
	
	-- Secondary Magic Damage (Slayer, Wildy Sceptre)		
	local secondaryDamageMultiplier = 1
	if specialModifier == 'Slayer helmet (i)' then
		secondaryDamageMultiplier = secondaryDamageMultiplier + .15
	end		
	if selectedWeapon == "Thammaron's sceptre" or selectedWeapon == 'Accursed sceptre' then
		if inWilderness then
			secondaryDamageMultiplier = secondaryDamageMultiplier + .5
		end
	end
		
	-- Post Hit Roll (Tomes)
	local postHitRollModifier = 1
	if wieldingElementalTome then
		postHitRollModifier = postHitRollModifier + .1
	end
	
	-- Iterate through weapon damage table
	for r = 1, selectedWeaponData[2], 1 do
		for p = 1, 4, 1 do
			local baseDamage = tonumber(selectedWeaponData[1][r][2])
		
			local primaryDamage = math.floor(baseDamage * (primaryDamageMultiplier + prayerModifier[p]))
			
			local secondaryDamage = math.floor(primaryDamage * secondaryDamageMultiplier)
			
			local finalDamage = math.floor(secondaryDamage * postHitRollModifier)
			
			selectedWeaponData[1][r][p+2] = finalDamage
		end		
	end
	
	return selectedWeaponData
end

function renderTable(calculatedDamage)
	frame = mw.getCurrentFrame()
	
	-- Create the table
	local hTable = mw.html.create('table')
		:addClass('wikitable sticky-header align-center-1')
		:attr('style', 'text-align:right')
		
	-- Add the headers
	hTable
		:tag('caption'):wikitext('Maximum hit')
		:tag('tr')
			:tag('th'):wikitext('Magic Level')
			:tag('th'):wikitext('Base Damage')
			:tag('th'):wikitext('No Prayer')
			:tag('th'):wikitext('[[File:Mystic_Lore.png|link=Mystic Lore|x21px]] Mystic Lore')
			:tag('th'):wikitext('[[File:Mystic_Might.png|link=Mystic Might|x21px]] Mystic Might')
			:tag('th'):wikitext('[[File:Augury.png|link=Augury|x21px]] Augury')
		:done()
		
	-- Add the rows
	for r=1, calculatedDamage[2], 1 do
		hTable:tag('tr')
			:tag('td'):wikitext(calculatedDamage[1][r][1])
			:tag('td'):wikitext(calculatedDamage[1][r][2])
			:tag('td'):wikitext(calculatedDamage[1][r][3])
			:tag('td'):wikitext(calculatedDamage[1][r][4])
			:tag('td'):wikitext(calculatedDamage[1][r][5])
			:tag('td'):wikitext(calculatedDamage[1][r][6])
		:done()
	end
	
	local div = mw.html.create('div')
	
	div	
		:node(hTable)
		:done()
		
	return tostring(div)
end

return p