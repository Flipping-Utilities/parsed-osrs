--- extract args from frame/table for main. we convert specific keywords into the standardized key. (e.g. "f2ponly" sets "allowMembers"=false; "table" sets "mode"="html")
-- @args (table) table to parse 
--- @returns (table) with the following kvp:
---  mode ("json"|"html"|html1) (defaults to json)
---  onlyProfitable (boolean) (defaults to false)
---  allowMembers (boolean) (defaults to true)
function p.parseExecArgs(args) 
	local opts = {
		mode = {
			json = {'data','json'},
			html =  {"text", "table", "html"},
			html1 = {"html1"},
			_default = 'json'
		},
		onlyProfitable = {
			[true] = {'profitable','profit'},
			[false] = {},
			_default = false,
		},
		allowMembers = {
			[false] = {	"f2p", "nomem", "f2ponly"	},
			[true] = { "p2p", "mem", "mems", "members" },
			_default = true
		},
	}
	local vals = {}
	for ka_raw, va_raw in pairs(args) do
		ka = p.normalizeName(ka_raw)
		va = p.normalizeName(va_raw)
		if opts[ka] then
			-- parse known named opt
			for val, valOpts in pairs (vo) do
				if val ~= '_default' then
					for i, vopt in pairs(valOpts) do
						if vopt == va then
							vals[ko] = val
							break
						end
					end
				end
				if vals[ko] then
					break
				end
			end
			if vals[ko] == nil then
				vals[ko] = p.argDefaults[ko] or opts[ko]._default
			end
		else
			-- assume its an unnamed argument type to be matched
			for ko, vo in pairs(opts) do
				for val, valOpts in pairs (vo) do
					if val ~= '_default' then
						for i, vopt in pairs(valOpts) do
							if vopt == ka or vopt == va then
								vals[ko] = val
								break
								end
						end
						if vals[ko] then
							break
						end
					end
				end
			end
			if vals[ka] == nil and tostring(tonumber(ka)) ~= tostring(ka) then
				-- assume named argument that's supposed to be there so add it
				vals[ka] = utils.tonumber(ka_raw) or va_raw
			end
		end
	end
	for ko, vo in pairs(opts) do
		if vals[ko] == nil then
			vals[ko] = vo._default
		end
	end
	return vals
end

