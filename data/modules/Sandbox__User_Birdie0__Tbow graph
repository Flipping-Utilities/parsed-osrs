local helper = require('Module:Chart data')

local function accuracyMultiplier(magic, magicCap)
	magic = math.min(magic, magicCap)
	return 140 + (30 * magic / 10 - 10) / 100 - (3 * magic / 10 - 100) ^ 2 / 100
end

local function damageMultiplier(magic, magicCap)
	magic = math.min(magic, magicCap)
	return 250 + (30 * magic / 10 - 14) / 100 - (3 * magic / 10 - 140) ^ 2 / 100
end

local function dataWithLabels(magicFn, multiplierCap, magicCap, label)
	local data = helper.generateXYFromFunc(function(x)
		return math.min(magicFn(x, magicCap), multiplierCap) / 100
	end, 0, 400)

	for _key, val in pairs(data) do
		val.label = 'Magic: ' .. tostring(val.x) .. ' ' .. label .. ': ' .. string.format('%.2f', val.y * 100) .. '%'
	end

	return data
end

local function accuracyData(magicCap, labelPrefix)
	return dataWithLabels(accuracyMultiplier, 140, magicCap, labelPrefix)
end

local function damageData(magicCap, labelPrefix)
	return dataWithLabels(damageMultiplier, 250, magicCap, labelPrefix)
end

