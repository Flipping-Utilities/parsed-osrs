function expr(t)
    local noerr, val = pcall(mw.ext.ParserFunctions.expr, t)
    if noerr then
        return tonumber(val)
    else
        return false
    end
end

function round(num, places)
	local mult = 10 ^ places
	return math.floor(num * mult + 0.5) / mult
end

