	['The Pandemonium'] = 'Pandemonium'
}

function p.main(frame)
	local args = frame:getParent().args
	
	local origin = args.origin
	local destination = args.dest
	local cargo = args.cargo
	local level,xp,noticeboard,cargoTask,quantity = params.defaults{
		{args.level, '1'},
		{args.xp, '0'},
		{args.noticeboard, origin},
		{args.cargoTask, cargo},
		{args.quantity, '1'},
	}
	
	return createLine(level, xp, origin, destination, noticeboard, cargo, cargoTask, quantity)
end

function createLine(level, xp, origin, destination, noticeboard, cargo, cargoTask, quantity)
	local fullTaskName = string.format('%s %s delivery', locationsOverrideForTaskName[destination] or destination, cargoTask)
	local transcriptPage = findTranscriptPage(fullTaskName, origin)
	
	local row = mw.html.create('tr')
	
	row:tag('td'):wikitext(level):done()
	row:tag('td'):wikitext(xp):done()
	row:tag('td'):wikitext(transcriptPage):done()
	local noticeboardCellContent = noticeboard
	if (locations[noticeboard]) then
		noticeboardCellContent = string.format('[[%s]]', noticeboard)
	end
	row:tag('td'):wikitext(noticeboardCellContent):done()
	row:tag('td'):wikitext(string.format('[[%s]]', origin)):done()
	row:tag('td'):wikitext(string.format('[[%s]]', destination)):done()
	
	local linkDest = string.format('Crate of %s#%s', cargo, destination)
	local imageString = string.format('[[File:Crate of %s (%s).png|link=%s]]', cargo, destination, linkDest)
	local linkString = string.format('[[%s|%s]]', linkDest, firstToUpper(cargo))
	row:tag('td'):addClass('plinkt-image'):addClass('inventory-image'):wikitext(imageString):done()
	row:tag('td'):addClass('plinkt-link'):wikitext(linkString):done()
	row:tag('td'):wikitext(quantity):done()
	row:tag('td'):wikitext(createMap(origin, destination, noticeboard)):done()
	
	return tostring(row)
end

function firstToUpper(str)
    return (str:gsub("^%l", string.upper))
end

function createMap(origin, destination, noticeboard)
	local args = {
		type = 'maplink',
		mtype = 'pin',
		text = 'Map',
		nopreprocess = True,
		createIconForMap(merge(mapSettings.noticeboard, {
			x = locations[noticeboard].noticeboard[1],
			y = locations[noticeboard].noticeboard[2],
		})),
		createIconForMap(merge(mapSettings.origin, {
			x = locations[origin].ledgertable[1],
			y = locations[origin].ledgertable[2],
		})),
		createIconForMap(merge(mapSettings.destination, {
			x = locations[destination].ledgertable[1],
			y = locations[destination].ledgertable[2],
		})),
	}
	mw.logObject(args)
	return buildMap(args)
end

function createIconForMap(args) 
	local ret = ''
	for k, v in pairs(args) do
		ret = string.format('%s:%s,%s', k, v, ret)
	end
	return ret
end

function findTranscriptPage(taskname, cargoLocation) 
	local includingCargoLocation = taskname .. ' (' .. cargoLocation .. ')'
	if (mw.title.new(includingCargoLocation, 'transcript').exists) then
		return string.format('[[Transcript:%s|%s]]', includingCargoLocation, taskname)
	end
	
	return string.format('[[Transcript:%s]]', taskname)
end

-- Merge two lua objects, creating a new object with all keys in a and b, with b taking priority
function merge(a, b)
	local ret = {}
	for k, v in pairs(a) do
		ret[k] = v
	end
	for k, v in pairs(b) do
		ret[k] = v
	end
	return ret
end

return p