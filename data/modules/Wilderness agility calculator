				:wikitext(string.format('%.1f', xp / laps))
			:done()
		:done()

	return totalTable
end


function getPrice(item, qty, ge)
	if ge then
		value = gePrice(item)
		return qty * (value - math.floor(0.02 * value))  -- consider tax
	end
	return qty * (alchPrice(item) - 180)
end


function p.main(frame)
	local args = frame.args
	local laps = tonumber(args.laps)
	if laps == nil then
		return "Number of laps must be between 1 and 10000."
	end

	return p.calc(laps)
end


function p.calc(laps)
	local resourceQtys = {
		['Blighted anglerfish']=0,
		['Blighted manta ray']=0,
		['Blighted karambwan']=0,
		['Blighted super restore(4)']=0
	}

	local armourQtys = {
		['Steel platebody']=0,
		['Mithril chainbody']=0,
		['Mithril platelegs']=0,
		['Mithril plateskirt']=0,
		['Adamant full helm']=0,
		['Adamant platelegs']=0,
		['Adamant platebody']=0,
		['Rune med helm']=0,
		['Rune chainbody']=0,
		['Rune kiteshield']=0
	}

	for i=1,laps do
		if i <= 15 then
			resourceTable = resources1_15
			armourTable = armour1_15
		elseif i <= 30 then
			resourceTable = resources16_30
			armourTable = armour16_30
		elseif i <= 60 then
			resourceTable = resources31_60
			armourTable = armour31_60
		else
			resourceTable = resources61
			armourTable = armour61
		end

		for resource, qty in pairs(resourceTable) do
			resourceQtys[resource] = resourceQtys[resource] + qty
		end

		for armour, qty in pairs(armourTable) do
			armourQtys[armour] = armourQtys[armour] + qty
		end
	end

	local resourceQtysVals = {}
	local resourceTotalValGE = 0
	for item, qty in pairs(resourceQtys) do
		ge = getPrice(item, qty, true)
		resourceQtysVals[item] = {qty, ge}

		resourceTotalValGE = resourceTotalValGE + ge
	end

	local armourQtysVals = {}
	local armourTotalValGE = 0
	local armourTotalValHA = 0
	for item, qty in pairs(armourQtys) do
		ge = getPrice(item, qty, true)
		ha = getPrice(item, qty, false)
		armourQtysVals[item] = {qty, ge, ha}

		armourTotalValGE = armourTotalValGE + ge
		armourTotalValHA = armourTotalValHA + ha
	end

	local outResource = makeTable(false)
	for _, item in ipairs(resourceOrder) do
		qty, ge, ha = unpack(resourceQtysVals[item])
		outResource:node(makeLine(item, qty, ge))
	end
	makeTableBottom(outResource, resourceTotalValGE)
	
	local outArmour = makeTable(true)
	for _, item in ipairs(armourOrder) do
		qty, ge, ha = unpack(armourQtysVals[item])
		outArmour:node(makeLine(item, qty, ge, ha))
	end
	makeTableBottom(outArmour, armourTotalValGE, armourTotalValHA)

	local courseXp = 571.4 * laps
	local ticketXp = 230 * laps
	local totalXP = courseXp + ticketXp
	
	local totalGE = resourceTotalValGE + armourTotalValGE
	local totalHA = armourTotalValHA
	local outTotal = makeTotalTable(laps, totalGE, totalHA, totalXP)

	return '===Totals===\n' .. 
	"''The profits account for the 150,000gp lap fee, and all prices subtract either the 2% GE tax or 180gp per nature rune.''\n\n" ..
	"''The experience total includes XP from obstacles and assumes tickets are redeemed in batches of 101 or more.''\n" .. 
	tostring(outTotal) .. 
	'\n\n===Supplies===\n' .. 
	"''Unnoted supplies are not counted, since most will be dropped in the long run.''\n" ..
	tostring(outResource) .. 
	'\n\n===Armour===\n' .. 
	tostring(outArmour)
end

return p