function makeTable(armour)
	local header = mw.html.create('tr')
		:tag('th')
			:wikitext('Item')
			:attr('colspan', 2)
		:done()
		:tag('th')
			:wikitext('Quantity')
		:done()
		:tag('th')
			:wikitext('[[Grand Exchange|GE]] Price')
		:done()
		
	if armour then
		header:tag('th')
			:wikitext('[[High Level Alchemy|HA]] Price')
		:done()
	end

	return mw.html.create('table')
		:addClass('wikitable sortable align-center-1 align-left-2 align-center-3')
		:css('text-align','right')
		:node(header)
end


function makeTableBottom(inTable, sumGE, sumHA)
	local row = mw.html.create('tr')
		:addClass('sortbottom')
		:tag('th')
			:attr('colspan', 3)
			:css('text-align','right')
			:wikitext('Total:')
		:done()
		:tag('td')
			:css('text-align','right')
			:wikitext(coins(string.format('%d', sumGE)))
		:done()
		
	if sumHA ~= nil then
		row:tag('td')
			:css('text-align','right')
			:wikitext(coins(string.format('%d', sumHA)))
		:done()
	end
	
	inTable:node(row)
end


function makeLine(item, qty, ge, ha)
	local t = mw.html.create('tr')
		:tag('td')
			:wikitext('[[File:' .. item .. '.png|link=' .. item .. ']]')
		:done()
		:tag('td')
			:wikitext('[[' .. item .. ']]')
		:done()
		:tag('td')
			:wikitext(string.format('%.2f', qty))
		:done()
		:tag('td')
			:wikitext(commas(string.format('%d', ge)))
		:done()
		
	if ha ~= nil then
		t:tag('td')
			:wikitext(commas(string.format('%d', ha)))
		:done()
	end
	return t
end


