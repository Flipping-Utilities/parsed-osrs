local p = {}

local function trim(s)
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function replaceFunctions(expr)
    local functions = { sqrt="\\sqrt", sin="\\sin", cos="\\cos", tan="\\tan", log="\\log", ln="\\ln" }
    for name, latex in pairs(functions) do
        expr = expr:gsub(name .. "%(([^)]+)%)", latex .. "{%1}")
    end
    return expr
end

local function replaceSymbols(expr) --replacing common numbers and symbols like pi etc, if you want to add more in here just go ahead, tbh i dont think many are used in osrs but i might come back if i see more to add
    local symbols = {
        pi = "π",
        theta = "θ",
        delta = "Δ",
        --turn small x into capital
        x = "''X''",
        y = "''Y''",
        z = "''Z''",
    }

   for key, latex in pairs(symbols) do
        expr = expr:gsub("(%f[%a])" .. key .. "(%f[^%a])", "%1" .. latex .. "%2")
    end

    expr = expr:gsub("(%f[%a])([xyz])(%f[^%a])", "''%2''") -- for xyz maybe more later

    return expr
end

local superscript_digits = {
    ["0"] = "⁰", ["1"] = "¹", ["2"] = "²", ["3"] = "³", ["4"] = "⁴",
    ["5"] = "⁵", ["6"] = "⁶", ["7"] = "⁷", ["8"] = "⁸", ["9"] = "⁹"
}

local function digits_to_sup(s)
    return (s:gsub(".", function(c) return superscript_digits[c] or c end))
end

local function replaceOperators(expr)
    -- convert numeric exponents to unicode superscript, letter exponents to a small raised span
    expr = expr
        :gsub("%^([0-9]+)", function(n) return digits_to_sup(n) end)
        :gsub("%^([%a])", '<span style="vertical-align:super;font-size:70%;">%1</span>')
        :gsub("%*", " · ")
        :gsub("%(", "(")
        :gsub("%)", ")")
    return expr
end


local function handleFractions(expr)
    local function findTopLevelSlash(s)
        local depth = 0
        for i = 1, #s do
            local c = s:sub(i,i)
            if c == "(" then
                depth = depth + 1
            elseif c == ")" then
                depth = depth - 1
            elseif c == "/" and depth == 0 then
                return i
            end
        end
        return nil
    end

    local slashPos = findTopLevelSlash(expr)
    if slashPos then
        local left = trim(expr:sub(1, slashPos - 1))
        local right = trim(expr:sub(slashPos + 1))
        return '<span style="display:inline-block;text-align:center;vertical-align:middle;">' ..
               '<span style="display:block;border-bottom:1px solid #000;padding:0 0.2em;">' .. handleFractions(left) .. '</span>' ..
               '<span style="display:block;padding-top:0.12em;">' .. handleFractions(right) .. '</span>' ..
               '</span>'
    else
        return expr
    end
end

local function toLatex(expr)
    if not expr or expr == "" then return "" end
   --put it all together and hope it works 
    expr = trim(expr)
    expr = replaceFunctions(expr)
    expr = replaceSymbols(expr)
    expr = replaceOperators(expr)

    expr = handleFractions(expr)

    return expr
end
--template invoke me
function p.render(frame)
    local expr = frame.args[1] or ""
    return toLatex(expr)
end

return p