local coins = require('Module:Coins')

local p = {}

function p.main(frame)
	return p._main(frame:getParent().args)
end

function p._main(args)
	
	local data = bucket('storeline')
		.join('infobox_item', 'infobox_item.page_name_sub', 'sold_item')
		.select('page_name', 'sold_item', 'store_stock', 'infobox_item.high_alchemy_value', 'store_sell_price')
		.where('store_currency', 'coins')
		.where('infobox_item.high_alchemy_value', '>', 100)
		.where('store_sell_price', '>', 0)
		.where('store_stock', '!=', bucket.Null())
		.where('store_stock', '!=', '0')
		.where('store_stock', '!=', 'N/A')
		.limit(5000)
		.run()

	local results = {}
	for _,result in ipairs(data) do
		local skip = false
		
		--Sells a one time ancient staff
		if result.page_name == 'Eblis' then
			skip = true
		end
		
		if skip == false then
			result.purchase = result.store_sell_price and result.store_stock and result.store_sell_price
			result.alchemy = result['infobox_item.high_alchemy_value'] and result.store_stock and result['infobox_item.high_alchemy_value'] / 0.35 * 1.15
			result.profit = result.alchemy and result.purchase and result.alchemy - result.purchase
			result.roi = ((result['infobox_item.high_alchemy_value']/0.35*1.15)-result.purchase)/result.purchase * 100
			
			result.profitperhour = result.profit * 1200
			
			table.insert(results, result)
		end
	end
	table.sort(results,function(a,b) return a.profitperhour > b.profitperhour end)

	local out = mw.html.create('table')
		:addClass('wikitable sortable align-center-3')
		:tag('tr')
		:tag('th')	:attr{ colspan = '2' } :wikitext('Item')				:done()
		:tag('th')	:wikitext('Shops')				:done()
		:tag('th')	:wikitext('Stock')				:done()
		:tag('th')	:wikitext('Purchase')			:done()
		:tag('th')	:wikitext('Alch Price')			:done()
		:tag('th')	:wikitext('Profit')				:done()
		:tag('th')	:wikitext('Profit per hour')	:done()
		:tag('th')	:wikitext('ROI')				:done()
		:done()

	for _,result in ipairs(results) do
		if result.profit > 0 then
			out:tag('tr')
				:tag('td')	
					:addClass( "plinkt-image" )
					:addClass( "no-border" )
					:wikitext('[[File:'..(result.sold_item or '')..'.png]]')					
				:done()
				:tag('td')	
					:addClass( "plinkt-link" )
					:addClass( "no-border" )
					:wikitext('[['..(result.sold_item or '')..']]')							
				:done()
				:tag('td')	
					:wikitext('[['..(result.page_name or '')..']]')					
				:done()
				:tag('td')	
					:wikitext(result.store_stock)					
				:done()
				:tag('td')	
					:wikitext(coins._amount(result.purchase,false))		
				:done()
				:tag('td')	
					:wikitext(coins._amount(result.alchemy or 0,false))	
				:done()
				:tag('td')	
					:wikitext(coins._amount(result.profit or 0,false))		
				:done()
				:tag('td')	
					:wikitext(coins._amount(result.profitperhour or 0,false))	
				:done()
				:tag('td')
					:wikitext((string.format("%03.1f", result.roi) or '?') .. '%')
				:done()
			:done()
		end
	end

	return out
end

return p