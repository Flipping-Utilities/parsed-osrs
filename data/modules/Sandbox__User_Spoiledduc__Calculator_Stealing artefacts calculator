	-- Output the resulting information for the player and print the completion
	-- time estimate in minutes if less than 1 hour
	if timeToComplete <= 1.0 then
		local timeToComplete = tonumber(string.format("%.2f", (timeToComplete * 60.0)))
		local ret = '' .. commas(artefactCount) .. ' artefact(s) are needed to reach the target Thieving level of ' .. goalLevel .. ' (' .. commas(xpIter) .. ' XP) from a starting level of ' .. currentLevel .. ' (' .. commas(initialXP) .. ' XP). <br/> Time to completion is estimated at ' .. timeToComplete .. ' minutes.'
