	-- interally to a level value to proceed
	if args.currentToggle == 'Level' then
		currentLevel = paramTest.default_to(tonumber(args.currentThievingLvl), 1)
		currentXP = xpAtLevel({ args = { currentLevel } })
	else
		currentXP = paramTest.default_to(tonumber(args.currentThievingXP), 0)
		currentLevel = levelAtXp({ args = { currentXP } })
	end

	-- Check if the player is able to participate in Stealing Artefacts at all
	if(currentLevel < 49) then
		return ('Your current level (' .. currentLevel .. ') is <b>not</b> sufficient to participate in the Stealing Artefacts minigame. <b>Level 49 Thieving is required.</b> <br/> Low-level training methods for Thieving are detailed on the [[Thieving training]] page.')
	end

	-- Get the desired goal level and check if the player has already reached it
	goalLevel = math.min(paramTest.default_to(tonumber(args.goalLevel), 1), 126)

	if(goalLevel <= currentLevel) then
		return ('Your current level (' .. currentLevel .. ') is at or above your target level (' .. goalLevel .. ').')
	end
	
	-- Compute the number of artefacts required to reach the desired goal level
	artefactCount = 0
	xpIter = currentXP
	for i = currentLevel, goalLevel - 1, 1 do
		
		-- Get the artefact XP for this current level as (750 + 40*lvl) per 
		local artefactXPAtLevel = artefactFormula(math.min(i, 99),leagueMultiplier)
		
