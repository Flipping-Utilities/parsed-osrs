		-- Now, compute the number of artefacts to steal to reach next level
		local artefactsToLevel = math.ceil(xpToNextlevel / artefactXPAtLevel)
		
		-- Keep count of the total number of artefacts stolen
		artefactCount = artefactCount + artefactsToLevel
		
