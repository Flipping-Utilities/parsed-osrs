local currencies = { "USD", "GBP", "EUR", "AUD", "CAD" }
local durations  = { "1", "3", "6", "12" }

-- Deep copy of a value (needed when we store the last known price)
local function copy(x)
    if type(x) == "table" then
        local t = {}
        for k, v in pairs(x) do t[k] = copy(v) end
        return t
    end
    return x
end

-- Build a complete snapshot from sparse ones (fill gaps with last known)
local function buildCompleteHistory()
    local complete = {}          -- array of filled snapshots
    local lastBonds = {}         -- last seen prices per currency
    local lastMem   = {          -- last seen prices per duration per currency
        ["1"] = {}, ["3"] = {}, ["6"] = {}, ["12"] = {}
    }

    for _, snap in ipairs(priceHistory) do
        -- start with a deep copy of the previous filled values
        local filled = {
            date = snap.date, url = snap.url, title = snap.title,
            bonds = copy(lastBonds),
            membership = {
                ["1"] = copy(lastMem["1"]),
                ["3"] = copy(lastMem["3"]),
                ["6"] = copy(lastMem["6"]),
                ["12"] = copy(lastMem["12"])
            }
        }

        if snap.bonds then
            for _, c in ipairs(currencies) do
                if snap.bonds[c] ~= nil then
                    filled.bonds[c] = { val = snap.bonds[c], explicit = true }
                end
            end
        end
        for _, dur in ipairs(durations) do
            if snap.membership and snap.membership[dur] then
                for _, c in ipairs(currencies) do
                    if snap.membership[dur][c] ~= nil then
                        filled.membership[dur][c] = { val = snap.membership[dur][c], explicit = true }
                    end
                end
            end
        end

        -- push filled snapshot and update running "last known"
        table.insert(complete, filled)
        for _, c in ipairs(currencies) do
            if filled.bonds[c] then
                lastBonds[c] = filled.bonds[c]
            end
        end
        for _, dur in ipairs(durations) do
            for _, c in ipairs(currencies) do
                if filled.membership[dur][c] then
                    lastMem[dur][c] = filled.membership[dur][c]
                end
            end
        end
    end
    return complete
end

-- Build a complete snapshot from sparse ones (fill gaps with last known)
local function buildCompleteHistory2()
    local complete = {}          -- array of filled snapshots

    for _, snap in ipairs(priceHistory) do
        -- start with a deep copy of the previous filled values
        local filled = {
            date = snap.date, url = snap.url, title = snap.title,
            bonds = {},
            membership = {}
        }
        
        for _,c in ipairs(currencies) do
        	if snap.bonds == nil then
        		snap.bonds = {}
        	end
        	
        	if snap.bonds and snap.bonds[c] ~= nil then
        		filled.bonds[c] = snap.bonds[c]
        	else
        		filled.bonds[c] = '-'
        	end
        	for _, dur in ipairs(durations) do
        		if snap.membership ~= nil and snap.membership[dur] ~= nil and snap.membership[dur][c] ~= nil then
        			filled.membership = filled.membership or {} filled.membership[dur] = filled.membership[dur] or {} filled.membership[dur][c] = snap.membership[dur][c]
        			-- filled.membership[dur][c] = snap.membership[dur][c]
        		else
        			filled.membership = filled.membership or {} filled.membership[dur] = filled.membership[dur] or {} filled.membership[dur][c] = '-'
        			-- filled.membership.dur.c = '-'
        		end
        	end
        end

        -- push filled snapshot and update running "last known"
        table.insert(complete, filled)
    end
    return complete
end

function p.htmlTable(frame)
    local complete = buildCompleteHistory()
    local latest   = complete[#complete]

    local tbl = mw.html.create("table")
        :addClass("wikitable")
    tbl:tag("caption")
       :wikitext("Current prices (effective " .. latest.date .. ")")

    -- header
    local h = tbl:tag("tr")
    h:tag("th"):wikitext("Item")
    for _, c in ipairs(currencies) do h:tag("th"):wikitext(c) end

    -- bonds
    local br = tbl:tag("tr")
    br:tag("td"):wikitext(string.format("[%s %s] Bond", latest.url, latest.title))
    for _, c in ipairs(currencies) do
        local cell = latest.bonds[c]
        local fmt  = nilCheck(cell)
        br:tag("td"):wikitext(fmt)
    end

    -- membership
    for _, dur in ipairs(durations) do
        local r = tbl:tag("tr")
        r:tag("td"):wikitext(dur .. "-month membership")
        for _, c in ipairs(currencies) do
            local cell = latest.membership[dur][c]
            local fmt  = nilCheck(cell)
            r:tag("td"):wikitext(fmt)
        end
    end

    return tostring(tbl)
end

local function nilCheck(cell)
	if cell ~= nil then
		return cell.explicit and tostring(cell.val) or "<i>" .. cell.val .. "</i>"
	else
		return "<i>-</i>"
	end
end

local function nilCheck2(cell)
	if cell ~= nil and cell ~= '-' then
		return cell
	else
		return "<i>-</i>"
	end
end

