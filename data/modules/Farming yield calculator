local chart = require( 'Module:Chart data' )
local yesno = require('Module:Yesno')

local p = {}

local compostLives = {
	None = 3,
	Compost = 4,
	Supercompost = 5,
	Ultracompost = 6
}

local diary = {
	['None'] = 0,
	['Kandarin - Medium (5%)'] = 10,
	['Kandarin - Hard (10%)'] = 17,
	['Kandarin - Elite (15%)'] = 25,
	['Kourend and Kebos - Hard (5%)'] = 10
}

function p.main(frame)
	local args = frame.args
	
	local name = args.name
	local pic = args.pic or (name .. '.png')
	
	local lives = tonumber(args.harvestLives)
	if (lives == 0) then
		lives = compostLives[args.compostTier]
	end
		
	local diaryBoost = diary[args.diary] or 0
	local farmingCapeBoost = yesno(args.farmingCape,false) and 0.05 or 0
	
	local lvlReq = tonumber(args.lvlReq) or 1
	local low = tonumber(args.low) or 0
	local high = tonumber(args.high) or 0
	local secateurs = yesno(args.secateurs, true)
	return p._main(name,pic,lives,diaryBoost,farmingCapeBoost,lvlReq,low,high,secateurs)
end

function p._main(name,pic,lives,diaryBoost,farmingCapeBoost,lvlReq,low,high,secateurs)
	local args = {}
	args.xlabel = 'Farming level'
	args.ylabel = 'Average yield'
	args.showbefore = 'no'
	args.label = name .. ' yield'
	
	args.label1 = 'Regular'
	args.image1 = pic
	args.color1 = '#79874c'
	args.lives1 = lives
	args.req1 = lvlReq
	args.low1 = math.modf(low * (1+farmingCapeBoost))
	args.low1 = args.low1 + diaryBoost
	args.high1 = math.modf(high * (1+farmingCapeBoost))
	args.high1 = args.high1 + diaryBoost
	
	args.label2 = 'Attas'
	args.image2 = 'Attas icon.png'
	args.color2 = '#be5e57'
	args.lives2 = lives
	args.req2 = lvlReq
	args.low2 = math.modf(low * (1+farmingCapeBoost))
	args.low2 = args.low2 + diaryBoost
	args.low2 = math.modf(args.low2 * 1.05)
	args.high2 = math.modf(high * (1+farmingCapeBoost))
	args.high2 = args.high2 + diaryBoost
	args.high2 = math.modf(args.high2 * 1.05)
	
	local maxhigh = args.high2
	
	if (secateurs) then
		args.label3 = 'Magic secateurs'
		args.image3 = 'Magic secateurs.png'
		args.color3 = '#0d8415'
		args.lives3 = lives
		args.req3 = lvlReq
		args.low3 = math.modf(low * (1+0.1+farmingCapeBoost))
		args.low3 = args.low3 + diaryBoost
		args.high3 = math.modf(high * (1+0.1+farmingCapeBoost))
		args.high3 = args.high3 + diaryBoost
		
		args.label4 = 'Magic secateurs, attas'
		args.image4 = 'Magic secateurs and attas.png'
		args.color4 = '#ffa210'
		args.lives4 = lives
		args.req4 = lvlReq
		args.low4 = math.modf(low * (1+0.1+farmingCapeBoost))
		args.low4 = args.low4 + diaryBoost
		args.low4 = math.modf(args.low4 * 1.05)
		args.high4 = math.modf(high * (1+0.1+farmingCapeBoost))
		args.high4 = args.high4 + diaryBoost
		args.high4 = math.modf(args.high4 * 1.05)
		
		maxhigh = args.high4
	end
	
	args.ystep = math.max(1,math.modf(256*lives/ (255-(maxhigh))/10))
	
	if name == 'Limpwurt root' then
		args.calcMethod = 'limpwurt'
		-- Limpwurt is affected by anima, cape and secateurs
		args.levelBoost1 = farmingCapeBoost
		args.levelBoost2 = farmingCapeBoost + 0.05
		args.levelBoost3 = farmingCapeBoost + 0.10
		args.levelBoost4 = farmingCapeBoost + 0.15
	elseif name == 'Nightshade' then
		args.calcMethod = 'nightshade'
		-- Belladonna is affected by anima only
		-- We assume secateurs is false, so no need to set levelBoost3 and 4
		args.levelBoost1 = 0
		args.levelBoost2 = 0.05
	else
		args.calcMethod = 'cts'
	end
		
	local plot = chart.newChart{ type = 'scatter' }
        :setTitle( args.label )
        :setDimensions( 'min(540px, 100vw - 32px)', '400px', '300px', '300px', true )
        :setXLabel( args.xlabel or 'Level' )
        :setYLabel( args.ylabel or 'Success rate' )
        :setXLimits( nil, nil, 1 )
        :setDatasetsPerGroup(3)
        
    if args.lives1 == nil then
    	plot:setYFormat( 'percent' )
        :setYLimits( nil, nil, 0.1 )
        :setTooltipFormat( 'skillingSuccess' )
    else
    	plot:setYLimits( nil, nil, (tonumber(args.ystep) or 5))
        :setTooltipFormat( 'harvestLives' )
    end
    
	local dataSets = p._calculateDataSets(args)
	for i, dataSet in ipairs(dataSets) do
		plot:newDataSet(dataSet)
	end

    return plot
end

function p._calculateDataSets(args)
	local dataSets = {}
	local inputs = {}
	local i = 1
	while args['label' .. i] do
		table.insert(inputs, {
			label = args['label' .. i],
			low = args['low' .. i] or 0,
			high = args['high' .. i],
			req = tonumber(args['req' .. i] or 1),
			image = args['image' .. i] or 'hi',
			color = args['color' .. i] or '',
			lives = args['lives' .. i] or 0,
			levelBoost = args['levelBoost' .. i] or 0
		})
		i = i + 1
	end
	
	args.lowLevel = tonumber(args.lowLevel or 1)
	args.highLevel = tonumber(args.highLevel or 99)

	for i, input in ipairs(inputs) do
		local cutoffLevelY = nil
		local cutoffLevelX = nil
		local data = {}
		for x = 1, input.req do
			local y
			if args.calcMethod == 'limpwurt' then
				y = limpwurtYield(x, input.levelBoost)
			elseif args.calcMethod == 'nightshade' then
				y = nightshadeYield(x, input.levelBoost)
			else
				y = ctsYield(input.low, input.high, x, input.lives)
			end
			if args.showbefore ~= 'no' or input.req == x or (y >= 0.999 and input.lives == 0) then
				table.insert(data, {x=x, y=y})
			end
			if y >= 0.999 and input.lives == 0  then
				cutoffLevelY = x
				break
			end
		end

		table.insert(dataSets, {
	        data = data,
	        label = input.label .. "  ",
	        borderDash = {5, 5},
	        borderCapStyle = 'round',
	        pointRadius = 0,
	        baseColor = input.color,
	        pointStyleImg = input.image,
	    })

	    data = {}
		for x = input.req, args.highLevel do
			if cutoffLevelY ~= nil then
				break
			end
			local y
			if args.calcMethod == 'limpwurt' then
				y = limpwurtYield(x, input.levelBoost)
			elseif args.calcMethod == 'nightshade' then
				y = nightshadeYield(x, input.levelBoost)
			else
				y = ctsYield(input.low, input.high, x, input.lives)
			end
			if y >= 0.999 and cutoffLevelY == nil and input.lives == 0 then
				cutoffLevelY = x
			end
			if x >= args.highLevel and cutoffLevelX == nil and input.lives == 0 then
				cutoffLevelX = {x = x, y = y}
			end
			table.insert(data, {x=x, y=y})
		end

		table.insert(dataSets, {
	        data = data,
	        label = input.label .. "  ",
	        borderDash = {},
	        borderCapStyle = 'round',
	        baseColor = input.color,
	        pointRadius = 0,
	    })
	    
	    if cutoffLevelX ~= nil then
	    	table.insert(dataSets, {
		        data = {cutoffLevelX},
		        borderDash = {},
		        borderCapStyle = 'round',
		        baseColor = input.color,
		        pointRadius = 5,
	    	})
	    elseif cutoffLevelY ~= nil then
	    	table.insert(dataSets, {
		        data = {{x = cutoffLevelY, y = 1}},
		        borderDash = {},
		        borderCapStyle = 'round',
		        baseColor = input.color,
		        pointRadius = 5,
	    	})
	    else
			table.insert(dataSets, {})
	    end
	end

	return dataSets
end

function ctsYield(low, high, level, lives)
	return lives / (1-interp(low, high, level))
end

function limpwurtYield(level, boost)
	--[[ Calculates average yield for limpwurt plants.
	
	  The random yield is computed as follows:
	  1. Apply a percentage boost to the Farming level considering anima, cape
	     and secateurs (stacking additively), then take the floor.
	  2. Pick a random number between 0 (inclusive) and this value (exclusive).
	  3. Divide by 10, floor, then add 3.
	  
	  The average yield is computed based on this.
	]]
	local rngMaxInclusive = math.floor(level * (1 + boost)) - 1
	local quot = math.floor(rngMaxInclusive / 10)
	local rem = rngMaxInclusive % 10
	return (5 * (quot - 1) * quot + quot + quot * rem) / (rngMaxInclusive + 1) + 3
end

function nightshadeYield(level, boost)
	--[[ Calculates average yield for belladonna plants.
	
	  The random yield is computed as follows:
	  1. Apply a percentage boost to the Farming level considering anima only
	     (not cape or secateurs).
	  2. Pick a random number between 0 (inclusive) and this value (inclusive).
	  3. Divide by 8, floor, then add 6.
	  
	  The average yield is computed based on this.
	]]
	local rngMaxInclusive = math.floor(level * (1 + boost))
	local quot = math.floor(rngMaxInclusive / 8)
	local rem = rngMaxInclusive % 8
	return (4 * (quot - 1) * quot + quot + quot * rem) / (rngMaxInclusive + 1) + 6
end

function interp(low, high, level)
	local value = math.floor(low*(99-level)/98 + high*(level-1)/98 + 0.5) + 1
	return math.min(math.max(value / 256, 0), 1)	
end

return p