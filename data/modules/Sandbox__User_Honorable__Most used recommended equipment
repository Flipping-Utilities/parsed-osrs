local p = {}

local decode = mw.text.jsonDecode
local html = mw.html

local function collectData()
	local data = bucket('recommended_equipment')
		.limit(10000)
		.select('page_name', 'json')
		.run()

	assert(data and #data > 0, 'Bucket query failed')

	local itemData = {}
	local maxRank = 0

	for _, row in ipairs(data) do
		local pageName = row.page_name
		local json = decode(row.json)
		local rec = json["Recommended Equipment"]

		if rec then
			for _, slot in pairs(rec) do
				for rank, entry in ipairs(slot) do
					local found = {}

					for itemName in string.gmatch(entry, '%[%[File:[^|]+|link=([^%]]+)%]%]') do
						found[itemName] = true
					end

					for itemName in string.gmatch(entry, '%[%[([^%|%]]+)') do
						if not string.find(itemName, '^File:') then
							found[itemName] = true
						end
					end

					for itemName in pairs(found) do
						itemData[itemName] = itemData[itemName] or {
							ranks = {},
							pages = {}
						}

						itemData[itemName].ranks[rank] =
							(itemData[itemName].ranks[rank] or 0) + 1

						itemData[itemName].pages[pageName] = true

						if rank > maxRank then
							maxRank = rank
						end
					end
				end
			end
		end
	end

	return itemData, maxRank
end

local function sortItems(itemData, maxRank)
	local items = {}

	for name, data in pairs(itemData) do
		table.insert(items, {
			name = name,
			ranks = data.ranks,
			pages = data.pages
		})
	end

	table.sort(items, function(a, b)
		for i = 1, maxRank do
			local av = a.ranks[i] or 0
			local bv = b.ranks[i] or 0
			if av ~= bv then
				return av > bv
			end
		end
		return a.name < b.name
	end)

	return items
end

local function buildJSONBox(items, maxRank)
	local lines = {}

	for _, item in ipairs(items) do
		local line = '  { "item": "' .. item.name .. '"'
		for i = 1, maxRank do
			line = line .. ', "rank' .. i .. '": ' .. (item.ranks[i] or 0)
		end
		line = line .. ' },'
		table.insert(lines, line)
	end

	local jsonText = '[\n' .. table.concat(lines, '\n') .. '\n]'

	local pre = html.create('pre')
		:addClass('mw-collapsible') -- optional
		:css('max-height', '200px')
		:css('overflow', 'auto')
		:css('padding', '8px')
		:wikitext(jsonText)

	return tostring(pre)
end

local function buildTable(items, maxRank)
	local tbl = html.create('table')
		:addClass('wikitable sortable')

	local header = tbl:tag('tr')
	header:tag('th'):wikitext('Item'):done()
	for i = 1, maxRank do
		header:tag('th'):wikitext('Rank ' .. i):done()
	end
	header:tag('th'):wikitext('Total'):done()

	for _, item in ipairs(items) do
		local row = tbl:tag('tr')

		local cell = row:tag('td')
		cell:wikitext('[[' .. item.name .. ']]')

		-- Add collapsible list inside the same cell
		local collapseDiv = html.create('div')
			:addClass('mw-collapsible mw-collapsed')
			:css('margin-top', '4px')

		for pageName in pairs(item.pages) do
			collapseDiv:tag('div'):wikitext('[[' .. pageName .. ']]'):done()
		end

		cell:node(collapseDiv)

		-- Ranks
		local total = 0
		for i = 1, maxRank do
			local v = item.ranks[i] or 0
			total = total + v
			row:tag('td')
				:attr('data-sort-value', v)
				:wikitext(v > 0 and v or '')
				:done()
		end

		row:tag('td'):wikitext(total):done()
	end

	return tostring(tbl)
end

function p.main()
	local itemData, maxRank = collectData()
	local items = sortItems(itemData, maxRank)
	return buildJSONBox(items, maxRank) .. buildTable(items, maxRank)
end

return p