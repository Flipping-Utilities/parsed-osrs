function p.main(frame)
    local args = frame.args
    leagueMultiplier = args.leagueMultiplier or 1
    leaguePointModifier = args.leaguePointModifier or 1

	-- Get the current Fletching level or XP from the player and convert 
	-- internally to a level value to proceed
	if args.currentToggle == 'Level' then
		currentLevel = paramTest.default_to(tonumber(args.currentFletchingLvl), 1)
		currentXP = xpAtLevel({ args = { currentLevel } })
	else
		currentXP = paramTest.default_to(tonumber(args.currentFletchingXP), 0)
		currentLevel = levelAtXp({ args = { currentXP } })
	end

    -- Get the goal Fletching level or XP from the player and convert
    -- internally to a level value to proceed
	if args.goalToggle == 'Level' then
		goalLevel = paramTest.default_to(tonumber(args.goal), 1)
		goalXP = xpAtLevel({ args = { goalLevel } })
	else
		goalXP = paramTest.default_to(tonumber(args.goal), 0)
		goalLevel = levelAtXp({ args = { goalXP } })
	end

    -- Check if the player is capable of building totems for the specified log type
    -- with their current level
    if(args.woodChoice ~= "All" and currentLevel < log_type_table[map_log_type(args.woodChoice)].level) then
        return ('Your current level (' .. currentLevel .. ') is not sufficient to build a totem with the filtered log type chosen (' .. log_type_table[map_log_type(args.woodChoice)].level .. ').')
    end

	-- Get the desired goal level and check if the player has already reached it
	goalLevel = math.min(paramTest.default_to(tonumber(goalLevel), 1), 126)

	if(goalLevel <= currentLevel) then
		return ('Your current level (' .. currentLevel .. ') is at or above your target level (' .. goalLevel .. ').')
	end

    -- Get the actual difference in XP required to meet the player goal
    local deltaXP = goalXP - currentXP

    -- Filter decoration list by specific log type as specified (if needed)
    if(args.woodChoice ~= "All") then
        for i = #all_decor_table, 1, -1 do
            if(all_decor_table[i].type ~= args.woodChoice) then
                table.remove(all_decor_table, i)
            end
        end
    end

    -- Prepare overview table header for all log types
    local decor_table = mw.html.create("table"):addClass("wikitable sortable sticky-header align-center-1 align-center-3 align-center-4 align-center-5 align-center-6 align-center-7 align-right-9 align-right-10 align-right-11 align-right-12")
    local decor_table_data = {}
    table.insert(
        decor_table_data,
        {
            {tag = "th", text = "Decoration", attr = {colspan = 2}},
            {tag = "th", text = "Level"},
            {tag = "th", text = "XP"},
            {tag = "th", text = "# Needed"},
            {tag = "th", text = "Vale Offerings"},
            {tag = "th", text = "Vale Research Points"},
            {tag = "th", text = "Materials"},
            {tag = "th", text = "Input Cost"},
            {tag = "th", text = "Output Price"},
            {tag = "th", text = "Profit/Loss"},
            {tag = "th", text = "GP/XP"}
        }
    )

    -- Add entries to the output decoration table line by line
    for _, decor_type in ipairs(all_decor_table) do

        -- Decoration related information
    	local name = decor_type.name
        local type = decor_type.type
        local level = decor_type.level
        local fletchXP = decor_type.xp
        local logs = log_type_table[map_log_type(type)].name
        local log_count = decor_type.logcount
        local use_bowstring = decor_type.usesBowString
        
        -- Log/Totem related information
        local baseXP = log_type_table[map_log_type(type)].baseXP
        local perXP = log_type_table[map_log_type(type)].perXP
        local visits = log_type_table[map_log_type(type)].visits

        -- Each totem produces a fixed amount of XP based on the number of decorations
        -- used and the type of logs used. Assume all carvings are done correctly.
        local totemXP = (baseXP*4 + args.decCount*perXP)*leagueMultiplier

        -- Add in the additional Fletching XP gained from making N decorations (if requested)
        local selfFletchXP = 0
        if (args.noSelfFletch == "false") then
            selfFletchXP = args.decCount*fletchXP
        end

        -- Get the total number of totems needed and resulting amount of Vale offerings/points
        local totems_needed = math.ceil(deltaXP/(totemXP+selfFletchXP))
        local offerings_out = totems_needed*get_offerings(map_log_type(type),args.decCount,visits)*leaguePointModifier
        local points_out =  math.floor(offerings_out/100)

        -- Get the material cost for the total used logs and decorations
        local material_cost = 0
        local material_cost_logs = 0
        local material_cost_decor = 0
        if (args.noSelfWoodcut == "true" and use_bowstring == "true") then
            material_cost_logs = gePrice(logs)*totems_needed + gePrice("Bow string")*totems_needed*args.decCount
        elseif (args.noSelfWoodcut == "true") then
            material_cost_logs = gePrice(logs)*totems_needed
        end
        if (args.noSelfFletch == "true") then
            material_cost_decor = gePrice(name)*totems_needed*args.decCount
        end
        material_cost = material_cost_logs + material_cost_decor

        -- Get the output price assuming that the Vale Research Points gained are spent on Ent branches (20 pts ea)
        local output_price = gePrice("Ent branch")*math.floor(points_out/20)

        local materials_column = {}
        if (args.noSelfFletch == "true") then
            materials_column = {text = string.format("%s × [[File:%s.png|link=%s]] [[%s|%s]] <br> %s × [[File:%s.png|link=%s]] [[%s|%s]]",
                    commas(totems_needed), logs, logs, logs, logs,
                    commas(totems_needed*args.decCount), name, name, name, name)}
        elseif (args.noSelfFletch == "false" and use_bowstring == "true") then
            materials_column = {text = string.format("%s × [[File:%s.png|link=%s]] [[%s|%s]] <br> %s × [[File:%s.png|link=%s]] [[%s|%s]]",
                    commas(totems_needed + totems_needed*args.decCount*log_count), logs, logs, logs, logs,
                    commas(totems_needed*args.decCount), "Bow string", "Bow string", "Bow string", "Bow string")}
        else
            materials_column = {text = string.format("%s × [[File:%s.png|link=%s]] [[%s|%s]]",
                    commas(totems_needed + totems_needed*args.decCount*log_count), logs, logs, logs, logs)}
        end

        table.insert(
            decor_table_data,
            {
                {text = string.format("[[File:%s.png|link=%s]]", name, name)},
                {text = string.format("[[%s]]", name)},
                {text = string.format("%d", level)},
                {text = string.format("%.1f", (totemXP+selfFletchXP))},
                {text = string.format("%d", totems_needed)},
                {text = string.format("%d", offerings_out)},
                {text = string.format("%d", points_out)},
                materials_column,
                {text = coins(material_cost)},
                {text = coins(output_price)},
                {text = coins(output_price - material_cost)},
                {text = coins((output_price - material_cost)/(totemXP*totems_needed))}
            }
        )
    end
    tables._table(decor_table, decor_table_data)

    return tostring(decor_table)
end

return p