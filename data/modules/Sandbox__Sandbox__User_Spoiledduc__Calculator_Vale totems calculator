-- Map the log types available to index values for array access
function map_log_type(woodChoice)
    local logIndex = {
        Oak = 1, 
        Willow = 2, 
        Maple = 3, 
        Yew = 4, 
        Magic = 5, 
        Redwood = 6
    }
    return logIndex[woodChoice]
end

-- Get the quantity of offerings (per totem) given the number of decorations placed
-- This assumes the maximum number of visits possible per log type used
function get_offerings(woodChoice,decCount,visits)
    local decIndex = decCount + 1
    local offeringsAmounts = {
        {2, 4, 6, 8, 10},
        {2, 4, 6, 8, 10}, 
        {2, 4, 6, 8, 10},
        {3, 5, 8, 10, 13},
        {3, 6, 9, 12, 15},
        {3, 6, 9, 12, 15}
    }
    return offeringsAmounts[woodChoice][decIndex]*visits
end

