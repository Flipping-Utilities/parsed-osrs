--Convert experience to level:
--Iterates backwards through Experience table to find correct level for given XP
function Experience2Level(exp)
	for i=100,1,-1 do
		if (Experience[i][2] <= exp) then
			return Experience[i][1]
		end
	end
end

--http://lua-users.org/wiki/SimpleRound
--Rounds numbers to given decimal places
function round(num, numDecimalPlaces)
  local mult = 10^(numDecimalPlaces or 0)
  return math.floor(num * mult + 0.5) / mult
end

--Function to determine XP per sand unit
local function SandXpPerUnit(level, usingLunar)
	if level < 61 or usingLunar == 0 then
		return 20.0 -- pre-61 or non-lunar: 20 XP per sand
	else
		return 10.0 -- post-61 SGM: 10 XP per sand
	end
end

