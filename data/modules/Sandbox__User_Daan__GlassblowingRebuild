	cluster[11][9]	= cluster[2][9]  + cluster[3][9]  + cluster[4][9]  + cluster[5][9]  + cluster[6][9]  + cluster[7][9]  + cluster[8][9]  + cluster[9][9]  + cluster[10][9]
	
