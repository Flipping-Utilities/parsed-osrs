		bucketofsand = 0
	end
	
	local crafting_exp	= tonumber(args.crafting)
	if (crafting_exp == nil) then
		crafting_exp = 0
	end
	
	--Current player levels
	local farming_exp	= 0--tonumber(args.farming) --not used
	local crafting_lvl	= Experience2Level(crafting_exp) 
	local farming_lvl	= Experience2Level(farming_exp) --not used
	
	--Overrule craft table with selected method
	for key,value in pairs(oldmethod) do --user picked method.
		if key == SGM then
			for i=1,3 do
				oldmethod[i] = value[i]	
			end
		end
	end
	
	--Item level thresholds (what item becomes available at target exp)
	for i=1,10,1 do
		if (target_exp > xprate[i][3]) then
			cluster[i][1] = xprate[i][1]
		else
			cluster[i][1] = target_lvl
			for p=(i+1),10,1 do
				cluster[p][1] = 0
			end
			break
		end
	end
	
	--Experience threshold (XP required for next item)
	for i=1,10,1 do
		if (Experience[(cluster[i][1]+1)][2] - crafting_exp > 0) then --was >=
			cluster[i][2] = Experience[(cluster[i][1]+1)][2] - crafting_exp
		else
			cluster[i][2] = 0
		end
	end
	
	--Experience left to gain between items
	for i=2,10,1 do
		if (cluster[i][2] > 0 ) then
			cluster[i][3] = cluster[i][2] - cluster[i-1][2]
		end
	end
	
	--Items to craft per stage
	for i=2,10,1 do
		cluster[i][4] = cluster[i][3] / xprate[i-1][2]
	end
	
	--After level 61, calculate backwards from goal using molten glass
	if (moltenglass - cluster[10][4] > 0) then
		cluster[10][5] = cluster[10][4]
	else
