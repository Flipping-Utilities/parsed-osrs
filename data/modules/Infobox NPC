		{ name = 'image_bucket', func = { name = image_bucket, params = { 'image' }, flag = 'p' } },
		{ name = 'release', func = 'release' },
		{ name = 'removal', func = 'removal' },
		{ name = 'aka', func = 'has_content' },
		{ name = 'level', func = 'has_content' },
		{ name = 'size', func = sizearg },
		{ name = 'members', func = 'has_content' },
		{ name = 'race', func = 'has_content' },
		{ name = 'quest', func = 'has_content' },
		{ name = 'location', func = 'has_content' },
		{ name = 'leagueRegion', func = tb.regionsForInfobox },
		{ name = 'leagueRegion_raw', func = { name = 'has_content', params = { 'leagueRegion' }, flag = 'p' } },
		{ name = 'shop', func = 'has_content' },
		{ name = 'gender', func = 'has_content' },
		{ name = 'options', func = 'has_content' },
		{ name = 'respawn', func = respawnarg },
		{ name = 'examine', func = 'has_content' },
		{ name = 'map', func = maparg },

		{ name = 'shopversion', func = 'has_content' },
		{ name = 'dropversion', func = 'has_content' },
        { name = 'usesinfobox', func = { name = tostring, params = { 'NPC' }, flag = 'r' } },
		{ name = 'id', func = 'has_content' },
		{ name = 'id_bucket', func = { name = idbucket, params = { 'id' }, flag = 'p' } },
		{ name = 'chisel_link', func = { name = 'chisel_link', params = { 'id', 'name', 'npc' }, flag = { 'p', 'p', 'r' } } },
		{ name = 'default_version', func = { name = is_default_version, params = { 'bucketname'..default_version_index, 'version'..default_version_index, 'bucketname', 'version' } } },
	}

	ret:defineLinks({ hide = true })

	ret:useBucket("infobox_npc", {
		release = 'release',
		image_bucket = 'image',
		id_bucket = 'npc_id',
		name_bucket = 'npc_name',
		examine = 'examine',
