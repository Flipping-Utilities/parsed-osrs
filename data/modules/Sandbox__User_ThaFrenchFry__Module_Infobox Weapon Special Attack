-- function

function image(arg, weapon)
	if infobox.isDefined(arg) then
		return string.format('[[File:%s.png]]', arg)
	end

	if infobox.isDefined(weapon) then
		local first = mw.text.split(weapon, ',')[1]
		first = mw.text.trim(first or '')
		if first ~= '' then
			return string.format('[[File:%s.png]]', first)
		end
	end

	return nil
end

function attack_rollarg(arg)
	if not infobox.isDefined(arg) then
		return nil
	end

	if arg:lower() == 'true' or arg:lower() == 'true strike' then
		return 'True strike'
		else
		return arg
	end
end

function defence_rollarg(arg)
	if not infobox.isDefined(arg) then
		return nil
	end

	if arg:lower() == 'none' or arg:lower() == 'no' then
		return 'None'
	else
		return arg
	end
end

function targetbucket(arg)
	if infobox.isDefined(arg) then
		return arg
	end

	return nil
end

-- split items with multiple images for Bucket (e.g. [[File:Arrow 1.png]] [[File:Arrow 2.png]])
function image_bucket(arg)
	local _img = {}
	for i in string.gmatch(arg, '[Ff]ile:.-%.png') do
		table.insert(_img, i)
	end
	if #_img == 0 then
		return nil
	end
	return table.concat(_img, '&&SPLITPOINT&&')
end

-- split items with multiple weapons for Bucket (e.g. [[File:Arrow 1.png]] [[File:Arrow 2.png]])
function weapon_bucket(arg)
	local _wep = {}
	for i in string.gmatch(arg, '%[%[(.-)%]%]') do
		table.insert(_wep, i)
	end
	if #_wep == 0 then
		return nil
	end
	return table.concat(_wep, '&&SPLITPOINT&&')
end

function animarg(anim, animresize, name)
	if infobox.isDefined(anim) then
		anim = mw.text.trim(anim):gsub('^[Ff]ile:', '')
		return string.format(
			'[[File:%s|%spx]]',
			anim,
			infobox.isDefined(animresize) and animresize or '300'
		)
	end

	if infobox.isDefined(name) then
		name = mw.text.trim(name)
		return string.format(
			'[[File:%s.gif|%spx]]',
			name,
			infobox.isDefined(animresize) and animresize or '300'
		)
	end

	return nil
end

function maxtargetsarg(arg)
	if infobox.isDefined(arg) and tonumber(arg) then
		return arg
	end
end

function targetarg(arg)
	local target = string.lower(arg or '')
	if target == 'single' then
		return 'Single-target'
	elseif target == 'burst' then
		return 'Target-based burst'
	elseif target == 'self' then
		return 'Self'
	elseif target == 'chain' then
		return 'Chain'
	elseif target == 'cleave' then
		return 'Cleave'
	elseif target == 'varies' then
		return 'Varies'
	else
		return nil
	end
end

function energyarg(arg)
	if infobox.isDefined(arg) and tonumber((arg:gsub('%%', ''))) then
		return arg:match('%%') and arg or (arg .. '%')
	end
end

function speedarg(arg)
	if infobox.isDefined(arg) and arg:lower() == 'varies' then
		return 'Varies'
	end
	if infobox.isDefined(arg) and tonumber(arg) then
		return arg .. ' ticks (' .. (arg * 0.6) .. 's)' 
	end
end

function pvparg(arg)
	if not infobox.isDefined(arg) then
		return nil
	end
		if arg:lower() == 'false' or arg:lower() == 'no' then
			return 'Disabled or no effect'
		elseif arg:lower() == 'true' or arg:lower() == 'yes' then
			return 'Only affects players'
		end
end

function durationarg(arg)
	if infobox.isDefined(arg) and arg:lower() == 'varies' then
		return 'Varies'
	end
	if infobox.isDefined(arg) and tonumber(arg) then
		return arg .. ' ticks (' .. (arg * 0.6) .. 's)' 
	end
end

-- Parsers to set relevant params in the json
-- bucket JSON
local function to_json_value(value, default)
	if infobox.isDefined(value) then
		return value
	else
		return default
	end
end

-- bucket JSON
function bucketarg(name, image, release, seasonal, style, target, range, maxtargets, energy, weapon, attack_roll, defence_roll, damage_roll, damage_type, dot, speed, hp, pray, duration, pvp, requirements, tooltip, anim)
	local toJSON = {
		name = to_json_value(name),
		image = to_json_value(image),
		release = to_json_value(release),
		seasonal = to_json_value(seasonal),
		style = to_json_value(style),
		target = to_json_value(target),
		range = to_json_value(range),
		maxtargets = to_json_value(maxtargets),
		energy = to_json_value(energy),
		weapon = to_json_value(weapon),
		attack_roll = to_json_value(attack_roll),
		defence_roll = to_json_value(defence_roll),
		damage_roll = to_json_value(damage_roll),
		damage_type = to_json_value(damage_type),
		dot = to_json_value(dot),
		speed = to_json_value(speed),
		hp = to_json_value(hp),
		pray = to_json_value(pray),
		duration = to_json_value(duration),
		pvp = to_json_value(pvp),
		requirements = to_json_value(requirements),
		tooltip = to_json_value(tooltip),
		anim = to_json_value(anim),
	}

	return mw.text.killMarkers(mw.text.jsonEncode(toJSON))
end

function addcategories(ibox, args, catargs)
	local ret = { 'Weapon special attacks' }

	local cat_map = {
		-- Added if the parameter has content
		defined = {},
		-- Added if the parameter has no content
		notdefined = {
			anim = 'Weapon special attacks missing animation',
			damage_roll = 'Weapon special attacks missing damage_roll',
		},
		notdefined_notexclusive = {
			release = 'Needs release date',
		},
		-- Parameters that have text
		-- map a category to a value
		grep = {},
	}
	table.insert(ret, (args.style.d:gsub('^%l', string.upper)) .. ' special attacks')

	-- Run and add mapped categories
	for n, v in pairs(cat_map.defined) do
		if catargs[n] and catargs[n].one_defined then
			table.insert(ret, v)
		end
	end
	for n, v in pairs(cat_map.notdefined) do
		if catargs[n] and catargs[n].all_defined == false then
			table.insert(ret, v)
		end
	end

	-- searches
	for n, v in pairs(cat_map.grep) do
		for m, w in pairs(v) do
			if args[n] then
				local val = args[n].d
				if infobox.isDefined(val) and string.find(string.lower(tostring(val) or ''), m) then
					table.insert(ret, w)
				end
				if args[n].switches then
					for _, x in ipairs(args[n].switches) do
						if infobox.isDefined(x) and string.find(string.lower(tostring(x)), m) then
							table.insert(ret, w)
						end
					end
				end
			end
		end
	end

	-- combine table and format category wikicode
	for i, v in ipairs(ret) do
		if v ~= '' then
			ret[i] = string.format('[[Category:%s]]', v)
		end
	end

	return table.concat(ret, '')
end

