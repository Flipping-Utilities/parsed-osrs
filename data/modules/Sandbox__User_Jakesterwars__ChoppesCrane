function createHeader(weaponType)
	local ret = mw.html.create('table'):addClass('wikitable')
	-- First header is full table span linking weaponType (span = internal table count + 1 for Combat Options)
	ret:tag('tr'):tag('th'):attr( 'colspan', #WeaponTypes[weaponType] + 1):wikitext('[[' .. weaponType .. ']]'):done()
	--  Second header is Combat Options then remaining cells of the first element of each WeaponTypes internal table
	ret:tag('tr'):done()
	ret:tag('th'):wikitext('[[Combat Options]]'):done()
	for _, tableOfColumnComponents in ipairs(WeaponTypes[weaponType]) do
		ret:tag('th'):wikitext(tableOfColumnComponents[1]):done()
	end
	return ret
end

-- If weaponType is `Bow`, `Crossbow`, or `Chinchompas` and param ```range``` is passed with
--		at least 9 then build special rows - max possible range in any scenario is 10
function buildRowRange(rowNum, weaponType, range)
	local ret = mw.html.create('tr')
	for i = 1, #WeaponTypes[weaponType] - 1, 1 do
		ret:tag('td'):wikitext(WeaponTypes[weaponType][i][rowNum]):done()
	end
	if(range == 9) then
		ret:tag('td'):wikitext('[[Attack range]] by <span title="As the maximum range of any player attack is 10 squares, longrange only increases attack range by one square on this weapon." style="cursor:help; border-bottom:1px dotted;">1 square</span>'):done()
	elseif(range == 10) then
		ret:tag('td'):wikitext('<span title="As the maximum range of any player attack is 10 squares, longrange cannot increase attack range on this weapon." style="cursor:help; border-bottom:1px dotted;">None</span>'):done()
	else
		ret:tag('td'):wikitext(WeaponTypes[weaponType][#WeaponTypes[weaponType]][rowNum]):done()
	end
	return ret
end

-- Build row tables nth element of weaponType internal tables
function buildRow(rowNum, weaponType)
	local ret = mw.html.create('tr')
	if(rowNum == 1) then
		ret:tag('td'):wikitext('[[File:CombatStyles_' .. weaponType:gsub("%s+", "_") .. '.png|link=Weapons/Types]]'):attr('rowspan', #WeaponTypes[weaponType][1]):done()
	end
	for i = 1, #WeaponTypes[weaponType], 1 do
		ret:tag('td'):wikitext(WeaponTypes[weaponType][i][rowNum + 1]):done()
	end
	return ret
end

function p._main(args)
	if(WeaponTypes[args[1]] ~= nil) then
		local range = paramTest.defaults{ {tonumber(args.range), 1} }
		local ret = createHeader(args[1])
		for i = 1, #WeaponTypes[args[1]][1] - 1, 1 do -- #WeaponTypes[args[1]][1] - 1 is equal to the number of non-header rows
			if(((args[1] == 'Bow') or (args[1] == 'Crossbow') or (args[1] == 'Chinchompas')) and (range > 8) and (i == #WeaponTypes[args[1]][1])) then
				ret:node(buildRowRange(i, args[1], range))
			else
				ret:node(buildRow(i, args[1]))
			end
		end
		return tostring(ret)
	else
		error('Invalid or empty parameter: '.. args[1])
	end
end

function p.main(frame)
	local args = frame:getParent().args
	return p._main(args)
end

return p