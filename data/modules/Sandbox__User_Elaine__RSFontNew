    ['y'] = true,
}

function p.main(frame)
    local text = frame.args.text or frame.args[1] or ""
    local color = frame.args.color or frame.args[2] or "black" 
    local background = frame.args.background or ""
    local backgroundStyle = ""
    local result = ""
    
    for i = 1, #text do
        local char = text:sub(i, i)
        local charid = charMap[char]
        local colorClass = color
        local hangingClass = ""
        
        if hangingChars[char] then
            hangingClass = "hanging"
        end
        
        if charid then
            result = result .. string.format('<span class="rsfont-char"><span class="rsfont-text">%s</span>[[File:Plain 12 - %d.png|link=|class=char-image %s %s]]</span>', 
                mw.text.encode(char), charid, colorClass, hangingClass)
        else
            result = result .. char
        end
    end
    
    if background ~= "" then
        backgroundStyle = string.format('style="background: %s;"', background)
    end
    
    return mw.getCurrentFrame():extensionTag{
        name = 'templatestyles', args = { src = 'Module:Sandbox/User:Elaine/RSFontNew/styles.css' }
    } .. string.format('<span class="rsfont-wrapper" %s>', backgroundStyle) .. result .. '</span>'
end

return p