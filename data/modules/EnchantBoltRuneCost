-- Module:EnchantBoltRuneCost
-- Returns rune/item cost (gp) for a rune set or chooses the cheapest from multiple variants.
-- Supports combo runes and basic staff/offhand negations (magnitude & offset).
local p = {}
local gep = require('Module:Exchange')._price   -- numeric price for an item name
local coins_module = require('Module:Coins')._amount

-- combo rune definitions
local combo_runes = {
	['mist rune'] = { ['air rune'] = true, ['water rune'] = true },
	['dust rune'] = { ['air rune'] = true, ['earth rune'] = true },
	['mud rune'] = { ['water rune'] = true, ['earth rune'] = true },
	['smoke rune'] = { ['air rune'] = true, ['fire rune'] = true },
	['steam rune'] = { ['water rune'] = true, ['fire rune'] = true },
	['lava rune'] = { ['earth rune'] = true, ['fire rune'] = true },
	['aether rune'] = { ['cosmic rune'] = true, ['soul rune'] = true }
}

-- items that aren't runes (don't append " rune")
local non_rune_items = {
	['banana'] = true,
	['unpowered orb'] = true,
	['soft clay'] = true,
}

-- staff/offhand entries (small set; extend as needed)
local staves = {
	{ name = 'staff of the dead', negations = {{ magnitude = 0.857 }} },
	{ name = 'kodai wand', negations = {{ magnitude = 0.85 }} },
	-- bryophyta's staff example: partial negation for nature runes
	{ name = "bryophyta's staff", negations = {{ magnitude = 1, offset = 1/15, conditions = { runes = { 'nature rune' } } }} },
	-- generic elemental battlestaff entries (these provide runes instead of negations)
	{ name = 'staff of air', ['air rune'] = true },
	{ name = 'staff of water', ['water rune'] = true },
	{ name = 'staff of earth', ['earth rune'] = true },
	{ name = 'staff of fire', ['fire rune'] = true }
}

local offhands = {
	{ name = 'tome of fire' },
	{ name = 'tome of water' },
	{ name = 'tome of earth' }
}

-- helpers
local function trim(s) return mw.text.trim(tostring(s or "")) end

local function norm_name(name)
	if not name then return nil end
	local n = mw.text.trim(string.lower(tostring(name)))
	if n == "" then return nil end
	-- if it's a known non-rune item leave it
	if not non_rune_items[n] then
		if not n:match("%s+rune$") then n = n .. " rune" end
	end
	return n
end

-- Parse "Air:2,Cosmic:1;staff=kodai wand;offhand=tome of water"
local function parse_variant_string(s)
	local ret = { runes = {}, staff = nil, offhand = nil }
	if not s or s == "" then return ret end
	local parts = {}
	for part in string.gmatch(s, "[^;]+") do
		table.insert(parts, mw.text.trim(part))
	end
	-- first part(s) before ';' that contain runes (they may include commas)
	local rune_part = parts[1] or ""
	for token in string.gmatch(rune_part, "[^,]+") do
		local t = mw.text.trim(token)
		local name, qty = t:match("^%s*([^:]+):?(%d*)%s*$")
		if name and name ~= "" then
			local q = tonumber(qty) or 1
			local nn = norm_name(name)
			if nn then table.insert(ret.runes, { nn, q }) end
		end
	end
	-- additional parts: staff=..., offhand=...
	for i = 2, #parts do
		local kv = parts[i]
		local key, val = kv:match("^%s*(%w+)%s*=%s*(.+)%s*$")
		if key and val then
			key = string.lower(trim(key))
			val = trim(val)
			if key == 'staff' then ret.staff = string.lower(val) end
			if key == 'offhand' or key == 'off-hand' then ret.offhand = string.lower(val) end
		end
	end
	return ret
end

local function parse_runes_from_args(args)
	local runes = {}
	for i = 1, 10 do
		local key = 'Rune' .. i
		if not args[key] then break end
		local raw = args[key]
		local num = tonumber(args[key .. 'num'] or 1) or 1
		local name = norm_name(raw)
		if name then table.insert(runes, { name, num }) end
	end
	return runes
end

-- collapse components into combo runes (same approach as earlier)
local function apply_combos(runes)
	local qty = {}
	for _, r in ipairs(runes) do qty[r[1]] = (qty[r[1]] or 0) + (r[2] or 1) end

	local to_add = {}
	for combo, comps in pairs(combo_runes) do
		local max_comp = 0
		local found = false
		for comp, _ in pairs(comps) do
			if qty[comp] and qty[comp] > 0 then
				found = true
				if qty[comp] > max_comp then max_comp = qty[comp] end
			end
		end
		if found and max_comp > 0 then
			to_add[combo] = (to_add[combo] or 0) + max_comp
			for comp, _ in pairs(comps) do
				if qty[comp] then qty[comp] = math.max(0, qty[comp] - max_comp) end
			end
		end
	end

	local res = {}
	for name, q in pairs(qty) do if q > 0 then table.insert(res, { name, q }) end end
	for name, q in pairs(to_add) do if q > 0 then table.insert(res, { name, q }) end end
	table.sort(res, function(a,b) return a[1] < b[1] end)
	return res
end

local function round(n) return math.floor(n + 0.5) end

-- find staff/offhand entry by name (case-insensitive)
local function find_entry_by_name(list, name)
	if not name then return nil end
	local nl = string.lower(name)
	for _, v in ipairs(list) do
		if string.lower(v.name) == nl then return v end
		-- check alternatives if present
		if v.alternatives then
			for _, alt in ipairs(v.alternatives) do
				if string.lower(alt) == nl then return v end
			end
		end
	end
	return nil
end

-- check simple negation condition: only supports checking 'runes' presence (list of rune names)
local function check_condition_runes(cond, runes)
	if not cond or not cond.runes then return true end
	for _, rname in ipairs(cond.runes) do
		for _, r in ipairs(runes) do
			if r[1] == rname then return true end
		end
	end
	return false
end

-- compute negation (multiplier, offset) given staff/offhand names and rune list
local function compute_negation(staff_name, offhand_name, runes)
	local mult = 1
	local offset = 0
	-- staff
	if staff_name then
		local s = find_entry_by_name(staves, staff_name)
		if s and s.negations then
			for _, neg in ipairs(s.negations) do
				-- apply if no conditions or rune-related conditions satisfied
				if not neg.conditions or check_condition_runes(neg.conditions, runes) then
					if neg.magnitude then mult = mult * (neg.magnitude or 1) end
					if neg.offset then offset = offset + (neg.offset or 0) end
				end
			end
		end
	end
	-- offhand
	if offhand_name then
		local o = find_entry_by_name(offhands, offhand_name)
		if o and o.negations then
			for _, neg in ipairs(o.negations) do
				if not neg.conditions or check_condition_runes(neg.conditions, runes) then
					if neg.magnitude then mult = mult * (neg.magnitude or 1) end
					if neg.offset then offset = offset + (neg.offset or 0) end
				end
			end
		end
	end
	return mult, offset
end

-- compute total gp for runes/items list (array of {name,qty})
local function total_price(runes)
	local total = 0
	for _, r in ipairs(runes) do
		local name = r[1]
		local q = r[2] or 1
		local price = gep(name) or 0
		total = total + price * q
	end
	return total
end

-- get numeric cost from parsed variant (table {runes, staff, offhand})
local function cost_from_parsed_variant(variant)
	-- apply combos
	local collapsed = apply_combos(variant.runes or {})
	local base = total_price(collapsed)
	-- compute negation multiplier & offset
	local mult, off = compute_negation(variant.staff, variant.offhand, collapsed)
	-- apply negation formula similar to original: final = round(mult * (base - off))
	local reduced = base - off
	if reduced < 0 then reduced = 0 end
	local final = round(mult * reduced)
	if final < 0 then final = 0 end
	return final
end

-- Public: getCost
-- Accepts either Rune1..Rune10 args, or a single 'variant' string argument (or both).
-- Also accepts format=coins to return formatted coin string.
-- Example: {{#invoke:EnchantBoltRuneCost|getCost|Rune1=Air|Rune1num=2|Rune2=Cosmic|Rune2num=1}}
-- Example: {{#invoke:EnchantBoltRuneCost|getCost|variant=air:2,cosmic:1;staff=kodai wand|format=coins}}
function p.getCost(frame)
	local args = {}
	if frame and frame.getParent then args = frame:getParent().args else args = frame or {} end
	-- if user passed 'variant' string
	if args.variant and trim(args.variant) ~= "" then
		local parsed = parse_variant_string(args.variant)
		local gp = cost_from_parsed_variant(parsed)
		if args.format == 'coins' then return coins_module(round(gp)) end
		return round(gp)
	end
	-- otherwise parse Rune1..Rune10 style
	local runes = parse_runes_from_args(args)
	local parsed = { runes = runes, staff = args.staff and string.lower(args.staff) or nil, offhand = args.offhand and string.lower(args.offhand) or nil }
	local gp = cost_from_parsed_variant(parsed)
	if args.format == 'coins' then return coins_module(round(gp)) end
	return round(gp)
end

-- Public: getBest
-- Finds the cheapest variant among Var1...VarN arguments (each a variant string like "air:2,cosmic:1;staff=kodai wand")
-- Usage: {{#invoke:EnchantBoltRuneCost|getBest|Var1=air:2,cosmic:1|Var2=air:3,cosmic:1;staff=kodai wand|format=coins}}
function p.getBest(frame)
	local args = {}
	if frame and frame.getParent then args = frame:getParent().args else args = frame or {} end
	local best = nil
	local bestVariant = nil
	for k, v in pairs(args) do
		-- capture Var1, Var2, ... (case-insensitive)
		if type(k) == 'string' and string.lower(k):match("^var%d+$") then
			local s = trim(v or "")
			if s ~= "" then
				local parsed = parse_variant_string(s)
				local gp = cost_from_parsed_variant(parsed)
				if best == nil or gp < best then best = gp bestVariant = s end
			end
		end
	end
	-- If user passed 'variant' (single) fallback
	if best == nil and args.variant then
		local parsed = parse_variant_string(args.variant)
		best = cost_from_parsed_variant(parsed)
		bestVariant = args.variant
	end
	if not best then best = 0 end
	if args.format == 'coins' then return coins_module(round(best)) end
	return round(best)
end

return p