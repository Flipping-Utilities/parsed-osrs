[{"url":"http://services.runescape.com/m=rswiki/en/Eulogy_for_a_Forgotten_Hero","archivedate":"14 February 2012","archiveurl":"https://reldo.runescape.wiki/i/14795861","title":"Eulogy for a Forgotten Hero","template":"citelore"},{"url":"https://www.runescape.com/lore/samuel-scourduel","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061045","title":"The Excellent Log of the Journeys and Tribulations of Samuel Scourduel","sectitle":"Entry One","template":"citelore"},{"title":"Roots in the Community","notes":"\"When the Dark Imperator ceased his march across Gielinor's scarred surface and withdrew to obscurity - becoming the Empty Lord - everything changed.\"","url":"https://www.runescape.com/lore/roots-in-the-community","archiveurl":"https://reldo.runescape.wiki/i/11061037","archivedate":"30 September 2018","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061074","title":"The Old Blood","template":"citelore"},{"url":"https://www.runescape.com/lore/the-burning-tower---arian","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061056","title":"The Burning Tower - Ariane's Tale","sectitle":"Ten Years Ago;One Year Ago","notes":"\"Ten Years Ago: Today I said goodbye to my family and set off for my new home. I’m going to be an apprentice at the Wizards’ Tower! [...] One Year Ago: I’ve been a full wizard for seven years now, and Archmage Sedridor tells me I’m well on my way to becoming a senior one.\"","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","archiveurl":"https://reldo.runescape.wiki/i/11061074","archivedate":"30 September 2018","title":"The Old Blood","notes":"written by Lowerniel Drakan. \"As I stared into his tear-streaked, bloodied face, I bared my fangs and rasped just one word: 'Run.' I set him down, and - after a moment's incredulous pause - he fled the temple, staggering into the night.\"","template":"citelore"},{"url":"https://www.runescape.com/lore/the-legend-of-arrav","archiveurl":"https://reldo.runescape.wiki/i/11061069","archivedate":"4 October 2018","title":"The Legend of Arrav, Part II","sectitle":"Section 1","template":"citelore"},{"url":"https://www.runescape.com/lore/the-legend-of-arrav","archiveurl":"https://reldo.runescape.wiki/i/11061069","archivedate":"4 October 2018","title":"The Legend of Arrav, Part I","sectitle":"Section 2","template":"citelore"},{"author":"John Ayliff","title":"History of the Goblins","url":"https://www.runescape.com/lore/history-of-the-goblins","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061035","template":"citelore"},{"url":"https://www.runescape.com/lore/worth-comes-in-battle","title":"Worth Comes in Battle","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061088","template":"citelore"},{"url":"https://www.runescape.com/lore/the-coat-thief","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061061","title":"The Coat Thief","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/the-fall-of-the-six","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061065","title":"The Fall of Six","name":"fo6","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","title":"The Old Blood","archiveurl":"https://reldo.runescape.wiki/i/11061074","archivedate":"30 September 2018","notes":"In my first moments, there was only flesh - roiling, ubiquitous. Then, there was will. As I wormed my way through the flesh that was not me, movement became easier, and the churning - in turn - more fierce. Something membranous broke, and my body filled with overwhelming sensation. I know this now to be shrieking, chittering, hissing chaos...but then it was the only sound I knew. The urge to move was subservient to another need, deeper and more primal. I latched onto the nearest flesh that was not my own, pain hard and sharp as fangs burst forth from raw gums for the first time, and I gorged to the sound of strangled mewls. I surged forth - filled with blood-strength - until I grasped something else. Earth - hard, cold - and glorious freedom. I pulled myself from the spawning pit and the squirming bodies of my kin. I stood on trembling legs and stretched my mucus-crusted wings. For the first time, my eyes prised open, and I beheld Vampyrium's blood moon. I raised my head and howled.","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","title":"The Old Blood","sectitle":"The human guise I taught you has served you well, has it not?","archiveurl":"https://reldo.runescape.wiki/i/11061074","archivedate":"30 September 2018","notes":"\"Lord Malachi of House Ghrazi laughed - deep and full - as I approached him and knelt. Indolent and corpulent in ill-fitting ur-maggot leather and dire bat fur, he lounged on his great throne, beneath the wall-mounted husk of a giant leechwyrm, slain by his much-storied grandfather. 'By the blood, is that you, Drakan? You have...changed your form, somehow.' 'It is our effect of choice in House Drakan, my lord, taught to us by the Stranger from Afar. It is...convenient in many ways. Ghrazi snorted. 'Leave your tribute and begone - hopefully the rest of my vassals still have some self-respect.' I inclined my head, words souring in my mouth as I knew my blood tribute would sour in his. Poison was an alien concept on Vampyrium, and Lord Ghrazi so very resistant to change. I would be sure to transform fully when later - alone - he lay before me, mouth frothing, paralysed...unable to close his eyes.\"","template":"citelore"},{"url":"https://www.runescape.com/lore/the-chasm-of-lights","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061058","title":"The Chasm of Lights","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/the-rising-sun---ozans-t","title":"The Rising Sun - Ozan's Tale","archiveurl":"https://reldo.runescape.wiki/i/11061081","archivedate":"30 September 2018","name":"lore","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","title":"The Old Blood","sectitle":"The human guise I taught you has served you well, has it not?","archiveurl":"https://reldo.runescape.wiki/i/11061074","archivedate":"30 September 2018","template":"citelore"},{"url":"https://www.runescape.com/lore/tumekens-dream","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061083","title":"Tumeken's Dream","template":"citelore"},{"url":"https://www.runescape.com/lore/twice-burnt","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061086","title":"Twice Burnt","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/tumekens-dream","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061083","title":"Tumeken's Dream","sectitle":"Day, the Fourth - Scabaras","template":"citelore"},{"url":"https://www.runescape.com/lore/the-rising-sun---ozans-t","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061081","title":"The Rising Sun - Ozan's Tale","name":"RisingSun","template":"citelore"},{"title":"The Coat Thief","url":"https://www.runescape.com/lore/the-coat-thief","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061061","sectitle":"no","author":"Mod John A","template":"citelore"},{"url":"https://www.runescape.com/lore/tumekens-dream","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061083","title":"Tumeken's Dream","name":"Dream","template":"citelore"},{"url":"https://www.runescape.com/lore/tumekens-dream","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061083","title":"Tumeken's Dream","template":"citelore"},{"url":"https://www.runescape.com/lore/tumekens-dream","title":"Tumeken's Dream","sectitle":"Day, the second - Apmeken","archiveurl":"https://reldo.runescape.wiki/i/11061083","archivedate":"4 October 2018","template":"citelore"},{"author":"John Ayliff","title":"History of the Goblins","url":"https://www.runescape.com/lore/history-of-the-goblins","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061035","template":"citelore"},{"title":"The Fall of Six","url":"https://www.runescape.com/lore/the-fall-of-the-six","name":"fo6","archiveurl":"https://reldo.runescape.wiki/i/11061065","archivedate":"30 September 2018","template":"citelore"},{"url":"https://www.runescape.com/lore/the-coat-thief","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061061","title":"The Coat Thief","sectitle":"no","template":"citelore"},{"title":"Twice Burnt","url":"https://www.runescape.com/lore/twice-burnt","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061086","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/the-legend-of-arrav","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061069","title":"The Legend of Arrav","quote":"He had a dimly remembered memory from his youth of tales of a fabulous shield that did not belong to this world, and that was strong against nearly every attack, but whose whereabouts were unknown.","template":"citelore"},{"url":"https://www.runescape.com/lore/a-call-to-arms","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061025","title":"A Call to ARMS","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/daemonheim-asunder","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061029","title":"Daemonheim Asunder","template":"citelore"},{"url":"https://www.runescape.com/lore/the-burning-tower---arian","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061056","title":"The Burning Tower - Ariane's Tale","template":"citelore"},{"url":"https://www.runescape.com/lore/the-rising-sun---ozans-t","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061081","title":"The Rising Sun - Ozan's Tale","name":"RisingSun","template":"citelore"},{"url":"https://www.runescape.com/lore/worth-comes-in-battle","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061088","title":"Worth Comes in Battle","template":"citelore"},{"url":"https://www.runescape.com/lore/worth-comes-in-battle","title":"Worth Comes in Battle","name":"Worth","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061088","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061074","title":"The Old Blood","sectitle":"no","template":"citelore"},{"url":"https://www.runescape.com/lore/roots-in-the-community","title":"Roots in the Community","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061037","author":"Mod William","date":"11 May 2015","template":"citelore"},{"url":"https://www.runescape.com/lore/the-old-blood","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061074","title":"The Old Blood","template":"citelore"},{"url":"https://www.runescape.com/lore/the-coat-thief","archivedate":"30 September 2018","archiveurl":"https://reldo.runescape.wiki/i/11061061","title":"The Coat Thief","sectitle":"no","template":"citelore"}]